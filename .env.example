# ==============================================================================
# Frames By Hithu - Biometric Event Gallery Environment Variables
# ==============================================================================
# Copy this file to .env for local development.
# In production (Cloudflare Pages Dashboard), set these under:
#   Settings > Environment Variables (Production)
#
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Cloudflare KV Namespace ID (Optional: only needed if overriding Dashboard binding or for local emulated dev)
# In production, Cloudflare Pages binds this automatically in:
# Settings > Functions > KV namespace bindings (Variable name: FH_STUDIO_KV)
KV_NAMESPACE_ID=your_32_character_hex_kv_namespace_id

# Administrator Password for Live Studio Admin Portal (/admin)
ADMIN_PASSWORD=your_secure_admin_password_here

# Cryptographic Session Secret (32+ character random hex or passphrase for HMAC-SHA256 signatures)
SESSION_SECRET=your_super_secret_session_key_min_32_chars_long

# Canonical Site URL
SITE_URL=https://framesbyhithu.pages.dev
