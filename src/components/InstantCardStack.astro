  }

  .arc-btn.main-heart-btn:hover {
    background: rgba(255, 51, 102, 0.3);
    border-color: #FF3366;
  }

  .heart-pulse {
    animation: heartBeat 2s infinite;
  }

  @keyframes heartBeat {
    0%, 100% { transform: scale(1); }
    15% { transform: scale(1.15); }
    30% { transform: scale(1); }
    45% { transform: scale(1.12); }
  }

  /* Burst Particles Layer */
  .burst-particles-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 100;
  }

  :global(.particle-burst) {
    position: absolute;
    bottom: 20px;
    left: 50%;
    font-size: 2rem;
    pointer-events: none;
