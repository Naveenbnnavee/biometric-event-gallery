  }

  .arc-btn:hover {
    transform: scale(1.22);
    background: rgba(212, 175, 55, 0.2);
    border-color: var(--gold-primary);
  }

  .arc-btn.main-heart-btn {
    width: 52px;
    height: 52px;
    background: rgba(255, 51, 102, 0.15);
    border-color: rgba(255, 51, 102, 0.4);
