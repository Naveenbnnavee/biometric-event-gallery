  }

  /* Caption Card */
  .instant-caption-card {
    width: 100%;
    background: rgba(20, 22, 29, 0.6);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    text-align: center;
    backdrop-filter: blur(12px);
  }

  .active-photo-title {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: 0.3rem;
  }

  .active-photo-caption {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Reactions Arc Cluster */
  .reactions-cluster-stage {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .reaction-buttons-arc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: rgba(20, 22, 29, 0.8);
    padding: 8px 18px;
    border-radius: 9999px;
    border: 1px solid var(--gold-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  }

  .arc-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
