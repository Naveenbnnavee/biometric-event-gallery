  }

  .instant-wa-pill {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--whatsapp-emerald);
    color: #FFFFFF;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.95rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.35);
    transition: var(--transition-smooth);
    box-sizing: border-box;
  }

  .instant-wa-pill:hover {
    background: var(--whatsapp-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(37, 211, 102, 0.55);
  }

  .instant-form-pill {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--gold-border);
    color: var(--gold-light);
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.9rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    transition: var(--transition-smooth);
    box-sizing: border-box;
  }

  .instant-form-pill:hover {
    background: linear-gradient(135deg, #F7E4A8 0%, #D4AF37 50%, #9B781E 100%);
    color: #07080B;
    border-color: #F7E4A8;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.45);
  }

  .instant-form-pill svg {
    color: currentColor;
    flex-shrink: 0;
  }

  .pill-arrow {
    transition: transform 0.2s ease;
  }

  .instant-wa-pill:hover .pill-arrow,
  .instant-form-pill:hover .pill-arrow {
    transform: translateX(4px);
  }
</style>

<script define:vars={{ instantDecks }}>
  function initInstantDeck() {
    const root = document.getElementById('instant-experience');
    if (!root) return;

    let activeDeckId = instantDecks[0].id;
    // Map of deckId -> array of card element indices in current physical order
    const deckStates = {};

    instantDecks.forEach((deck) => {
      deckStates[deck.id] = {
        cardOrder: Array.from({ length: deck.cards.length }, (_, i) => i),
        isFlipping: false
      };
    });

    const counterElem = document.getElementById('active-card-counter');
    const titleElem = document.getElementById('active-card-title');
    const captionElem = document.getElementById('active-card-caption');
    const venueElem = document.getElementById('active-card-venue');
    const waLink = document.getElementById('instant-whatsapp-link');
    const waTextElem = document.getElementById('wa-pill-text');

    function updateDeckPositions(deckId) {
      const deckElem = document.getElementById(`deck-${deckId}`);
      if (!deckElem) return;

      const state = deckStates[deckId];
      const cards = deckElem.querySelectorAll('.instant-card');

      state.cardOrder.forEach((cardOriginalIdx, positionIdx) => {
        const card = cards[cardOriginalIdx];
        if (!card) return;

        // Remove all previous position classes
        card.classList.remove('pos-0', 'pos-1', 'pos-2', 'pos-3', 'pos-hidden', 'flipping-to-back');

        if (positionIdx === 0) {
          card.classList.add('pos-0');
        } else if (positionIdx === 1) {
          card.classList.add('pos-1');
        } else if (positionIdx === 2) {
          card.classList.add('pos-2');
        } else if (positionIdx === 3) {
          card.classList.add('pos-3');
        } else {
          card.classList.add('pos-hidden');
        }
      });

      // Update metadata based on top card (position 0)
      const activeOriginalIdx = state.cardOrder[0];
      const activeDeck = instantDecks.find(d => d.id === deckId);
      if (!activeDeck) return;
      const activeCard = activeDeck.cards[activeOriginalIdx];

      if (counterElem) counterElem.textContent = `Frame ${activeOriginalIdx + 1} of ${activeDeck.cards.length}`;
      if (titleElem) titleElem.textContent = activeCard.title;
      if (captionElem) captionElem.textContent = activeCard.caption;
      if (venueElem) venueElem.textContent = `📍 ${activeCard.venue}, ${activeCard.location}`;

      // Update WhatsApp pre-filled action with royal studio formatting
      if (waLink) {
        const waNum = waLink.getAttribute('data-whatsapp') || '917892706982';
        const deckLabel = activeDeck.label || 'Karnataka Ceremony';
        const deckKannada = activeDeck.kannadaLabel ? ` (${activeDeck.kannadaLabel})` : '';
        const text =
          `✨ *Frames By Hithu — Instant Deck Inquiry*\n\n` +
          `🖼️ *Featured Frame:* "${activeCard.title}"\n` +
          `🏛️ *Venue & Location:* ${activeCard.venue}, ${activeCard.location}\n` +
          `🏷️ *Ceremony Collection:* ${deckLabel}${deckKannada}\n\n` +
          `Hello Frames By Hithu! I love this photograph from your Instant Deck. Could you please confirm date availability and share a tailored fine-art proposal for our ceremony?`;
        waLink.href = `https://wa.me/${waNum}?text=${encodeURIComponent(text)}`;
      }
      if (waTextElem) {
        waTextElem.textContent = `Inquire about "${activeCard.title}" on WhatsApp`;
      }

      // Update Form button target and prefill attributes
      const formLink = document.getElementById('instant-form-link');
      if (formLink) {
        const hasLocalInquire = !!document.getElementById('inquire');
        if (hasLocalInquire) {
          formLink.href = '#inquire';
        } else {
          formLink.href = `/contact#inquiry-form?title=${encodeURIComponent(activeCard.title)}&venue=${encodeURIComponent(activeCard.venue)}&location=${encodeURIComponent(activeCard.location)}`;
        }
        formLink.setAttribute('data-card-title', activeCard.title);
        formLink.setAttribute('data-card-venue', activeCard.venue);
        formLink.setAttribute('data-card-location', activeCard.location);
      }
    }

    // Initialize all decks
    instantDecks.forEach(deck => updateDeckPositions(deck.id));

    // The "Send Old Photo To Back" Animation
    function flipTopCardToBack(deckId) {
      const state = deckStates[deckId];
      if (state.isFlipping) return;
      state.isFlipping = true;

      const deckElem = document.getElementById(`deck-${deckId}`);
      if (!deckElem) return;

      const cards = deckElem.querySelectorAll('.instant-card');
      const topOriginalIdx = state.cardOrder[0];
      const topCard = cards[topOriginalIdx];

      if (!topCard) {
        state.isFlipping = false;
        return;
      }

      // Add flip animation class
      topCard.classList.add('flipping-to-back');

      // Shift order: remove front, push to end of array
      setTimeout(() => {
        const movedCard = state.cardOrder.shift();
        state.cardOrder.push(movedCard);

        updateDeckPositions(deckId);
        topCard.classList.remove('flipping-to-back');
        state.isFlipping = false;
      }, 350);
    }

    // Bind click / tap on top card
    instantDecks.forEach(deck => {
      const deckElem = document.getElementById(`deck-${deck.id}`);
      if (!deckElem) return;

      deckElem.addEventListener('click', (e) => {
        const target = e.target;
        const card = target && target.closest ? target.closest('.instant-card') : null;
        if (card && card.classList.contains('pos-0')) {
          flipTopCardToBack(deck.id);
        }
      });
    });

    // Category Tabs Switcher
    const catButtons = root.querySelectorAll('.category-pill-btn');
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const newDeckId = btn.getAttribute('data-category-id');
        if (!newDeckId) return;

        activeDeckId = newDeckId;

        // Switch active deck view
        const allDecks = root.querySelectorAll('.deck-group');
        allDecks.forEach(d => d.classList.remove('active'));

        const targetDeck = document.getElementById(`deck-${newDeckId}`);
        if (targetDeck) {
          targetDeck.classList.add('active');
          updateDeckPositions(newDeckId);
        }
      });
    });

    // Touch Swipe handling on mobile
    let touchStartX = 0;
    let touchStartY = 0;

    const viewport = document.getElementById('card-stack-viewport');
    viewport?.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    viewport?.addEventListener('touchend', (e) => {
      const diffX = e.changedTouches[0].clientX - touchStartX;
      const diffY = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(diffX) > 40 || Math.abs(diffY) > 40) {
        flipTopCardToBack(activeDeckId);
      }
    }, { passive: true });

    // Keyboard arrow / space support
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === ' ') {
        flipTopCardToBack(activeDeckId);
      }
    });

    // Form Link click handler: smooth-scroll and auto-prefill form on current page if available
    const formLinkBtn = document.getElementById('instant-form-link');
    if (formLinkBtn) {
      formLinkBtn.addEventListener('click', (e) => {
        const inquireSection = document.getElementById('inquire');
        if (inquireSection) {
          e.preventDefault();
          const cardTitle = formLinkBtn.getAttribute('data-card-title') || '';
          const cardVenue = formLinkBtn.getAttribute('data-card-venue') || '';
          const cardLocation = formLinkBtn.getAttribute('data-card-location') || '';

          // Prefill the form inputs
          const venueInput = document.getElementById('client-venue');
          const notesInput = document.getElementById('client-notes');
          const citySelect = document.getElementById('client-city');

          if (venueInput && cardVenue) {
            venueInput.value = cardVenue;
          }
          if (notesInput && cardTitle) {
            notesInput.value = `Inquiring about Instant Deck frame: "${cardTitle}" at ${cardVenue} (${cardLocation})`;
          }

          if (citySelect && cardLocation) {
            const locLower = cardLocation.toLowerCase();
            for (let i = 0; i < citySelect.options.length; i++) {
              const optVal = citySelect.options[i].value.toLowerCase();
              if (optVal && (locLower.includes(optVal) || (optVal.includes('bengaluru') && locLower.includes('bangalore')) || (optVal.includes('mysuru') && locLower.includes('mysore')) || (optVal.includes('mangaluru') && locLower.includes('mangalore')))) {
                citySelect.selectedIndex = i;
                break;
              }
            }
          }

          // Smooth scroll to form
          inquireSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

          // Subtle gold pulse effect on form
          const formCard = document.getElementById('inquiry-card');
          if (formCard) {
            formCard.classList.remove('pulse-focus');
            void formCard.offsetWidth; // trigger DOM reflow
            formCard.classList.add('pulse-focus');
          }
        }
      });
    }
  }

  initInstantDeck();
  document.addEventListener('astro:page-load', initInstantDeck);
</script>
