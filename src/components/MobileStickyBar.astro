---
import { getStudioSettingsAsync } from '../lib/db';

const settings = await getStudioSettingsAsync();
const primaryPhone = settings.primaryPhone || '+91-7892706982';
const phoneClean = primaryPhone.replace(/[^0-9+]/g, '');
const whatsappClean = (settings.whatsappConcierge || '917892706982').replace(/[^0-9]/g, '');
const whatsappUrl = `https://wa.me/${whatsappClean}?text=` + encodeURIComponent("Hello Frames By Hithu! I would like to check availability and request a custom quote for our upcoming celebration in Karnataka.");
---

<div class="mobile-sticky-bar" id="mobile-sticky-bar" role="region" aria-label="Quick Actions">
  <div class="bar-grid">
    <a href={`tel:${phoneClean}`} class="bar-action call-action" aria-label="Call Frames By Hithu Studio">
      <span class="action-icon">📞</span>
      <span class="action-label">Call Studio</span>
    </a>

    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="bar-action whatsapp-action" aria-label="Inquire via WhatsApp">
      <svg class="whatsapp-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
      </svg>
      <span class="action-label">WhatsApp</span>
    </a>

    <a href="/contact#inquiry-form" class="bar-action quote-action" aria-label="Check Date Availability">
      <span class="action-icon">✨</span>
      <span class="action-label">Check Date</span>
    </a>
  </div>
</div>

<style>
  .mobile-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(11, 12, 16, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid var(--gold-border);
    z-index: 999;
    padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom, 0px)) 0.75rem;
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.7);
  }

  @media (min-width: 768px) {
    .mobile-sticky-bar {
      display: none;
    }
  }

  .bar-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    gap: 0.5rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .bar-action {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.65rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: var(--transition-smooth);
    min-height: 44px;
  }

  .action-icon {
    font-size: 0.9rem;
  }

  .call-action {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .call-action:active {
    background: rgba(255, 255, 255, 0.15);
  }

  .whatsapp-action {
    background: var(--whatsapp-emerald);
    color: #FFFFFF;
    box-shadow: 0 0 15px rgba(37, 211, 102, 0.35);
  }

  .whatsapp-action:active {
    background: var(--whatsapp-hover);
  }

  .whatsapp-svg {
    flex-shrink: 0;
  }

  .quote-action {
    background: var(--gold-gradient);
    color: #0B0C10;
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.25);
  }

  .quote-action:active {
    filter: brightness(1.15);
  }

  .action-label {
    white-space: nowrap;
  }
</style>
