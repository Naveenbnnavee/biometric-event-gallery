---
import type { Story } from '../data/stories';

interface Props {
  story: Story;
}

const { story } = Astro.props;
---

<article class="story-card glass-card">
  <a href={`/stories/${story.slug}`} class="story-card-link">
    <div class="story-media protected-media">
      <img src={story.coverImage} alt={`${story.title} by Frames By Hithu`} loading="lazy" class="story-img" />
      <div class="protected-overlay"></div>
      <div class="watermark-subtle">FRAMES BY HITHU</div>
      <div class="story-media-badge">
        <span class="gold-pill">{story.ceremonyType}</span>
      </div>
    </div>

    <div class="story-content">
      <div class="story-location-date">
        <span>📍 {story.location} • {story.venue}</span>
        <span>{story.date}</span>
      </div>

      <h3 class="story-title">{story.title}</h3>
      <h4 class="story-couple">{story.coupleOrFamily}</h4>

      <p class="story-summary">{story.summary}</p>

      <blockquote class="story-quote">
        “{story.quote.text}”
      </blockquote>

      <div class="story-cta">
        <span class="cta-text">Read Full Editorial Essay</span>
        <span class="cta-arrow">→</span>
      </div>
    </div>
  </a>
</article>

<style>
  .story-card {
    transition: var(--transition-smooth);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .story-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .story-card:hover {
    transform: translateY(-6px);
    border-color: var(--gold-border);
    box-shadow: var(--shadow-elevated);
  }

  .story-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #000;
  }

  .story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-luxury);
  }

  .story-card:hover .story-img {
    transform: scale(1.05);
  }

  .story-media-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 5;
  }

  .story-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .story-location-date {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.775rem;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .story-title {
    font-size: 1.6rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }

  .story-couple {
    font-size: 0.95rem;
    color: var(--gold-light);
    font-family: var(--font-sans);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .story-summary {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: #E2E2E6;
    border-left: 2px solid var(--gold-primary);
    padding-left: 0.85rem;
    margin-bottom: 1.5rem;
    margin-top: auto;
    line-height: 1.5;
  }

  .story-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold-primary);
    font-size: 0.825rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .cta-arrow {
    transition: transform 0.2s ease;
  }

  .story-card:hover .cta-arrow {
    transform: translateX(4px);
  }
</style>
