---
import { getApprovedTestimonialsAsync } from '../lib/db';
import { reviews as fallbackReviews } from '../data/reviews';

const dynamicTestimonials = await getApprovedTestimonialsAsync();
const reviews = (dynamicTestimonials && dynamicTestimonials.length > 0)
  ? dynamicTestimonials
  : fallbackReviews;
---

<section class="testimonials-section section-py">
  <div class="container">
    <div class="section-header">
      <div class="gold-pill">CLIENT TESTIMONIALS & TRUST</div>
      <h2>Treasured by Karnataka’s Discerning Families</h2>
      <div class="gold-divider"></div>
      <p>
        Hear from couples and families across Bengaluru, Mysuru, Mangaluru, and Udupi who trusted Frames By Hithu with their once-in-a-lifetime milestones.
      </p>
    </div>

    <div class="reviews-grid">
      {reviews.map((rev) => (
        <article class="review-card glass-card">
          <div class="review-stars">
            {Array.from({ length: rev.rating || 5 }).map(() => (
              <span class="star-gold">★</span>
            ))}
          </div>

          {rev.highlight && <h3 class="review-highlight">“{rev.highlight}”</h3>}

          <p class="review-body">
            {rev.comment}
          </p>

          <div class="review-footer">
            <div class="client-meta">
              <strong class="client-name">{rev.clientName}</strong>
              <span class="event-details">{rev.eventType}</span>
              {(rev.venue || rev.location) && (
                <span class="venue-location">
                  📍 {[rev.venue, rev.location].filter(Boolean).join(', ')}
                </span>
              )}
            </div>
            <div class="verified-badge" title="Verified Karnataka Client">
              <span class="check-mark">✓</span>
              <span>Verified Client</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="feedback-cta-wrap text-center">
      <a href="/feedback" class="feedback-cta-btn">
        <span>✨ Had a ceremony with us? Leave a review & share your experience</span>
        <span class="cta-arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    background: linear-gradient(180deg, var(--bg-primary) 0%, #0d0f14 100%);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .review-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .review-stars {
    display: flex;
    gap: 4px;
    margin-bottom: 1rem;
  }

  .star-gold {
    color: var(--gold-primary);
    font-size: 1.1rem;
  }

  .review-highlight {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.35;
  }

  .review-body {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .review-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .client-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .client-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--gold-light);
  }

  .event-details {
    font-size: 0.8rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .venue-location {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .verified-badge {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.7rem;
    color: var(--whatsapp-emerald);
    background: rgba(37, 211, 102, 0.1);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid rgba(37, 211, 102, 0.2);
    font-weight: 600;
    white-space: nowrap;
  }

  .check-mark {
    font-weight: bold;
  }

  .feedback-cta-wrap {
    margin-top: 3.5rem;
  }

  .feedback-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.75rem;
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 999px;
    color: var(--gold-light);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .feedback-cta-btn:hover {
    background: rgba(212, 175, 55, 0.18);
    border-color: var(--gold-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.2);
  }

  .cta-arrow {
    transition: transform 0.2s ease;
  }

  .feedback-cta-btn:hover .cta-arrow {
    transform: translateX(4px);
  }
</style>
