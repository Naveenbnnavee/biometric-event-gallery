<script>
  // Elements for client Add/Edit modal
  const clientModal = document.getElementById('client-modal');
  const addClientBtn = document.getElementById('add-client-btn');
  const closeClientModal = document.getElementById('close-client-modal');
  const cancelClientBtn = document.getElementById('cancel-client-btn');
  const clientForm = document.getElementById('client-form') as HTMLFormElement;
  const modalTitle = document.getElementById('client-modal-title');
  const randomPinBtn = document.getElementById('random-pin-btn');

  const editIdInput = document.getElementById('edit-client-id') as HTMLInputElement;
  const nameInput = document.getElementById('client-name-input') as HTMLInputElement;
  const eventInput = document.getElementById('client-event-input') as HTMLInputElement;
  const dateInput = document.getElementById('client-date-input') as HTMLInputElement;
  const pinInput = document.getElementById('client-pin-input') as HTMLInputElement;
  const emailInput = document.getElementById('client-email-input') as HTMLInputElement;
  const phoneInput = document.getElementById('client-phone-input') as HTMLInputElement;
  const twoFaInput = document.getElementById('client-2fa-input') as HTMLInputElement;
  const targetInput = document.getElementById('client-target-input') as HTMLInputElement;
  const statusSelect = document.getElementById('client-status-select') as HTMLSelectElement;
  const coverInput = document.getElementById('client-cover-input') as HTMLInputElement;
  const notesInput = document.getElementById('client-notes-input') as HTMLTextAreaElement;
  const uploadCoverBtn = document.getElementById('upload-cover-btn');
  const coverFileInput = document.getElementById('cover-file-input') as HTMLInputElement;

  // Cover photo file upload
  uploadCoverBtn?.addEventListener('click', () => coverFileInput?.click());
  coverFileInput?.addEventListener('change', async (e: any) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('file', file);
    try {
      const res = await fetch('/api/upload', { method: 'POST', body: formData });
      const data = await res.json();
      if (res.ok && data.success && data.url) {
        if (coverInput) coverInput.value = data.url;
        (window as any).showToast('Cover photo uploaded!', 'success');
      }
    } catch {
      (window as any).showToast('Cover upload failed', 'error');
    }
  });

  // Random Passcode generator (high-entropy format)
  function generateSecureKey() {
    const prefixes = ['FBH', 'GOLD', 'HERITAGE', 'SACRED', 'ROYAL'];
    const prefix = prefixes[Math.floor(Math.random() * prefixes.length)];
    const num = Math.floor(1000 + Math.random() * 9000);
    return `${prefix}-${num}`;
  }

  function openAddModal() {
    if (modalTitle) modalTitle.textContent = 'Issue Private Client Gallery & Key';
    if (clientForm) clientForm.reset();
    if (editIdInput) editIdInput.value = '';
    if (pinInput) pinInput.value = generateSecureKey();
    if (clientModal) clientModal.style.display = 'flex';
  }

  function closeModal() {
    if (clientModal) clientModal.style.display = 'none';
  }

  addClientBtn?.addEventListener('click', openAddModal);
  closeClientModal?.addEventListener('click', closeModal);
  cancelClientBtn?.addEventListener('click', closeModal);

  randomPinBtn?.addEventListener('click', () => {
    if (pinInput) pinInput.value = generateSecureKey();
  });

  // Copy portal link
  const copyButtons = document.querySelectorAll('.copy-link-btn');
  copyButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const pin = btn.getAttribute('data-pin');
      const url = `${window.location.origin}/client-portal?pin=${encodeURIComponent(pin || '')}`;
      try {
        await navigator.clipboard.writeText(url);
        (window as any).showToast(`Copied Client Portal URL with Passcode ${pin}!`, 'success');
      } catch {
        (window as any).showToast(`Passcode: ${pin}`, 'success');
      }
    });
  });

  // Edit client
  const editButtons = document.querySelectorAll('.edit-client-btn');
  editButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || '';
      const name = btn.getAttribute('data-name') || '';
      const title = btn.getAttribute('data-title') || '';
      const date = btn.getAttribute('data-date') || '';
      const pin = btn.getAttribute('data-pin') || '';
      const email = btn.getAttribute('data-email') || '';
      const phone = btn.getAttribute('data-phone') || '';
      const is2fa = btn.getAttribute('data-2fa') === 'true';
      const target = btn.getAttribute('data-target') || '40';
      const status = btn.getAttribute('data-status') || 'active';
      const cover = btn.getAttribute('data-cover') || '';
      const notes = btn.getAttribute('data-notes') || '';

      if (modalTitle) modalTitle.textContent = `Edit Client Suite: ${name}`;
      if (editIdInput) editIdInput.value = id;
      if (nameInput) nameInput.value = name;
      if (eventInput) eventInput.value = title;
      if (dateInput) dateInput.value = date;
      if (pinInput) pinInput.value = pin;
      if (emailInput) emailInput.value = email;
      if (phoneInput) phoneInput.value = phone;
      if (twoFaInput) twoFaInput.checked = is2fa;
      if (targetInput) targetInput.value = target;
      if (statusSelect) statusSelect.value = status;
      if (coverInput) coverInput.value = cover;
      if (notesInput) notesInput.value = notes;

      if (clientModal) clientModal.style.display = 'flex';
    });
  });

  // Submit client Add/Edit
  clientForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-client-btn') as HTMLButtonElement;
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
    }

    const editId = editIdInput.value;
    const isEdit = Boolean(editId);

    const payload = {
      clientName: nameInput.value,
      eventTitle: eventInput.value,
      ceremonyDate: dateInput.value,
      pin: pinInput.value,
      clientEmail: emailInput.value,
      clientPhone: phoneInput.value,
      requireTwoFactor: twoFaInput.checked,
      targetAlbumCount: parseInt(targetInput.value, 10),
      status: statusSelect.value,
      coverImage: coverInput.value,
      notes: notesInput.value
    };

    try {
      const url = isEdit ? `/api/clients/${editId}` : '/api/clients';
      const method = isEdit ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (res.ok && data.success) {
        (window as any).showToast(isEdit ? 'Client suite updated!' : 'Client gallery issued successfully!', 'success');
        closeModal();
        setTimeout(() => window.location.reload(), 300);
      } else {
        (window as any).showToast(data.error || 'Failed to save client', 'error');
      }
    } catch {
      (window as any).showToast('Network error saving client', 'error');
    } finally {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Client Suite';
      }
    }
  });

  // Delete client
  const deleteButtons = document.querySelectorAll('.delete-client-btn');
  deleteButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      if (!confirm(`Are you sure you want to delete the proofing gallery for "${name}"?`)) {
        return;
      }

      try {
        const res = await fetch(`/api/clients/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).showToast('Client gallery removed', 'success');
          const card = (btn as HTMLElement).closest('.client-card');
          card?.remove();
        } else {
          (window as any).showToast(data.error || 'Failed to delete client', 'error');
        }
      } catch {
        (window as any).showToast('Network error deleting client', 'error');
      }
    });
  });

  // ==========================================
  // STANDALONE GALLERY PHOTOS MANAGER
  // ==========================================
  const pmModal = document.getElementById('photos-manager-modal');
  const closePmModal = document.getElementById('close-pm-modal');
  const cancelPmBtn = document.getElementById('cancel-pm-btn');
  const savePmBtn = document.getElementById('save-pm-btn');
  const pmTitle = document.getElementById('pm-modal-title');
  const pmSubtitle = document.getElementById('pm-modal-subtitle');
  const pmDropzone = document.getElementById('pm-dropzone');
  const pmDropContent = document.getElementById('pm-dropzone-content');
  const pmFileInput = document.getElementById('pm-file-input') as HTMLInputElement;
  const pmSpinner = document.getElementById('pm-upload-spinner');
  const pmSpinnerText = document.getElementById('pm-spinner-text');
  const pmBulkUrls = document.getElementById('pm-bulk-urls') as HTMLTextAreaElement;
  const pmAddUrlsBtn = document.getElementById('pm-add-urls-btn');
  const pmCountBadge = document.getElementById('pm-count-badge');
  const pmClearBtn = document.getElementById('pm-clear-btn');
  const pmPhotosGrid = document.getElementById('pm-photos-grid');

  let activeClientId: string | null = null;
  let activeClientCover = '';
  let activePhotos: string[] = [];

  function renderPmGrid() {
    if (!pmPhotosGrid) return;
    pmPhotosGrid.innerHTML = '';
    if (pmCountBadge) pmCountBadge.textContent = activePhotos.length.toString();

    activePhotos.forEach((url, idx) => {
      const item = document.createElement('div');
      item.className = 'pm-thumb-item';
      item.innerHTML = `
        <img src="${url}" alt="Frame #${idx + 1}" class="pm-thumb-img" loading="lazy" />
        <div class="pm-thumb-overlay">
          <span class="pm-frame-idx">#${String(idx + 1).padStart(3, '0')}</span>
          <div style="display: flex; gap: 3px;">
            <button type="button" class="pm-cover-btn" title="Set as Cover">Cover</button>
            <button type="button" class="pm-del-btn" title="Delete Frame">✕</button>
          </div>
        </div>
      `;

      item.querySelector('.pm-del-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        activePhotos.splice(idx, 1);
        renderPmGrid();
      });

      item.querySelector('.pm-cover-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        activeClientCover = url;
        (window as any).showToast(`Frame #${idx + 1} set as gallery cover!`, 'success');
      });

      pmPhotosGrid.appendChild(item);
    });
  }

  // Open PM Modal from any client card
  const managePhotoBtns = document.querySelectorAll('.manage-photos-btn');
  managePhotoBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeClientId = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name') || 'Client';
      activeClientCover = btn.getAttribute('data-cover') || '';
      try {
        activePhotos = JSON.parse(btn.getAttribute('data-photos') || '[]');
      } catch {
        activePhotos = [];
      }

      if (pmTitle) pmTitle.textContent = `Proofing Gallery Photos — ${name}`;
      if (pmSubtitle) pmSubtitle.textContent = `Upload and manage proof frames for ${name}`;
      renderPmGrid();
      if (pmModal) pmModal.style.display = 'flex';
    });
  });

  function closePm() {
    if (pmModal) pmModal.style.display = 'none';
    activeClientId = null;
    activePhotos = [];
  }

  closePmModal?.addEventListener('click', closePm);
  cancelPmBtn?.addEventListener('click', closePm);

  // Bulk URL Addition
  pmAddUrlsBtn?.addEventListener('click', () => {
    const text = pmBulkUrls?.value || '';
    const urls = text.split('\n').map(u => u.trim()).filter(u => u.startsWith('http') || u.startsWith('/uploads'));
    if (urls.length === 0) {
      (window as any).showToast('No valid URLs found', 'error');
      return;
    }
    activePhotos.push(...urls);
    if (pmBulkUrls) pmBulkUrls.value = '';
    renderPmGrid();
    (window as any).showToast(`Added ${urls.length} photo URLs!`, 'success');
  });

  // Clear All
  pmClearBtn?.addEventListener('click', () => {
    if (confirm('Clear all photos in this gallery?')) {
      activePhotos = [];
      renderPmGrid();
    }
  });

  // Multi-File Upload to Gallery
  async function uploadGalleryFiles(files: FileList | File[]) {
    if (!files || files.length === 0) return;
    if (pmDropContent) pmDropContent.style.display = 'none';
    if (pmSpinner) pmSpinner.style.display = 'flex';
    if (pmSpinnerText) pmSpinnerText.textContent = `Uploading ${files.length} high-res photographs...`;

    const formData = new FormData();
    for (let i = 0; i < files.length; i++) {
      formData.append('files', files[i]);
    }

    try {
      const res = await fetch('/api/upload', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (res.ok && data.success && Array.isArray(data.urls)) {
        activePhotos.push(...data.urls);
        renderPmGrid();
        (window as any).showToast(`Uploaded ${data.urls.length} photographs!`, 'success');
      } else {
        (window as any).showToast(data.error || 'Failed to upload photos', 'error');
      }
    } catch {
      (window as any).showToast('Upload network error', 'error');
    } finally {
      if (pmSpinner) pmSpinner.style.display = 'none';
      if (pmDropContent) pmDropContent.style.display = 'flex';
    }
  }

  pmFileInput?.addEventListener('change', (e: any) => {
    if (e.target.files) uploadGalleryFiles(e.target.files);
  });

  pmDropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    pmDropzone.classList.add('dragover');
  });
  pmDropzone?.addEventListener('dragleave', () => {
    pmDropzone.classList.remove('dragover');
  });
  pmDropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    pmDropzone.classList.remove('dragover');
    if (e.dataTransfer?.files) uploadGalleryFiles(e.dataTransfer.files);
  });

  // Save gallery photos to DB
  savePmBtn?.addEventListener('click', async () => {
    if (!activeClientId) return;
    if (savePmBtn) {
      savePmBtn.setAttribute('disabled', 'true');
      savePmBtn.textContent = 'Saving...';
    }

    try {
      const payload: any = {
        photos: activePhotos,
        photosCount: activePhotos.length
      };
      if (activeClientCover) {
        payload.coverImage = activeClientCover;
      }

      const res = await fetch(`/api/clients/${activeClientId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok && data.success) {
        (window as any).showToast('Gallery proofing frames updated!', 'success');
        closePm();
        setTimeout(() => window.location.reload(), 300);
      } else {
        (window as any).showToast(data.error || 'Failed to save photos', 'error');
      }
    } catch {
      (window as any).showToast('Network error saving gallery', 'error');
    } finally {
      if (savePmBtn) {
        savePmBtn.removeAttribute('disabled');
        savePmBtn.textContent = 'Save Gallery Photos';
      }
    }
  });

  // Quick Client Portal Visibility Toggle
  const quickToggleBtn = document.getElementById('quick-portal-toggle-btn') as HTMLButtonElement | null;
  const quickLabel = document.getElementById('quick-portal-label');

  quickToggleBtn?.addEventListener('click', async () => {
    const isCurrentlyVisible = quickToggleBtn.getAttribute('data-visible') === 'true';
    const nextState = !isCurrentlyVisible;

    quickToggleBtn.disabled = true;
    try {
      const res = await fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clientPortalVisible: nextState })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        quickToggleBtn.setAttribute('data-visible', String(nextState));
        quickToggleBtn.className = `portal-quick-btn ${nextState ? 'active' : 'hidden'}`;
        if (quickLabel) {
          quickLabel.textContent = nextState ? 'Public: Visible' : 'Public: Hidden';
        }
        (window as any).showToast(
          nextState ? 'Client Portal is now PUBLICLY VISIBLE in site navigation.' : 'Client Portal is now HIDDEN from public navigation.',
          'success'
        );
      } else {
        (window as any).showToast(data.error || 'Failed to update visibility', 'error');
      }
    } catch {
      (window as any).showToast('Network error updating portal visibility', 'error');
    } finally {
      quickToggleBtn.disabled = false;
    }
  });

  // =========================================================================
  // Album Selections Inspector Logic
  // =========================================================================
  const inspectModal = document.getElementById('inspect-selections-modal');
  const closeInspectModalBtn = document.getElementById('close-inspect-modal');
  const closeInspectBtn = document.getElementById('close-inspect-btn');
  const inspectTitle = document.getElementById('inspect-modal-title');
  const inspectSubtitle = document.getElementById('inspect-modal-subtitle');
  const inspectCurr = document.getElementById('inspect-selected-curr');
  const inspectTarget = document.getElementById('inspect-selected-target');
  const inspectProgressFill = document.getElementById('inspect-progress-fill');
  const inspectSubmittedTime = document.getElementById('inspect-submitted-time');
  const inspectNotesContent = document.getElementById('inspect-notes-content');
  const inspectPhotosCountTag = document.getElementById('inspect-photos-count-tag');
  const inspectGrid = document.getElementById('inspect-photos-grid');
  const copyFilenamesBtn = document.getElementById('copy-selection-filenames-btn');
  const downloadTxtBtn = document.getElementById('download-selection-txt-btn');
  const inspectWaDiscussBtn = document.getElementById('inspect-wa-discuss-btn') as HTMLAnchorElement | null;

  let activeInspectingClient: any = null;
  let activeInspectingPhotos: string[] = [];

  function getPhotoFilename(url: string, index: number): string {
    try {
      const clean = url.split('?')[0].split('#')[0];
      const filename = clean.substring(clean.lastIndexOf('/') + 1);
      if (filename && filename.includes('.')) {
        return decodeURIComponent(filename);
      }
    } catch {}
    return `Frame_${String(index + 1).padStart(3, '0')}.jpg`;
  }

  function renderInspectGrid() {
    if (!inspectGrid) return;
    inspectGrid.innerHTML = '';

    if (activeInspectingPhotos.length === 0) {
      inspectGrid.innerHTML = `
        <div class="inspect-empty-state">
          <span class="inspect-empty-icon">📭</span>
          <h4>No Photos Selected Yet</h4>
          <p>The client has not yet favorited photos in their private proofing suite (/client-portal).</p>
        </div>
      `;
      return;
    }

    activeInspectingPhotos.forEach((url, idx) => {
      const filename = getPhotoFilename(url, idx);
      const card = document.createElement('div');
      card.className = 'inspect-photo-card';
      card.innerHTML = `
        <div class="inspect-photo-media">
          <img src="${url}" alt="${filename}" loading="lazy" class="inspect-photo-img" />
          <span class="inspect-photo-num">#${String(idx + 1).padStart(2, '0')}</span>
          <span class="inspect-fav-heart">♥</span>
        </div>
        <div class="inspect-photo-info">
          <span class="inspect-filename" title="${filename}">${filename}</span>
          <div class="inspect-photo-actions">
            <a href="${url}" target="_blank" rel="noopener noreferrer" class="inspect-view-link">View Full ↗</a>
            <button type="button" class="inspect-copy-single" data-name="${filename}" title="Copy single filename">📋</button>
          </div>
        </div>
      `;
      inspectGrid.appendChild(card);
    });

    // Single copy button listeners
    inspectGrid.querySelectorAll('.inspect-copy-single').forEach(btn => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-name') || '';
        navigator.clipboard.writeText(name);
        (window as any).showToast(`Copied "${name}"`, 'success');
      });
    });
  }

  document.querySelectorAll('.inspect-selections-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || '';
      const name = btn.getAttribute('data-name') || 'Client';
      const title = btn.getAttribute('data-title') || 'Ceremony';
      const date = btn.getAttribute('data-date') || '';
      const phone = btn.getAttribute('data-phone') || '';
      const target = parseInt(btn.getAttribute('data-target') || '40', 10);
      const notes = btn.getAttribute('data-notes') || '';
      const submitted = btn.getAttribute('data-submitted') || '';

      let selectedList: string[] = [];
      try {
        const raw = btn.getAttribute('data-selected-photos') || '[]';
        selectedList = JSON.parse(raw);
      } catch {
        selectedList = [];
      }

      activeInspectingClient = { id, name, title, date, phone, target, notes, submitted };
      activeInspectingPhotos = selectedList;

      if (inspectTitle) inspectTitle.textContent = `${name} — Heirloom Selections`;
      if (inspectSubtitle) inspectSubtitle.textContent = `${title} • Ceremony Date: ${date}`;
      if (inspectCurr) inspectCurr.textContent = selectedList.length.toString();
      if (inspectTarget) inspectTarget.textContent = target.toString();
      if (inspectPhotosCountTag) inspectPhotosCountTag.textContent = `${selectedList.length} Photographs Selected`;

      if (inspectProgressFill) {
        const pct = Math.min(100, Math.round((selectedList.length / (target || 1)) * 100));
        inspectProgressFill.style.width = `${pct}%`;
      }

      if (inspectSubmittedTime) {
        if (submitted) {
          const d = new Date(submitted);
          inspectSubmittedTime.textContent = `Submitted ${d.toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })} at ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
          inspectSubmittedTime.className = 'inspect-stat-val text-emerald';
        } else {
          inspectSubmittedTime.textContent = 'In Progress (Client Portal Draft)';
          inspectSubmittedTime.className = 'inspect-stat-val text-gold';
        }
      }

      if (inspectNotesContent) {
        inspectNotesContent.textContent = notes ? `“${notes}”` : '“No specific retouching notes submitted by client.”';
      }

      if (inspectWaDiscussBtn) {
        const cleanPhone = phone.replace(/[^0-9]/g, '');
        const waNumber = cleanPhone.startsWith('91') ? cleanPhone : (cleanPhone.length === 10 ? `91${cleanPhone}` : cleanPhone);
        const waMsg = `Hello ${name}! We have received and reviewed your ${selectedList.length} photo selections for your ${title} heirloom album spread! Our design team is currently preparing the layout drafts.`;
        inspectWaDiscussBtn.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMsg)}`;
      }

      renderInspectGrid();
      if (inspectModal) inspectModal.style.display = 'flex';
    });
  });

  function closeInspect() {
    if (inspectModal) inspectModal.style.display = 'none';
  }

  closeInspectModalBtn?.addEventListener('click', closeInspect);
  closeInspectBtn?.addEventListener('click', closeInspect);
  inspectModal?.addEventListener('click', (e) => {
    if (e.target === inspectModal) closeInspect();
  });

  // Copy Filenames / Export Selection List handler
  copyFilenamesBtn?.addEventListener('click', () => {
    if (activeInspectingPhotos.length === 0) {
      (window as any).showToast('No photos to export.', 'info');
      return;
    }

    const formatRadio = document.querySelector('input[name="export-format"]:checked') as HTMLInputElement | null;
    const isNewline = formatRadio?.value === 'newline';

    const filenames = activeInspectingPhotos.map((url, idx) => getPhotoFilename(url, idx));
    const resultText = isNewline ? filenames.join('\n') : filenames.join(', ');

    navigator.clipboard.writeText(resultText).then(() => {
      (window as any).showToast(
        `Copied ${filenames.length} filenames to clipboard! (${isNewline ? 'Newline list' : 'Comma-separated for Lightroom'})`,
        'success'
      );
    }).catch(() => {
      (window as any).showToast('Failed to copy to clipboard', 'error');
    });
  });

  // Download TXT selection list handler
  downloadTxtBtn?.addEventListener('click', () => {
    if (activeInspectingPhotos.length === 0) {
      (window as any).showToast('No photos to export.', 'info');
      return;
    }

    const filenames = activeInspectingPhotos.map((url, idx) => getPhotoFilename(url, idx));
    const content = `FRAMES BY HITHU - CLIENT ALBUM SELECTION LIST\n` +
      `Client: ${activeInspectingClient?.name || 'Client'}\n` +
      `Event: ${activeInspectingClient?.title || 'Ceremony'}\n` +
      `Date: ${activeInspectingClient?.date || ''}\n` +
      `Target Count: ${activeInspectingClient?.target || 40}\n` +
      `Total Selected: ${activeInspectingPhotos.length}\n` +
      (activeInspectingClient?.notes ? `Client Notes: ${activeInspectingClient.notes}\n` : '') +
      `\n========================================\n` +
      `FILENAMES FOR LIGHTROOM / CAPTURE ONE:\n` +
      `========================================\n\n` +
      filenames.join('\n') +
      `\n\nCOMMA-SEPARATED FILTER STRING:\n` +
      filenames.join(', ');

    const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    const safeClientName = (activeInspectingClient?.name || 'Client').replace(/[^a-zA-Z0-9]/g, '_');
    a.download = `${safeClientName}_Album_Selections.txt`;
    a.click();
    URL.revokeObjectURL(url);
    (window as any).showToast('Downloaded selections TXT list!', 'success');
  });
</script>
