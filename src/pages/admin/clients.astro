---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthenticated } from '../../lib/auth';
import { getClientGalleriesAsync, getStudioSettingsAsync } from '../../lib/db';

export const prerender = false;

const authed = await isAuthenticated(Astro.request);
if (!authed) {
  return Astro.redirect('/admin/login');
}

const clients = await getClientGalleriesAsync();
const settings = await getStudioSettingsAsync();
const portalVisible = settings.clientPortalVisible !== false;
---

<AdminLayout title="Client Proofing Suites" activeNav="clients">
  <div class="clients-page">
    <div class="page-header-row">
      <div>
        <h2 class="section-title">Private Client Proofing Portals & Security Passcodes</h2>
        <p class="section-desc">
          Issue private high-security access keys to clients. Upload proofing photographs from your computer, organize heirloom album selections, and dispatch credentials via WhatsApp.
        </p>
      </div>

      <div class="header-actions-group">
        <div class="portal-quick-toggle-wrap">
          <span class="quick-toggle-hint">Portal Visibility:</span>
          <button
            type="button"
            id="quick-portal-toggle-btn"
            class={`portal-quick-btn ${portalVisible ? 'active' : 'hidden'}`}
            data-visible={portalVisible ? 'true' : 'false'}
            title="Click to toggle whether Client Portal is visible in public website menus"
          >
            <span class="status-indicator-dot"></span>
            <span id="quick-portal-label">{portalVisible ? 'Public: Visible' : 'Public: Hidden'}</span>
          </button>
        </div>

        <button id="add-client-btn" class="btn-gold">
          <span>➕ Issue New Client Gallery & Key</span>
        </button>
      </div>
    </div>

    <!-- Client Cards Grid -->
    <div class="clients-grid">
      {clients.map(client => (
        <div class="client-card glass-card" data-id={client.id}>
          <div class="client-media-header">
            <img src={client.coverImage} alt={client.clientName} class="client-cover" />
            <div class="client-status-badge-wrap">
              <span class:list={['status-pill', client.status]}>
                {client.status === 'active' ? '● Active Proofing' : '○ Archived'}
              </span>
            </div>
            <div class="pin-highlight-box">
              <span class="pin-label">ACCESS KEY</span>
              <strong class="pin-code">{client.pin}</strong>
            </div>
          </div>

          <div class="client-card-body">
            <div class="client-header-info">
              <h3 class="client-name">{client.clientName}</h3>
              <span class="client-event">{client.eventTitle}</span>
              <span class="client-date">🗓️ Ceremony Date: {client.ceremonyDate}</span>
              {client.clientEmail && <span class="client-contact-tag">✉️ {client.clientEmail}</span>}
              {client.clientPhone && <span class="client-contact-tag">📱 {client.clientPhone}</span>}
              {client.requireTwoFactor && <span class="badge-2fa">🛡️ 2-Factor Auth Required</span>}
            </div>

            <div class="stats-strip">
              <div class="strip-item">
                <span class="strip-val">{(client.photos && client.photos.length > 0) ? client.photos.length : client.photosCount}</span>
                <span class="strip-label">Proof Frames</span>
              </div>
              <div class="strip-divider"></div>
              <div class="strip-item">
                <span class="strip-val text-gold">{client.targetAlbumCount}</span>
                <span class="strip-label">Target Album</span>
              </div>
            </div>

            <!-- Direct Photos Manager Action -->
            <button
              type="button"
              class="manage-photos-btn"
              data-id={client.id}
              data-name={client.clientName}
              data-cover={client.coverImage}
              data-photos={JSON.stringify(client.photos || [])}
            >
              <span>🖼️ Upload & Manage Gallery Photos ({(client.photos && client.photos.length > 0) ? client.photos.length : client.photosCount} Frames)</span>
            </button>

            <!-- Client Proofing Album Inspection Action -->
            <button
              type="button"
              class="inspect-selections-btn"
              data-id={client.id}
              data-name={client.clientName}
              data-title={client.eventTitle}
              data-date={client.ceremonyDate}
              data-phone={client.clientPhone || ''}
              data-target={client.targetAlbumCount}
              data-total={(client.photos && client.photos.length > 0) ? client.photos.length : client.photosCount}
              data-selected-photos={JSON.stringify(client.selectedPhotos || [])}
              data-notes={client.clientSelectionNotes || ''}
              data-submitted={client.selectionSubmittedAt || ''}
            >
              <div class="inspect-btn-title-row">
                <span class="inspect-btn-icon">🔍</span>
                <span class="inspect-btn-title">Inspect Album Selections</span>
              </div>
              <div class="inspect-btn-meta-row">
                <span class="inspect-btn-count">{(client.selectedPhotos || []).length} / {client.targetAlbumCount} Frames Chosen</span>
                {(client.selectedPhotos && client.selectedPhotos.length > 0) ? (
                  <span class="selection-pill active">● Ready to Review</span>
                ) : (
                  <span class="selection-pill pending">○ Awaiting Picks</span>
                )}
              </div>
            </button>

            {client.notes && (
              <p class="client-notes">“{client.notes}”</p>
            )}

            <!-- Client Action Buttons -->
            <div class="client-actions-row">
              <button
                class="copy-link-btn"
                data-pin={client.pin}
                title="Copy client portal link with Passcode"
              >
                📋 Copy Link
              </button>

              <a
                href={`https://wa.me/?text=${encodeURIComponent(`Hello ${client.clientName}! Your private fine-art gallery from Frames By Hithu is ready for review: https://framesbyhithu.com/client-portal\n\nYour Private Access Passcode is: ${client.pin}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="whatsapp-send-btn"
                title="Dispatch credentials via WhatsApp"
              >
                💬 WhatsApp Key
              </a>

              <a
                href={`/client-portal`}
                target="_blank"
                class="portal-open-btn"
                title="Test Client Proofing Portal"
              >
                Open Portal ↗
              </a>
            </div>

            <div class="client-manage-footer">
              <button
                class="edit-client-btn"
                data-id={client.id}
                data-name={client.clientName}
                data-title={client.eventTitle}
                data-date={client.ceremonyDate}
                data-pin={client.pin}
                data-email={client.clientEmail || ''}
                data-phone={client.clientPhone || ''}
                data-2fa={client.requireTwoFactor ? 'true' : 'false'}
                data-target={client.targetAlbumCount}
                data-photos={client.photosCount}
                data-status={client.status}
                data-cover={client.coverImage}
                data-photos-list={JSON.stringify(client.photos || [])}
                data-notes={client.notes || ''}
              >
                ✏️ Edit Settings
              </button>

              <button class="delete-client-btn" data-id={client.id} data-name={client.clientName}>
                🗑️ Delete
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Client Add / Edit Modal -->
  <div id="client-modal" class="modal-backdrop" style="display: none;">
    <div class="modal-card glass-card">
      <div class="modal-header">
        <h3 class="modal-title" id="client-modal-title">Issue Private Client Gallery & Key</h3>
        <button id="close-client-modal" class="close-btn" aria-label="Close modal">✕</button>
      </div>

      <form id="client-form" class="modal-form">
        <input type="hidden" id="edit-client-id" name="id" />

        <div class="form-grid">
          <div class="form-group col-2">
            <label class="form-label" for="client-name-input">Client / Couple Name</label>
            <input
              type="text"
              id="client-name-input"
              name="clientName"
              class="form-input"
              placeholder="e.g. Ananya & Rohit or Sharma Family"
              required
            />
          </div>

          <div class="form-group col-2">
            <label class="form-label" for="client-event-input">Ceremony Event Title</label>
            <input
              type="text"
              id="client-event-input"
              name="eventTitle"
              class="form-input"
              placeholder="e.g. Royal Bangalore Palace Wedding"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="client-date-input">Ceremony Date</label>
            <input
              type="date"
              id="client-date-input"
              name="ceremonyDate"
              class="form-input"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="client-pin-input">Secure Access Passcode / Key</label>
            <div class="pin-gen-wrap">
              <input
                type="text"
                id="client-pin-input"
                name="pin"
                class="form-input"
                placeholder="FBH-9460 or ANANYA-2026"
                maxlength="32"
                required
              />
              <button type="button" id="random-pin-btn" class="gen-pin-btn" title="Generate High-Security Key">
                🎲 Auto Key
              </button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="client-email-input">Client Email (Optional Verification)</label>
            <input
              type="email"
              id="client-email-input"
              name="clientEmail"
              class="form-input"
              placeholder="ananya.rohit@gmail.com"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="client-phone-input">Client Phone / WhatsApp</label>
            <input
              type="tel"
              id="client-phone-input"
              name="clientPhone"
              class="form-input"
              placeholder="+91 98450 XXXXX"
            />
          </div>

          <div class="form-group col-2 checkbox-group-box">
            <label class="checkbox-label">
              <input type="checkbox" id="client-2fa-input" name="requireTwoFactor" />
              <span>Require Client Email/Phone check in addition to Passcode (2-Factor Protection)</span>
            </label>
          </div>

          <div class="form-group">
            <label class="form-label" for="client-target-input">Target Album Selections</label>
            <input
              type="number"
              id="client-target-input"
              name="targetAlbumCount"
              class="form-input"
              value="40"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="client-status-select">Gallery Status</label>
            <select id="client-status-select" name="status" class="form-select">
              <option value="active">Active (Client can review)</option>
              <option value="archived">Archived (Closed)</option>
            </select>
          </div>

          <div class="form-group col-2">
            <div class="cover-label-row">
              <label class="form-label" for="client-cover-input">Cover Photo</label>
              <button type="button" id="upload-cover-btn" class="btn-source-toggle">📁 Pick from Device</button>
              <input type="file" id="cover-file-input" accept="image/*" style="display: none;" />
            </div>
            <input
              type="url"
              id="client-cover-input"
              name="coverImage"
              class="form-input"
              placeholder="https://images.unsplash.com/... or uploaded URL"
              value="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1080&q=85"
            />
          </div>

          <div class="form-group col-2">
            <label class="form-label" for="client-notes-input">Internal Studio Notes</label>
            <textarea
              id="client-notes-input"
              name="notes"
              class="form-textarea"
              rows="2"
              placeholder="e.g. Italian Leatherette Album, client requested focus on candids."
            ></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" id="cancel-client-btn" class="btn-cancel">Cancel</button>
          <button type="submit" id="save-client-btn" class="btn-gold">Save Client Suite</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Standalone Gallery Photos Manager Modal -->
  <div id="photos-manager-modal" class="modal-backdrop" style="display: none;">
    <div class="modal-card glass-card pm-card">
      <div class="modal-header">
        <div>
          <h3 class="modal-title" id="pm-modal-title">Manage Proofing Gallery Photos</h3>
          <p class="modal-subtitle" id="pm-modal-subtitle">Upload and arrange photographs for client review</p>
        </div>
        <button id="close-pm-modal" class="close-btn" aria-label="Close modal">✕</button>
      </div>

      <div class="pm-body">
        <!-- Direct File Upload Dropzone -->
        <div class="upload-dropzone" id="pm-dropzone">
          <input type="file" id="pm-file-input" multiple accept="image/*" class="file-hidden-input" />
          <div class="dropzone-content" id="pm-dropzone-content">
            <span class="dropzone-icon">📸</span>
            <span class="dropzone-text">Click or drag & drop proofing photos from computer</span>
            <span class="dropzone-sub">Select multiple photos at once (JPG, PNG, WEBP)</span>
          </div>
          <div id="pm-upload-spinner" class="upload-spinner" style="display: none;">
            <span class="spinner-icon">⏳</span>
            <span id="pm-spinner-text">Uploading photos to gallery...</span>
          </div>
        </div>

        <!-- Bulk URL Paste Tool -->
        <div class="pm-url-box">
          <textarea id="pm-bulk-urls" class="form-textarea" rows="2" placeholder="Paste multiple image URLs (one per line) from CDN, Drive, or R2..."></textarea>
          <button type="button" id="pm-add-urls-btn" class="btn-outline-sm">+ Add Pasted URLs</button>
        </div>

        <!-- Photos Toolbar -->
        <div class="pm-toolbar">
          <span class="pm-count">Total Proofing Frames: <strong id="pm-count-badge">0</strong></span>
          <button type="button" id="pm-clear-btn" class="btn-clear-sm">Clear All Frames</button>
        </div>

        <!-- Thumbnails Grid -->
        <div id="pm-photos-grid" class="pm-grid">
          <!-- Dynamically populated -->
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" id="cancel-pm-btn" class="btn-cancel">Close</button>
        <button type="button" id="save-pm-btn" class="btn-gold">Save Gallery Photos</button>
      </div>
    </div>
  </div>

  <!-- Client Proofing Album Inspection Modal -->
  <div id="inspect-selections-modal" class="modal-backdrop" style="display: none;">
    <div class="modal-card glass-card inspect-modal-card">
      <div class="modal-header">
        <div>
          <div class="inspect-kicker">ALBUM PROOFING INSPECTION</div>
          <h3 class="modal-title" id="inspect-modal-title">Client Heirloom Album Selections</h3>
          <p class="modal-subtitle" id="inspect-modal-subtitle">Review favorites chosen by client in portal</p>
        </div>
        <button id="close-inspect-modal" class="close-btn" aria-label="Close modal">✕</button>
      </div>

      <div class="inspect-body">
        <!-- Progress & Count Bar -->
        <div class="inspect-banner glass-card">
          <div class="inspect-stat-col">
            <span class="inspect-stat-label">SELECTED / TARGET</span>
            <div class="inspect-stat-numbers">
              <span class="inspect-stat-curr" id="inspect-selected-curr">0</span>
              <span class="inspect-stat-sep">/</span>
              <span class="inspect-stat-target" id="inspect-selected-target">40</span>
              <span class="inspect-stat-unit">Frames Chosen</span>
            </div>
            <div class="inspect-progress-track">
              <div class="inspect-progress-bar" id="inspect-progress-fill" style="width: 0%;"></div>
            </div>
          </div>

          <div class="inspect-timestamp-col" id="inspect-submission-time-wrap">
            <span class="inspect-stat-label">CLIENT FINALIZED STATUS</span>
            <span class="inspect-stat-val text-gold" id="inspect-submitted-time">Pending Submission</span>
          </div>
        </div>

        <!-- Client Notes Section -->
        <div class="inspect-notes-box" id="inspect-notes-container">
          <div class="inspect-notes-header">
            <span class="inspect-notes-icon">📝</span>
            <span class="inspect-notes-label">Client Retouching & Spreads Instructions:</span>
          </div>
          <p class="inspect-notes-text" id="inspect-notes-content">“No notes left by client.”</p>
        </div>

        <!-- Selections Actions Toolbar -->
        <div class="inspect-toolbar">
          <div class="inspect-toolbar-left">
            <span class="inspect-count-tag" id="inspect-photos-count-tag">0 Photographs Selected</span>
          </div>
          <div class="inspect-toolbar-actions">
            <button type="button" id="copy-selection-filenames-btn" class="btn-gold-sm" title="Copy photo filenames to paste directly into Lightroom or Capture One">
              <span>📋 Copy Filenames / Export Selection List</span>
            </button>
            <button type="button" id="download-selection-txt-btn" class="btn-outline-sm" title="Download text list for editing archive">
              <span>💾 Download TXT List</span>
            </button>
          </div>
        </div>

        <!-- Copy Format Radio -->
        <div class="copy-format-row">
          <span class="format-label">Clipboard Format:</span>
          <label class="radio-label">
            <input type="radio" name="export-format" value="comma" checked />
            <span>Comma-Separated (Lightroom Search: <code>img1.jpg, img2.jpg</code>)</span>
          </label>
          <label class="radio-label">
            <input type="radio" name="export-format" value="newline" />
            <span>Newline List (Spreadsheet / TXT)</span>
          </label>
        </div>

        <!-- Selections Photos Grid -->
        <div id="inspect-photos-grid" class="inspect-grid">
          <!-- Dynamically populated -->
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" id="close-inspect-btn" class="btn-cancel">Close</button>
        <a id="inspect-wa-discuss-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-sm">
          <span>💬 Discuss Selections on WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .clients-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .page-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .header-actions-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .portal-quick-toggle-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .quick-toggle-hint {
    font-size: 0.75rem;
    color: #9CA3AF;
    font-weight: 500;
  }

  .portal-quick-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.25s ease;
  }

  .portal-quick-btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.1);
  }

  .portal-quick-btn.active {
    background: rgba(37, 211, 102, 0.15);
    color: #25D366;
    border-color: rgba(37, 211, 102, 0.35);
  }

  .portal-quick-btn.hidden {
    background: rgba(245, 158, 11, 0.15);
    color: #F59E0B;
    border-color: rgba(245, 158, 11, 0.35);
  }

  .portal-quick-btn .status-indicator-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: #FFFFFF;
    margin: 0 0 0.5rem 0;
  }

  .section-desc {
    color: #9CA3AF;
    font-size: 0.9rem;
    max-width: 780px;
    margin: 0;
  }

  /* Grid */
  .clients-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.75rem;
  }

  .client-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .client-card:hover {
    transform: translateY(-4px);
    border-color: rgba(212, 175, 55, 0.4);
  }

  .client-media-header {
    height: 180px;
    position: relative;
    overflow: hidden;
  }

  .client-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .client-status-badge-wrap {
    position: absolute;
    top: 12px;
    left: 12px;
  }

  .status-pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
  }

  .status-pill.active {
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(16, 185, 129, 0.5);
    color: #34D399;
  }

  .status-pill.archived {
    background: rgba(107, 114, 128, 0.2);
    border: 1px solid rgba(107, 114, 128, 0.4);
    color: #9CA3AF;
  }

  .pin-highlight-box {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(11, 12, 16, 0.9);
    border: 1px solid var(--gold-border);
    backdrop-filter: blur(8px);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pin-label {
    font-size: 0.6rem;
    color: var(--text-gold);
    letter-spacing: 0.08em;
  }

  .pin-code {
    font-family: monospace;
    font-size: 1.15rem;
    color: #FFFFFF;
    letter-spacing: 0.1em;
  }

  .client-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 1rem;
  }

  .client-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: #FFFFFF;
    margin: 0 0 0.35rem 0;
  }

  .client-event {
    display: block;
    color: var(--gold-light);
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }

  .client-date {
    display: block;
    color: #9CA3AF;
    font-size: 0.8rem;
    margin-bottom: 0.35rem;
  }

  .client-contact-tag {
    display: block;
    font-size: 0.78rem;
    color: #D1D5DB;
    margin-top: 0.15rem;
  }

  .badge-2fa {
    display: inline-block;
    font-size: 0.7rem;
    color: #60A5FA;
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-top: 0.35rem;
  }

  .stats-strip {
    display: flex;
    align-items: center;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }

  .strip-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .strip-val {
    font-size: 1.3rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .strip-val.text-gold {
    color: var(--text-gold);
  }

  .strip-label {
    font-size: 0.72rem;
    color: #9CA3AF;
  }

  .strip-divider {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
  }

  .manage-photos-btn {
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--gold-border);
