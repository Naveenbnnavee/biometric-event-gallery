  </style>

  <script>
    function initInquiriesAdmin() {
      const searchInput = document.getElementById('inquiry-search-input') as HTMLInputElement | null;
      const filterTabs = document.querySelectorAll('#status-filter-tabs .filter-tab');
      const rows = document.querySelectorAll('.inquiry-row');
      const statusSelects = document.querySelectorAll('.status-dropdown');

      let currentStatusFilter = 'all';

      function filterTable() {
        const query = searchInput?.value.toLowerCase().trim() || '';

        rows.forEach(row => {
          const rowStatus = row.getAttribute('data-status') || '';
          const hasClash = row.getAttribute('data-has-clash') === 'true';
          const searchText = row.getAttribute('data-search') || '';

          let matchesStatus = true;
          if (currentStatusFilter === 'clash') {
            matchesStatus = hasClash;
          } else if (currentStatusFilter !== 'all') {
            matchesStatus = rowStatus === currentStatusFilter;
          }

          const matchesQuery = !query || searchText.includes(query);

          if (matchesStatus && matchesQuery) {
            (row as HTMLElement).style.display = '';
          } else {
            (row as HTMLElement).style.display = 'none';
          }
        });
      }

      searchInput?.addEventListener('input', filterTable);

      filterTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          filterTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          currentStatusFilter = tab.getAttribute('data-status') || 'all';
          filterTable();
        });
      });

      // Status change listener
      statusSelects.forEach(select => {
        select.addEventListener('change', async (e) => {
          const target = e.target as HTMLSelectElement;
          const id = target.getAttribute('data-id');
          const newStatus = target.value;
          if (!id) return;

          try {
            const res = await fetch(`/api/inquiries/${id}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: newStatus })
            });

            if (res.ok) {
              // Update row attribute and style
              const row = target.closest('.inquiry-row');
              if (row) {
                row.setAttribute('data-status', newStatus);
              }
              target.className = `status-dropdown status-pill ${newStatus}`;
            } else {
              alert('Failed to update status.');
            }
          } catch (err) {
            console.error('Error updating status:', err);
            alert('Network error updating status.');
          }
        });
      });

      // Delete inquiry buttons
      const deleteBtns = document.querySelectorAll('.btn-delete-inquiry');
      deleteBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          const name = btn.getAttribute('data-name');
          if (!id) return;

          if (confirm(`Are you sure you want to delete inquiry from "${name}"?`)) {
            try {
              const res = await fetch(`/api/inquiries/${id}`, {
                method: 'DELETE'
              });
              if (res.ok) {
                const row = btn.closest('.inquiry-row');
                row?.remove();
              } else {
                alert('Could not delete inquiry.');
              }
            } catch (err) {
              alert('Error deleting inquiry.');
            }
          }
        });
      });

      // Add/Edit Manual Inquiry Modal
      const modal = document.getElementById('inquiry-modal');
      const addBtn = document.getElementById('add-inquiry-btn');
      const closeBtn = document.getElementById('close-inquiry-modal');
      const cancelBtn = document.getElementById('cancel-inquiry-btn');
      const form = document.getElementById('inquiry-form') as HTMLFormElement | null;

      function openModal() {
        if (modal) modal.style.display = 'flex';
        form?.reset();
      }

      function closeModal() {
        if (modal) modal.style.display = 'none';
      }

      addBtn?.addEventListener('click', openModal);
      closeBtn?.addEventListener('click', closeModal);
      cancelBtn?.addEventListener('click', closeModal);

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const payload: Record<string, any> = {};
        formData.forEach((value, key) => {
          payload[key] = value;
        });

        try {
          const res = await fetch('/api/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            window.location.reload();
          } else {
            const data = await res.json();
            alert(data.error || 'Failed to save inquiry.');
          }
        } catch (err) {
          alert('Network error saving inquiry.');
        }
      });

      // View Details & Notes Modal
      const detailsModal = document.getElementById('details-modal');
      const closeDetailsBtn = document.getElementById('close-details-modal');
      const viewNotesBtns = document.querySelectorAll('.btn-view-notes');
      const detClientName = document.getElementById('det-client-name');
      const detCeremonyType = document.getElementById('det-ceremony-type');
      const detStatusBadge = document.getElementById('det-status-badge');
      const detDate = document.getElementById('det-date');
      const detLocation = document.getElementById('det-location');
      const detPhone = document.getElementById('det-phone');
      const detEmail = document.getElementById('det-email');
      const detGuests = document.getElementById('det-guests');
      const detNotesEdit = document.getElementById('det-notes-edit') as HTMLTextAreaElement | null;
      const detWaDirectBtn = document.getElementById('det-wa-direct-btn') as HTMLAnchorElement | null;
      const detUpdateNotesBtn = document.getElementById('det-update-notes-btn');

      let currentInspectingId = '';

      viewNotesBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id') || '';
          currentInspectingId = id;
          const name = btn.getAttribute('data-name') || '';
          const phone = btn.getAttribute('data-phone') || '';
          const email = btn.getAttribute('data-email') || '';
          const ceremony = btn.getAttribute('data-ceremony') || '';
          const date = btn.getAttribute('data-date') || '';
          const venue = btn.getAttribute('data-venue') || '';
          const location = btn.getAttribute('data-location') || '';
          const guests = btn.getAttribute('data-guests') || '';
          const notes = btn.getAttribute('data-notes') || '';
          const status = btn.getAttribute('data-status') || 'new';

          if (detClientName) detClientName.textContent = name;
          if (detCeremonyType) detCeremonyType.textContent = ceremony;
          if (detStatusBadge) {
            detStatusBadge.textContent = status.toUpperCase();
            detStatusBadge.className = `status-pill ${status}`;
          }
          if (detDate) detDate.textContent = date;
          if (detLocation) detLocation.textContent = venue ? `${venue}, ${location}` : location;
          if (detPhone) detPhone.textContent = phone;
          if (detEmail) detEmail.textContent = email || 'Not provided';
          if (detGuests) detGuests.textContent = guests || 'Mid-Scale';
          if (detNotesEdit) detNotesEdit.value = notes;

          if (detWaDirectBtn) {
            const cleanPhone = phone.replace(/[^0-9]/g, '');
            const waNumber = cleanPhone.startsWith('91') ? cleanPhone : (cleanPhone.length === 10 ? `91${cleanPhone}` : cleanPhone);
            const waMsg = `Hello ${name}! Greetings from Frames By Hithu Luxury Photography. Regarding your inquiry for ${ceremony} on ${date} at ${venue ? venue + ', ' : ''}${location}: we are delighted to confirm our availability!`;
            detWaDirectBtn.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMsg)}`;
          }

          if (detailsModal) detailsModal.style.display = 'flex';
        });
      });

      closeDetailsBtn?.addEventListener('click', () => {
        if (detailsModal) detailsModal.style.display = 'none';
      });

      detailsModal?.addEventListener('click', (e) => {
        if (e.target === detailsModal) detailsModal.style.display = 'none';
      });

      detUpdateNotesBtn?.addEventListener('click', async () => {
        if (!currentInspectingId || !detNotesEdit) return;
        const newNotes = detNotesEdit.value;

        try {
          const res = await fetch(`/api/inquiries/${currentInspectingId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ notes: newNotes })
          });

          if (res.ok) {
            // Update data-notes on the button
            const btn = document.querySelector(`.btn-view-notes[data-id="${currentInspectingId}"]`);
            if (btn) btn.setAttribute('data-notes', newNotes);
            alert('Notes updated successfully!');
            if (detailsModal) detailsModal.style.display = 'none';
          } else {
            alert('Failed to update notes.');
          }
        } catch (err) {
          alert('Network error updating notes.');
        }
      });
    }

    initInquiriesAdmin();
    document.addEventListener('astro:page-load', initInquiriesAdmin);
  </script>
</AdminLayout>
