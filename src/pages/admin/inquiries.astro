    /* Inquiries Table */
    .inquiries-container {
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(19, 20, 27, 0.7);
      overflow: hidden;
    }

    .table-responsive {
      overflow-x: auto;
    }

    .inquiries-table {
