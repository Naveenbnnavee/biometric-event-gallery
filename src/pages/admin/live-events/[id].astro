---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getLiveEventByIdAsync, getLiveEventBySlugAsync } from '../../../lib/db';
import { getCloudflareEnv } from '../../../lib/cloudflare';

export const prerender = false;

const env = await getCloudflareEnv();
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/live-events');
}

const event = (await getLiveEventByIdAsync(id, env)) || (await getLiveEventBySlugAsync(id, env));
if (!event) {
  return Astro.redirect('/admin/live-events');
}

const photos = event.photos || [];
---

<AdminLayout title={`${event.title} | Live Event Dashboard`} activeNav="live-events">
  <div class="admin-event-page" data-event-id={event.id} data-event-slug={event.slug} data-token={event.ingestionToken}>
    <!-- Top Nav / Back Breadcrumb -->
    <div class="breadcrumb-bar">
      <a href="/admin/live-events" class="back-link">← Back to All Live Events</a>
      <div class="top-status-pills">
        <span class:list={['mode-pill', {
          'mode-face': event.accessMode === 'face_only',
          'mode-open': event.accessMode === 'open_gallery',
          'mode-hybrid': event.accessMode === 'face_and_all' || event.accessMode === 'face_match'
        }]}>
          {event.accessMode === 'face_only' ? '🔒 1. Face Only' : (event.accessMode === 'open_gallery' ? '🌐 2. Whole Event' : '✨ 3. Face + Whole Event')}
        </span>
      </div>
    </div>

    <!-- Event Title Bar -->
    <div class="event-headline-card glass-card">
      <div class="headline-content">
        <div class="admin-gold-pill">EVENT STREAM CONTROL</div>
        <h1 class="event-title">{event.title}</h1>
        <p class="event-meta">
          <span>🏛️ {event.venue}</span>
          <span class="meta-dot">•</span>
          <span>📅 {event.date}</span>
          <span class="meta-dot">•</span>
          <span>🏷️ {event.ceremonyType}</span>
          <span class="meta-dot">•</span>
          <span>🔑 Token: <code>{event.ingestionToken}</code></span>
        </p>
      </div>

      <div class="headline-actions">
        <!-- Print QR Kit -->
        <button type="button" class="btn-action btn-action-gold" id="open-tent-card-btn" title="Generate Luxury Printable Guest Tent-Card QR Kit">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-svg">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>Print QR Kit</span>
        </button>

        <!-- Complete Event (One-Click Handover) -->
        <button type="button" class="btn-action btn-action-emerald" id="open-complete-event-btn" title="Complete Event and Move to Client Portal with WhatsApp Handover">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="btn-svg">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span>Complete Event</span>
        </button>

        <!-- Edit Details -->
        <button type="button" class="btn-action btn-action-subtle" id="open-edit-details-btn" title="Edit Event Title, Venue & Ceremony">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-svg">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          <span>Edit Details</span>
        </button>

        <!-- Guest Gallery -->
        <a href={`/live/${event.slug}`} target="_blank" rel="noopener noreferrer" class="btn-action btn-action-blue" title="Open Guest Gallery Portal">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-svg">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12.01" y2="18"></line>
          </svg>
          <span>Guest Gallery</span>
          <span class="btn-external-icon">↗</span>
        </a>

        <!-- Projector Wall -->
        <a href={`/live/${event.slug}/screen`} target="_blank" rel="noopener noreferrer" class="btn-action btn-action-purple" title="Open Ballroom Projector LED Screen Mode">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-svg">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <span>Projector Wall</span>
          <span class="btn-external-icon">↗</span>
        </a>

        <!-- Mobile Ingest (Hero Action) -->
        <a href={`/live-upload?token=${event.ingestionToken}`} target="_blank" rel="noopener noreferrer" class="btn-action btn-action-primary" title="Open Wireless Mobile Ingest Uploader">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="btn-svg">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>Mobile Ingest</span>
          <span class="btn-external-icon">↗</span>
        </a>

        <!-- Delete Event -->
        <button type="button" class="btn-action btn-action-danger" id="delete-this-event-btn" title="Delete this entire live event">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-svg">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>Delete</span>
        </button>
      </div>
    </div>

    <!-- Quick Settings Bar -->
    <div class="quick-settings-strip glass-card">
      <div class="setting-item">
        <span class="setting-title">Access Mode:</span>
        <select id="quick-mode-select" class="quick-select">
          <option value="face_only" selected={event.accessMode === 'face_only'}>1. Only Face Enabled (Strictly Their Photos Only)</option>
          <option value="open_gallery" selected={event.accessMode === 'open_gallery'}>2. Whole Event (Open Chronological Stream)</option>
          <option value="face_and_all" selected={event.accessMode === 'face_and_all' || event.accessMode === 'face_match'}>3. Face Enabled + Whole Event (Smart Hybrid)</option>
        </select>
      </div>

      <div class="setting-item">
        <span class="setting-title">High-Res Downloads:</span>
        <select id="quick-download-select" class="quick-select">
          <option value="true" selected={event.allowDownload}>Allowed (High-Res Buttons)</option>
          <option value="false" selected={!event.allowDownload}>Locked (View Only, Protected)</option>
        </select>
      </div>

      <div class="setting-item">
        <span class="setting-title">Studio Watermark:</span>
        <select id="quick-watermark-select" class="quick-select">
          <option value="true" selected={event.watermarkPreview}>Enabled (Frames By Hithu)</option>
          <option value="false" selected={!event.watermarkPreview}>Disabled</option>
        </select>
      </div>

      <div class="setting-item">
        <span class="setting-title">Stream Status:</span>
        <select id="quick-status-select" class="quick-select">
          <option value="live" selected={event.status === 'live'}>Live (Active)</option>
          <option value="upcoming" selected={event.status === 'upcoming'}>Upcoming</option>
          <option value="archived" selected={event.status === 'archived'}>Archived</option>
        </select>
      </div>
    </div>

    <!-- Method A: SD Card Assistant Batch Upload Dropzone -->
    <div class="sd-dropzone-section section-mb">
      <div class="dropzone-card glass-card">
        <div class="dropzone-header">
          <div>
            <span class="gold-pill">METHOD A • HIGH SPEED BATCH PIPELINE</span>
            <h2 class="dropzone-title">Camera SD Card Batch Dropzone</h2>
            <p class="dropzone-sub">
              Swap camera SD Card slot 2 directly into your laptop or card reader. Drag and drop multiple ceremony JPEGs below for instant live ingestion.
            </p>
          </div>
          <div class="dropzone-actions">
            <button type="button" class="btn-action btn-action-primary btn-sd-select" id="trigger-sd-upload-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="btn-svg">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Select SD Card Files</span>
            </button>
          </div>
        </div>

        <input
          type="file"
          id="sd-file-input"
          accept="image/jpeg,image/png,image/webp,image/heic"
          multiple
          class="hidden-input"
        />

        <div class="sd-drop-target" id="sd-drop-target">
          <div class="sd-icon">⚡</div>
          <h3>Drag & Drop SD Card Photos Here</h3>
          <p>Instant client-side thumbnail previews & rapid parallel Cloudflare KV persistence</p>
          <span class="sd-badge">JPG • JPEG • PNG • WEBP</span>
        </div>

        <!-- Progress Box -->
        <div class="batch-progress-box" id="batch-progress-box" style="display: none;">
          <div class="progress-info-row">
            <strong id="batch-status-text">Ingesting batch frames...</strong>
            <span id="batch-percent-text">0%</span>
          </div>
          <div class="progress-bar-wrap">
            <div class="progress-bar-fill" id="batch-bar-fill"></div>
          </div>
          <div class="progress-sub-details" id="batch-sub-details">0 of 0 uploaded</div>
        </div>
      </div>
    </div>

    <!-- Uploaded Photos Grid Header -->
    <div class="photos-management-header">
      <div>
        <h2 class="section-title">Live Ingested Frames ({photos.length})</h2>
        <p class="section-sub">Chronological feed of master photographs beamed into this live stream.</p>
      </div>

      <div class="photo-tools">
        {photos.length > 0 && (
          <button type="button" class="btn-action btn-action-danger btn-clear-feed" id="clear-all-photos-btn" title="Permanently remove all images from this event">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-svg">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            <span>Clear All ({photos.length}) Frames</span>
          </button>
        )}
        <button type="button" class="btn-action btn-action-subtle btn-refresh-feed" id="refresh-grid-btn" title="Refresh Live Ingested Feed">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-svg spin-icon">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          <span>Refresh Stream</span>
        </button>
      </div>
    </div>

    <!-- Photos Grid -->
    <div class="live-photos-grid" id="live-photos-grid">
      {photos.map((p, idx) => (
        <div class="live-photo-card glass-card" data-photo-id={p.id}>
          <div class="photo-media-box protected-media">
            <img src={p.url} alt={`Live Frame #${idx + 1}`} loading="lazy" class="live-img" />
            <div class="photo-badge-idx">#{photos.length - idx}</div>
            <button
              type="button"
              class="photo-delete-btn"
              data-photo-id={p.id}
              title="Delete Frame from Live Stream"
            >
              🗑️
            </button>
          </div>
          <div class="photo-info-bar">
            <span class="photo-time">⏱️ {new Date(p.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}</span>
            {p.faces && p.faces.length > 0 && (
              <span class="face-tag" title={`${p.faces.length} faces detected`}>
                👤 {p.faces.length}
              </span>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Edit Event Details Modal -->
    <div id="edit-details-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-box glass-card">
        <div class="modal-header">
          <h2 class="modal-headline">Edit Live Event Details</h2>
          <button type="button" class="close-modal-btn" id="close-edit-details-btn">✕</button>
        </div>

        <form id="edit-details-form" class="event-form">
          <div class="form-grid">
            <div class="form-group col-2">
              <label class="form-label" for="edit-event-title">Event Title *</label>
              <input type="text" id="edit-event-title" name="title" class="form-input" value={event.title} required />
            </div>

            <div class="form-group">
              <label class="form-label" for="edit-event-slug">URL Slug *</label>
              <input type="text" id="edit-event-slug" name="slug" class="form-input" value={event.slug} required />
            </div>

            <div class="form-group">
              <label class="form-label" for="edit-event-ceremony">Ceremony Type</label>
              <select id="edit-event-ceremony" name="ceremonyType" class="form-input">
                <option value="weddings" selected={event.ceremonyType === 'weddings'}>Weddings & Muhurtham</option>
                <option value="housewarming" selected={event.ceremonyType === 'housewarming'}>Gruhapravesham</option>
                <option value="poojas" selected={event.ceremonyType === 'poojas'}>Poojas & Sacred Rites</option>
                <option value="milestones" selected={event.ceremonyType === 'milestones'}>Milestones</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="edit-event-venue">Venue & City *</label>
              <input type="text" id="edit-event-venue" name="venue" class="form-input" value={event.venue} required />
            </div>

            <div class="form-group">
              <label class="form-label" for="edit-event-date">Ceremony Date *</label>
              <input type="date" id="edit-event-date" name="date" class="form-input" value={event.date} required />
            </div>

            <div class="form-group col-2">
              <label class="form-label" for="edit-event-token">Wireless Ingestion Token</label>
              <input type="text" id="edit-event-token" name="ingestionToken" class="form-input" value={event.ingestionToken} required />
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn-cancel" id="cancel-edit-details-btn">Cancel</button>
            <button type="submit" class="btn-gold" id="save-details-submit-btn">Save Changes</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Printable Luxury Tent-Card QR Modal -->
    <div id="tent-card-modal" class="modal-backdrop" style="display: none;">
      <div class="tent-card-modal-content glass-card">
        <div class="modal-header">
          <h2 class="modal-headline">Printable Luxury Guest Tent-Card QR Kit</h2>
          <button type="button" class="close-modal-btn" id="close-tent-card-btn">✕</button>
        </div>

        <!-- Printable Area -->
        <div class="tent-card-print-viewport" id="tent-card-print-area">
          <div class="tent-card-luxury-frame">
            <div class="tent-card-rim"></div>
            <div class="tent-card-corner tl"></div>
            <div class="tent-card-corner tr"></div>
            <div class="tent-card-corner bl"></div>
            <div class="tent-card-corner br"></div>

            <div class="tent-card-header">
              <span class="tent-brand-monogram">FBH</span>
              <h3 class="tent-brand-title">FRAMES BY HITHU</h3>
              <span class="tent-brand-sub">FINE-ART PHOTOGRAPHY • KARNATAKA</span>
            </div>

            <div class="tent-divider">
              <span class="divider-diamond">♦</span>
            </div>

            <div class="tent-event-info">
              <span class="tent-welcome">WELCOME TO THE CELEBRATION OF</span>
              <h2 class="tent-event-title" id="tent-preview-title">{event.title}</h2>
              <p class="tent-event-venue" id="tent-preview-venue">📍 {event.venue}</p>
            </div>

            <div class="tent-qr-box">
              <img id="tent-qr-image" src="" alt="Live Event QR Code" class="tent-qr-img" />
              <div class="qr-glow"></div>
            </div>

            <div class="tent-instructions">
              <strong class="instruction-lead">Scan with Your Smartphone Camera</strong>
              <p id="tent-instruction-detail" class="instruction-sub">
                {event.accessMode === 'face_match'
                  ? 'Take a quick selfie to discover and download every frame you appear in as sacred moments unfold.'
                  : 'Explore the full live ceremony stream and download high-resolution master frames live.'}
              </p>
            </div>

            <div class="tent-card-footer">
              <span>framesbyhithu.com</span>
              <span class="footer-dot">•</span>
              <span>Live AI Ceremony Stream</span>
            </div>
          </div>
        </div>

        <div class="modal-footer tent-footer-actions">
          <button type="button" class="btn-cancel" id="cancel-tent-btn">Close</button>
          <button type="button" class="btn-outline" id="download-qr-image-btn" title="Download QR Code image directly">
            <span>⬇️ Download QR Only (PNG)</span>
          </button>
          <button type="button" class="btn-outline" id="download-full-card-btn" title="Download Entire Luxury Card as High-Res Image">
            <span>🖼️ Download Card (PNG)</span>
          </button>
          <button type="button" class="btn-gold" id="do-print-card-btn" title="Print or save full-page PDF without headers/footers">
            <span>🖨️ Print Clean Full-Page PDF</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Complete Event & Client Portal Handover Modal -->
    <div id="complete-event-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-box glass-card complete-modal-box">
        <div class="modal-header">
          <div>
            <div class="gold-pill">ONE-CLICK AUTOMATION</div>
            <h2 class="modal-headline">Complete Event & Client Portal Handover</h2>
          </div>
          <button type="button" class="close-modal-btn" id="close-complete-event-btn">✕</button>
        </div>

        <!-- Step 1: Pre-Confirmation Form -->
        <div id="complete-step-form">
          <div class="complete-summary-strip">
            <div class="complete-stat-badge">
              <span class="stat-big-num" id="complete-summary-photos">{photos.length}</span>
              <span class="stat-small-label">Ceremony Frames</span>
            </div>
            <div class="complete-meta-block">
              <h3 class="complete-event-name">{event.title}</h3>
              <p class="complete-venue-line">📍 {event.venue} &bull; 📅 {event.date}</p>
              <div class="complete-transition-badge">
                <span class="pill-from">Status: <strong>{event.status.toUpperCase()}</strong></span>
                <span class="arrow-trans">&rarr;</span>
                <span class="pill-to">Transfers to: <strong>CLIENT PROOFING SUITE</strong></span>
              </div>
            </div>
          </div>

          <form id="complete-event-form" class="event-form">
            <div class="form-grid">
              <div class="form-group col-2">
                <label class="form-label" for="complete-client-name">Client / Couple Name *</label>
                <input
                  type="text"
                  id="complete-client-name"
                  name="clientName"
                  class="form-input"
                  value={event.title.split(' ')[0] || 'Esteemed Couple'}
                  required
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="complete-client-phone">Client WhatsApp Number</label>
                <input
                  type="tel"
                  id="complete-client-phone"
                  name="clientPhone"
                  class="form-input"
                  placeholder="+91 98765 43210"
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="complete-album-count">Target Album Favorites</label>
                <input
                  type="number"
                  id="complete-album-count"
                  name="targetAlbumCount"
                  class="form-input"
                  value={Math.min(100, Math.max(40, Math.floor(photos.length * 0.3) || 50))}
                  min="10"
                  max="500"
                />
              </div>

              <div class="form-group col-2">
                <label class="form-label" for="complete-custom-pin">
                  Secure 6-Digit PIN (Optional: Leave empty to auto-generate)
                </label>
                <input
                  type="text"
                  id="complete-custom-pin"
                  name="pin"
                  class="form-input"
                  placeholder="e.g. 849201"
                  maxlength="6"
                  pattern="[0-9]{6}"
                />
              </div>
            </div>

            <div class="modal-footer">
              <button type="button" class="btn-cancel" id="cancel-complete-event-btn">Cancel</button>
              <button type="submit" class="btn-action btn-action-emerald" id="submit-complete-event-btn">
                <span>🚀 Complete & Generate Handover Card</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Step 2: Generated Handover Credentials & WhatsApp Card -->
        <div id="complete-step-result" style="display: none;">
          <div class="complete-success-banner">
            <span class="success-icon">✨</span>
            <div>
              <strong class="success-title">Event Successfully Moved to Client Portal!</strong>
              <p class="success-sub">Private proofing link and 6-digit access PIN generated. Send the WhatsApp card below.</p>
            </div>
          </div>

          <!-- Credentials Display -->
          <div class="credentials-card glass-card">
            <div class="credential-row">
              <div class="cred-label">SECURE 6-DIGIT PASSCODE</div>
              <div class="pin-display-wrap">
                <span class="pin-code-large" id="res-pin-display">------</span>
                <button type="button" class="btn-copy-small" id="copy-pin-btn" title="Copy 6-digit PIN">
                  📋 Copy PIN
                </button>
              </div>
            </div>

            <div class="credential-row">
              <div class="cred-label">PRIVATE PROOFING LINK</div>
              <div class="link-display-wrap">
                <input type="text" id="res-link-input" class="form-input link-input" readonly />
                <button type="button" class="btn-copy-small" id="copy-link-btn" title="Copy Proofing URL">
                  📋 Copy Link
                </button>
                <a id="res-portal-link" href="#" target="_blank" rel="noopener noreferrer" class="btn-open-small" title="Open Proofing Portal">
                  Open ↗
                </a>
              </div>
            </div>

            <div class="credential-row">
              <div class="cred-label">GOOGLE REVIEW DIRECT LINK (REVIEW VELOCITY ENGINE)</div>
              <div class="link-display-wrap">
                <input type="text" id="res-review-input" class="form-input link-input" readonly />
                <button type="button" class="btn-copy-small" id="copy-review-btn" title="Copy Google Review Shortlink">
                  📋 Copy Review Link
                </button>
                <a id="res-review-link" href="#" target="_blank" rel="noopener noreferrer" class="btn-open-small" title="Test Google Review Link">
                  Test ↗
                </a>
              </div>
            </div>
          </div>

