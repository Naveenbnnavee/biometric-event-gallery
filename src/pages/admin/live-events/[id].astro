<script>
  function initEventDashboard() {
    const pageEl = document.querySelector('.admin-event-page') as HTMLElement;
    if (!pageEl) return;

    const eventId = pageEl.getAttribute('data-event-id') || '';
    const token = pageEl.getAttribute('data-token') || '';

    // Quick Settings Changes
    const modeSelect = document.getElementById('quick-mode-select') as HTMLSelectElement;
    const downloadSelect = document.getElementById('quick-download-select') as HTMLSelectElement;
    const watermarkSelect = document.getElementById('quick-watermark-select') as HTMLSelectElement;
    const statusSelect = document.getElementById('quick-status-select') as HTMLSelectElement;

    async function updateEventSetting(updates: Record<string, any>) {
      try {
        const res = await fetch(`/api/live-events/${eventId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updates)
        });
        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).showToast('Event settings updated!', 'success');
        } else {
          (window as any).showToast(data.error || 'Failed to update settings', 'error');
        }
      } catch {
        (window as any).showToast('Network error saving settings', 'error');
      }
    }

    modeSelect?.addEventListener('change', () => {
      updateEventSetting({ accessMode: modeSelect.value });
    });

    downloadSelect?.addEventListener('change', () => {
      updateEventSetting({ allowDownload: downloadSelect.value === 'true' });
    });

    watermarkSelect?.addEventListener('change', () => {
      updateEventSetting({ watermarkPreview: watermarkSelect.value === 'true' });
    });

    statusSelect?.addEventListener('change', () => {
      updateEventSetting({ status: statusSelect.value });
    });

    // SD Card Drag and Drop Batch Ingestion
    const dropTarget = document.getElementById('sd-drop-target');
    const fileInput = document.getElementById('sd-file-input') as HTMLInputElement;
    const triggerBtn = document.getElementById('trigger-sd-upload-btn');
    const progressBox = document.getElementById('batch-progress-box');
    const barFill = document.getElementById('batch-bar-fill');
    const statusText = document.getElementById('batch-status-text');
    const percentText = document.getElementById('batch-percent-text');
    const subDetails = document.getElementById('batch-sub-details');

    triggerBtn?.addEventListener('click', () => fileInput?.click());
    dropTarget?.addEventListener('click', () => fileInput?.click());

    dropTarget?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropTarget.classList.add('drag-over');
    });

    dropTarget?.addEventListener('dragleave', () => {
      dropTarget.classList.remove('drag-over');
    });

    dropTarget?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropTarget.classList.remove('drag-over');
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        handleBatchFiles(Array.from(e.dataTransfer.files));
      }
    });

    fileInput?.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleBatchFiles(Array.from(fileInput.files));
      }
    });

    // Fast Client-Side Image Resizer & Thumbnail Generator
    function resizeImageToDataUrl(file: File, maxDim = 1600, quality = 0.82): Promise<string> {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            let width = img.width;
            let height = img.height;
            if (width > maxDim || height > maxDim) {
              if (width > height) {
                height = Math.round((height * maxDim) / width);
                width = maxDim;
              } else {
                width = Math.round((width * maxDim) / height);
                height = maxDim;
              }
            }
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            if (ctx) {
              ctx.drawImage(img, 0, 0, width, height);
              resolve(canvas.toDataURL('image/jpeg', quality));
            } else {
              resolve(e.target?.result as string);
            }
          };
          img.onerror = () => resolve(e.target?.result as string);
          img.src = e.target?.result as string;
        };
        reader.onerror = () => resolve('');
        reader.readAsDataURL(file);
      });
    }

    // High-Efficiency Batch Upload Pipeline (Minimizing Cloudflare KV Writes)
    async function handleBatchFiles(files: File[]) {
      const validImages = files.filter(f => f.type.startsWith('image/') || /\.(jpe?g|png|webp|heic)$/i.test(f.name));
      if (validImages.length === 0) {
        (window as any).showToast('No valid image files found in dropzone', 'error');
        return;
      }

      if (progressBox) progressBox.style.display = 'block';

      // Smart Batch Chunking:
      // - 1 to 30 photos: 1 single batch -> Exactly 1 Cloudflare KV write!
      // - 100 to 2,000 photos: Chunks of 25-30 photos -> Only ~3-35 KV writes total (well below 1000/day limit)
      const BATCH_SIZE = 25;
      const totalPhotos = validImages.length;
      const totalBatches = Math.ceil(totalPhotos / BATCH_SIZE);

      let totalIngested = 0;
      let totalKVWrites = 0;

      for (let b = 0; b < totalBatches; b++) {
        const chunk = validImages.slice(b * BATCH_SIZE, (b + 1) * BATCH_SIZE);
        const batchNum = b + 1;
        const pct = Math.round((b / totalBatches) * 100);

        if (barFill) barFill.style.width = `${pct}%`;
        if (percentText) percentText.textContent = `${pct}%`;
        if (statusText) statusText.textContent = `Optimizing batch ${batchNum} of ${totalBatches} (${chunk.length} photos)...`;
        if (subDetails) subDetails.textContent = `Generating hardware-accelerated preview thumbnails client-side...`;

        // 1. Generate client-side preview thumbnails concurrently
        const framePromises = chunk.map(async (file, idx) => {
          const dataUrl = await resizeImageToDataUrl(file, 1600, 0.82);
          return {
            id: `frame_${Date.now()}_b${batchNum}_${idx}_${Math.random().toString(36).slice(2, 6)}`,
            url: dataUrl,
            caption: file.name.replace(/\.[^/.]+$/, ""),
            timestamp: new Date().toISOString()
          };
        });

        const frames = (await Promise.all(framePromises)).filter(f => f.url);

        if (frames.length === 0) continue;

        if (statusText) statusText.textContent = `Ingesting batch ${batchNum} of ${totalBatches} • 1 atomic KV write for ${frames.length} frames...`;
        if (subDetails) subDetails.textContent = `Conserving Cloudflare KV write quota (Batch ${batchNum}/${totalBatches})`;

        // 2. Single POST batch-upload request for this entire chunk
        try {
          const res = await fetch('/api/admin/live/batch-upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              eventId: eventId,
              token: token,
              frames: frames
            })
          });

          if (res.ok) {
            const data = await res.json();
            totalIngested += data.added || frames.length;
            totalKVWrites++;
          } else {
            console.warn(`Batch ${batchNum} response warning:`, await res.text());
          }
        } catch (err) {
          console.error(`Batch ${batchNum} network error:`, err);
        }
      }

      if (barFill) barFill.style.width = '100%';
      if (percentText) percentText.textContent = '100%';
      if (statusText) statusText.textContent = `Batch upload complete: ${totalIngested} photos ingested in only ${totalKVWrites} KV write(s)! 🚀`;
      if (subDetails) subDetails.textContent = `Free Tier Protected: Saved ${totalPhotos - totalKVWrites} redundant KV write requests!`;

      (window as any).showToast(`Successfully ingested ${totalIngested} photos in only ${totalKVWrites} atomic write(s)!`, 'success');

      setTimeout(() => {
        window.location.reload();
      }, 1200);
    }

    // Delete Photo
    const deletePhotoButtons = document.querySelectorAll('.photo-delete-btn');
    deletePhotoButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const photoId = btn.getAttribute('data-photo-id');
        if (!photoId || !confirm('Permanently remove this photo from the live event feed?')) return;

        try {
          const res = await fetch(`/api/live-events/${eventId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete_photo', photoId })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            (window as any).showToast('Photo removed from stream', 'success');
            const card = btn.closest('.live-photo-card');
            card?.remove();
          } else {
            (window as any).showToast(data.error || 'Failed to delete photo', 'error');
          }
        } catch {
          (window as any).showToast('Network error deleting photo', 'error');
        }
      });
    });

    // Edit Details Modal Handlers
    const editModal = document.getElementById('edit-details-modal');
    const openEditBtn = document.getElementById('open-edit-details-btn');
    const closeEditBtn = document.getElementById('close-edit-details-btn');
    const cancelEditBtn = document.getElementById('cancel-edit-details-btn');
    const editForm = document.getElementById('edit-details-form') as HTMLFormElement;

    function openEditModal() {
      if (editModal) editModal.style.display = 'flex';
    }

    function closeEditModal() {
      if (editModal) editModal.style.display = 'none';
    }

    openEditBtn?.addEventListener('click', openEditModal);
    closeEditBtn?.addEventListener('click', closeEditModal);
    cancelEditBtn?.addEventListener('click', closeEditModal);

    editForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('save-details-submit-btn') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';
      }

      const formData = new FormData(editForm);
      const title = formData.get('title') as string;
      const slug = formData.get('slug') as string;
      const ceremonyType = formData.get('ceremonyType') as string;
      const venue = formData.get('venue') as string;
      const date = formData.get('date') as string;
      const ingestionToken = formData.get('ingestionToken') as string;

      try {
        const res = await fetch(`/api/live-events/${eventId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, slug, ceremonyType, venue, date, ingestionToken })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).showToast('Event details updated successfully! ✓', 'success');
          closeEditModal();
          setTimeout(() => window.location.reload(), 300);
        } else {
          (window as any).showToast(data.error || 'Failed to update details', 'error');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Save Changes';
          }
        }
      } catch {
        (window as any).showToast('Network error saving details', 'error');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Save Changes';
        }
      }
    });

    // Delete Entire Event
    const deleteTopBtn = document.getElementById('delete-this-event-btn');
    deleteTopBtn?.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to permanently delete this entire live event and all its uploaded frames?')) return;

      try {
        const res = await fetch(`/api/live-events/${eventId}`, { method: 'DELETE' });
        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).showToast('Event permanently deleted! ✓', 'success');
          setTimeout(() => {
            window.location.href = '/admin/live-events';
          }, 350);
        } else {
          (window as any).showToast(data.error || 'Failed to delete event', 'error');
        }
      } catch {
        (window as any).showToast('Network error deleting event', 'error');
      }
    });

    // Clear All Photos
    const clearAllBtn = document.getElementById('clear-all-photos-btn');
    clearAllBtn?.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to permanently clear ALL frames from this live stream?')) return;

      try {
        const res = await fetch(`/api/live-events/${eventId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'clear_all_photos' })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).showToast('All photos cleared successfully! ✓', 'success');
          const grid = document.getElementById('live-photos-grid');
          if (grid) grid.innerHTML = '';
          setTimeout(() => window.location.reload(), 350);
        } else {
          (window as any).showToast(data.error || 'Failed to clear photos', 'error');
        }
      } catch {
        (window as any).showToast('Network error clearing photos', 'error');
      }
    });

    // Refresh Grid Button
    document.getElementById('refresh-grid-btn')?.addEventListener('click', () => {
      window.location.reload();
    });

    // Printable Luxury Tent-Card QR Kit Modal & Handlers
    const tentModal = document.getElementById('tent-card-modal');
    const openTentBtn = document.getElementById('open-tent-card-btn');
    const closeTentBtn = document.getElementById('close-tent-card-btn');
    const cancelTentBtn = document.getElementById('cancel-tent-btn');
    const doPrintBtn = document.getElementById('do-print-card-btn');
    const downloadQrBtn = document.getElementById('download-qr-image-btn');
    const downloadFullCardBtn = document.getElementById('download-full-card-btn');
    const tentQrImg = document.getElementById('tent-qr-image') as HTMLImageElement;
    const tentTitle = document.getElementById('tent-preview-title');
    const tentVenue = document.getElementById('tent-preview-venue');
    const tentDetail = document.getElementById('tent-instruction-detail');

    // Get event properties from page element
    const eventSlug = pageEl.getAttribute('data-event-slug') || pageEl.getAttribute('data-slug') || '';
    const eventTitle = tentTitle?.textContent || 'Live Event';
    const eventVenueText = tentVenue?.textContent || '';
    const origin = window.location.origin;
    const liveGalleryUrl = `${origin}/live/${eventSlug}`;

    openTentBtn?.addEventListener('click', () => {
      if (tentQrImg) {
        tentQrImg.crossOrigin = 'anonymous';
        tentQrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=600x600&data=${encodeURIComponent(liveGalleryUrl)}&margin=1`;
      }
      if (tentModal) tentModal.style.display = 'flex';
    });

    function closeTentCardModal() {
      if (tentModal) tentModal.style.display = 'none';
    }

    closeTentBtn?.addEventListener('click', closeTentCardModal);
    cancelTentBtn?.addEventListener('click', closeTentCardModal);

    // 1. Clean Full-Page Print & PDF Generation (Zero headers, dates, URLs or extra margin)
    doPrintBtn?.addEventListener('click', () => {
      const previousTitle = document.title;
      // Clear title completely so browser print headers NEVER contain event name, date or time!
      document.title = '';

      window.print();

      const restore = () => {
        document.title = previousTitle;
      };
      window.addEventListener('afterprint', restore, { once: true });
      setTimeout(restore, 2000);
    });

    // 2. Direct QR Code Image (PNG) Download
    downloadQrBtn?.addEventListener('click', async () => {
      if (!tentQrImg || !tentQrImg.src) return;
      try {
        const res = await fetch(tentQrImg.src);
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${eventSlug || 'event'}-qr-code.png`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        (window as any).showToast('QR Code image downloaded successfully! ✓', 'success');
      } catch {
        const a = document.createElement('a');
        a.href = tentQrImg.src;
        a.target = '_blank';
        a.download = `${eventSlug || 'event'}-qr-code.png`;
        a.click();
      }
    });

    // 3. Complete High-Res Luxury Tent Card (PNG) Standalone Download
    downloadFullCardBtn?.addEventListener('click', () => {
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 1200;
        canvas.height = 1700;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        // Background Gradient
        const grad = ctx.createRadialGradient(600, 850, 60, 600, 850, 950);
        grad.addColorStop(0, '#11141C');
        grad.addColorStop(1, '#05060A');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, 1200, 1700);

        // Outer Gold Border
        ctx.strokeStyle = '#D4AF37';
        ctx.lineWidth = 10;
        ctx.strokeRect(40, 40, 1120, 1620);

        // Inner Dashed Border
        ctx.strokeStyle = 'rgba(212, 175, 55, 0.45)';
        ctx.lineWidth = 2;
        ctx.setLineDash([10, 8]);
        ctx.strokeRect(58, 58, 1084, 1584);
        ctx.setLineDash([]);

        // Corner Ornamental Brackets
        const cSize = 40;
        ctx.strokeStyle = '#D4AF37';
        ctx.lineWidth = 4;
        // TL
        ctx.beginPath(); ctx.moveTo(68, 68 + cSize); ctx.lineTo(68, 68); ctx.lineTo(68 + cSize, 68); ctx.stroke();
        // TR
        ctx.beginPath(); ctx.moveTo(1132 - cSize, 68); ctx.lineTo(1132, 68); ctx.lineTo(1132, 68 + cSize); ctx.stroke();
        // BL
        ctx.beginPath(); ctx.moveTo(68, 1632 - cSize); ctx.lineTo(68, 1632); ctx.lineTo(68 + cSize, 1632); ctx.stroke();
        // BR
        ctx.beginPath(); ctx.moveTo(1132 - cSize, 1632); ctx.lineTo(1132, 1632); ctx.lineTo(1132, 1632 - cSize); ctx.stroke();

        // Monogram Circle Badge
        ctx.beginPath();
        ctx.arc(600, 170, 36, 0, Math.PI * 2);
        const goldFill = ctx.createLinearGradient(564, 134, 636, 206);
        goldFill.addColorStop(0, '#F59E0B');
        goldFill.addColorStop(1, '#D4AF37');
        ctx.fillStyle = goldFill;
        ctx.fill();

        ctx.fillStyle = '#0B0C10';
        ctx.font = 'bold 24px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('FBH', 600, 170);

        // Studio Title & Sub
        ctx.fillStyle = '#D4AF37';
        ctx.font = 'bold 36px "Cinzel", "Playfair Display", Georgia, serif';
        ctx.fillText('FRAMES BY HITHU', 600, 245);

        ctx.fillStyle = '#94A3B8';
        ctx.font = '600 16px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.fillText('FINE-ART PHOTOGRAPHY • KARNATAKA', 600, 280);

        // Divider
        ctx.strokeStyle = 'rgba(212, 175, 55, 0.4)';
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(360, 320); ctx.lineTo(570, 320); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(630, 320); ctx.lineTo(840, 320); ctx.stroke();
        ctx.fillStyle = '#D4AF37';
        ctx.font = '18px sans-serif';
        ctx.fillText('♦', 600, 320);

        // Welcome Line
        ctx.fillStyle = '#D4AF37';
        ctx.font = '600 18px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.fillText('WELCOME TO THE CELEBRATION OF', 600, 375);

        // Event Title (Text wrapping)
        ctx.fillStyle = '#FFFFFF';
        ctx.font = 'bold 44px "Playfair Display", Georgia, serif';
        const words = eventTitle.split(' ');
        let curLine = '';
        const titleLines: string[] = [];
        const maxTextWidth = 920;
        for (let i = 0; i < words.length; i++) {
          const test = curLine + words[i] + ' ';
          if (ctx.measureText(test).width > maxTextWidth && i > 0) {
            titleLines.push(curLine);
            curLine = words[i] + ' ';
          } else {
            curLine = test;
          }
        }
        titleLines.push(curLine);

        let textY = 440;
        titleLines.forEach(l => {
          ctx.fillText(l.trim(), 600, textY);
          textY += 54;
        });

        // Venue
        ctx.fillStyle = '#C5A059';
        ctx.font = '22px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.fillText(eventVenueText || '📍 Palace Grounds, Bengaluru', 600, textY + 10);

        // QR Code Box
        const qrBoxY = textY + 50;
        const qrSize = 460;
        const qrX = (1200 - qrSize) / 2;

        ctx.fillStyle = '#FFFFFF';
        ctx.beginPath();
        if (typeof (ctx as any).roundRect === 'function') {
          (ctx as any).roundRect(qrX, qrBoxY, qrSize, qrSize, 20);
        } else {
          ctx.rect(qrX, qrBoxY, qrSize, qrSize);
        }
        ctx.fill();

        // Draw QR Image
        if (tentQrImg && tentQrImg.complete && tentQrImg.naturalWidth > 0) {
          try {
            ctx.drawImage(tentQrImg, qrX + 24, qrBoxY + 24, qrSize - 48, qrSize - 48);
          } catch (e) {
            console.warn('Canvas QR draw fallback', e);
          }
        }

        // Instructions
        const instY = qrBoxY + qrSize + 55;
        ctx.fillStyle = '#D4AF37';
        ctx.font = 'bold 28px "Playfair Display", Georgia, serif';
        ctx.fillText('Scan with Your Smartphone Camera', 600, instY);

        ctx.fillStyle = '#CBD5E1';
        ctx.font = '20px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        const detail = tentDetail?.textContent || 'Discover and download every sacred moment live.';
        ctx.fillText(detail.slice(0, 80), 600, instY + 38);

        // Footer
        ctx.strokeStyle = 'rgba(212, 175, 55, 0.3)';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(350, 1540); ctx.lineTo(850, 1540); ctx.stroke();

        ctx.fillStyle = '#D4AF37';
        ctx.font = '18px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.fillText('framesbyhithu.com   •   Live AI Ceremony Stream', 600, 1580);

        canvas.toBlob((blob) => {
          if (!blob) return;
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${eventSlug || 'event'}-luxury-tent-card.png`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          (window as any).showToast('Luxury Tent-Card image downloaded! ✓', 'success');
        }, 'image/png');
      } catch (err: any) {
        (window as any).showToast('Download error: ' + (err.message || 'Failed to render card'), 'error');
      }
    });

    // ==========================================
    // ONE-CLICK COMPLETE EVENT & HANDOVER SUITE
    // ==========================================
    const completeModal = document.getElementById('complete-event-modal');
    const openCompleteBtn = document.getElementById('open-complete-event-btn');
    const closeCompleteBtn = document.getElementById('close-complete-event-btn');
    const cancelCompleteBtn = document.getElementById('cancel-complete-event-btn');
    const completeForm = document.getElementById('complete-event-form') as HTMLFormElement;
    const stepForm = document.getElementById('complete-step-form');
    const stepResult = document.getElementById('complete-step-result');
    const resPin = document.getElementById('res-pin-display');
    const resLinkInput = document.getElementById('res-link-input') as HTMLInputElement;
    const resPortalLink = document.getElementById('res-portal-link') as HTMLAnchorElement;
    const waPreview = document.getElementById('wa-message-preview');
    const waSendBtn = document.getElementById('wa-direct-send-btn') as HTMLAnchorElement;
    const copyPinBtn = document.getElementById('copy-pin-btn');
    const copyLinkBtn = document.getElementById('copy-link-btn');
    const copyWaBtn = document.getElementById('copy-wa-text-btn');
    const doneBtn = document.getElementById('done-complete-modal-btn');

    openCompleteBtn?.addEventListener('click', () => {
      if (completeModal) completeModal.style.display = 'flex';
    });

    if (new URLSearchParams(window.location.search).get('complete') === '1') {
      if (completeModal) completeModal.style.display = 'flex';
    }

    function closeCompleteModal() {
      if (completeModal) completeModal.style.display = 'none';
    }

    closeCompleteBtn?.addEventListener('click', closeCompleteModal);
    cancelCompleteBtn?.addEventListener('click', closeCompleteModal);
    completeModal?.addEventListener('click', (e) => {
      if (e.target === completeModal) closeCompleteModal();
    });

    completeForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-complete-event-btn') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Processing Handover (1 Atomic Write)...';
      }

      const formData = new FormData(completeForm);
      const clientName = (formData.get('clientName') as string) || '';
      const clientPhone = (formData.get('clientPhone') as string) || '';
      const targetAlbumCount = parseInt(formData.get('targetAlbumCount') as string, 10) || undefined;
      const pin = (formData.get('pin') as string) || undefined;

      try {
        const res = await fetch(`/api/live-events/${eventId}/complete`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            clientName,
            clientPhone,
            targetAlbumCount,
            pin: pin || undefined,
            token: token
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          if (stepForm) stepForm.style.display = 'none';
          if (stepResult) stepResult.style.display = 'block';

          if (resPin) resPin.textContent = data.pin;
          if (resLinkInput) resLinkInput.value = data.fullProofingUrl;
          if (resPortalLink) resPortalLink.href = data.fullProofingUrl;
          if (data.googleReviewUrl) {
            const resReviewInput = document.getElementById('res-review-input') as HTMLInputElement | null;
            const resReviewLink = document.getElementById('res-review-link') as HTMLAnchorElement | null;
            if (resReviewInput) resReviewInput.value = data.googleReviewUrl;
            if (resReviewLink) resReviewLink.href = data.googleReviewUrl;
          }
          if (waPreview) waPreview.textContent = data.whatsappMessage;
          if (waSendBtn) waSendBtn.href = data.whatsappUrl;

          (window as any).showToast('Event moved to Client Portal! Handover card ready ✨', 'success');
        } else {
          (window as any).showToast(data.error || 'Failed to complete event', 'error');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = '🚀 Complete & Generate Handover Card';
          }
        }
      } catch (err: any) {
        (window as any).showToast('Network error: ' + (err.message || 'Complete failed'), 'error');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '🚀 Complete & Generate Handover Card';
        }
      }
    });

    copyPinBtn?.addEventListener('click', () => {
      const pinVal = resPin?.textContent?.trim();
      if (pinVal) {
        navigator.clipboard.writeText(pinVal);
        copyPinBtn.textContent = 'Copied ✓';
        setTimeout(() => { copyPinBtn.textContent = '📋 Copy PIN'; }, 2000);
        (window as any).showToast('6-Digit PIN copied to clipboard!', 'success');
      }
    });

    copyLinkBtn?.addEventListener('click', () => {
      const linkVal = resLinkInput?.value;
      if (linkVal) {
        navigator.clipboard.writeText(linkVal);
        copyLinkBtn.textContent = 'Copied ✓';
        setTimeout(() => { copyLinkBtn.textContent = '📋 Copy Link'; }, 2000);
        (window as any).showToast('Private Proofing Link copied to clipboard!', 'success');
      }
    });

    const copyReviewBtn = document.getElementById('copy-review-btn');
    copyReviewBtn?.addEventListener('click', () => {
      const revVal = (document.getElementById('res-review-input') as HTMLInputElement | null)?.value;
      if (revVal) {
        navigator.clipboard.writeText(revVal);
        copyReviewBtn.textContent = 'Copied ✓';
        setTimeout(() => { copyReviewBtn.textContent = '📋 Copy Review Link'; }, 2000);
        (window as any).showToast('Google Review shortlink copied to clipboard!', 'success');
      }
    });

    copyWaBtn?.addEventListener('click', () => {
      const msgVal = waPreview?.textContent;
      if (msgVal) {
        navigator.clipboard.writeText(msgVal);
        copyWaBtn.textContent = 'Copied ✓';
        setTimeout(() => { copyWaBtn.textContent = '📋 Copy Message Text'; }, 2000);
        (window as any).showToast('WhatsApp message text copied to clipboard!', 'success');
      }
    });

    doneBtn?.addEventListener('click', () => {
      window.location.reload();
    });
  }

  initEventDashboard();
  document.addEventListener('astro:page-load', initEventDashboard);
</script>
