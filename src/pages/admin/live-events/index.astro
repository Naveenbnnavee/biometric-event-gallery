---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getLiveEventsAsync } from '../../../lib/db';
import { getCloudflareEnv } from '../../../lib/cloudflare';

export const prerender = false;

const env = await getCloudflareEnv();
const events = await getLiveEventsAsync(env);

// Stats
const totalEvents = events.length;
const liveNow = events.filter(e => e.status === 'live').length;
const totalPhotos = events.reduce((sum, e) => sum + (e.photos?.length || 0), 0);
---

<AdminLayout title="Live Event Streams & QR Consoles | Frames By Hithu" activeNav="live-events">
  <div class="admin-page-container">
    <!-- Header with Stats -->
    <div class="page-top-bar">
      <div>
        <div class="admin-gold-pill">REAL-TIME INGESTION & GUEST GALLERIES</div>
        <h1 class="page-heading">Live Event QR & AI Face-Match Consoles</h1>
        <p class="page-subheading">
          Manage live ceremony streams, wireless camera ingestion tokens, and generate luxury printable guest table tent-cards.
        </p>
      </div>

      <div class="top-actions">
        <button type="button" class="btn-gold" id="open-create-modal-btn">
          <span>+ Create New Live Event</span>
        </button>
      </div>
    </div>

    <!-- Quick Metrics Row -->
    <div class="metrics-grid">
      <div class="metric-card glass-card">
        <div class="metric-icon">⚡</div>
        <div class="metric-data">
          <span class="metric-number">{liveNow}</span>
          <span class="metric-label">Active Live Streams</span>
        </div>
      </div>

      <div class="metric-card glass-card">
        <div class="metric-icon">📸</div>
        <div class="metric-data">
          <span class="metric-number">{totalPhotos}</span>
          <span class="metric-label">Live Ingested Frames</span>
        </div>
      </div>

      <div class="metric-card glass-card">
        <div class="metric-icon">🏛️</div>
        <div class="metric-data">
          <span class="metric-number">{totalEvents}</span>
          <span class="metric-label">Total Registered Events</span>
        </div>
      </div>

      <div class="metric-card glass-card">
        <div class="metric-icon">🤖</div>
        <div class="metric-data">
          <span class="metric-number">{events.filter(e => e.accessMode === 'face_only' || e.accessMode === 'face_and_all' || e.accessMode === 'face_match').length}</span>
          <span class="metric-label">AI Face-Match Deployed</span>
        </div>
      </div>
    </div>

    <!-- Events List Table -->
    <div class="events-table-card glass-card">
      <div class="table-card-header">
        <h2 class="table-title">All Live Event Streams</h2>
        <span class="table-badge">{events.length} configured</span>
      </div>

      {events.length === 0 ? (
        <div class="empty-state text-center">
          <div class="empty-icon">⚡</div>
          <h3>No Live Events Created Yet</h3>
          <p>Create your first real-time event to generate guest QR tent-cards and wireless camera ingestion tokens.</p>
          <button type="button" class="btn-gold" id="empty-create-btn">+ Create First Live Event</button>
        </div>
      ) : (
        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Event Title & Venue</th>
                <th>Ceremony & Date</th>
                <th>Live Frames</th>
                <th>Access Mode</th>
                <th>Download & Protection</th>
                <th>Status</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              {events.map((evt) => (
                <tr data-event-id={evt.id} data-event-slug={evt.slug}>
                  <td>
                    <div class="event-title-cell">
                      <strong class="evt-title">{evt.title}</strong>
                      <span class="evt-venue">📍 {evt.venue}</span>
                      <span class="evt-slug">Path: /live/{evt.slug}</span>
                    </div>
                  </td>
                  <td>
                    <div class="ceremony-cell">
                      <span class="ceremony-pill">{evt.ceremonyType}</span>
                      <span class="evt-date">{evt.date}</span>
                    </div>
                  </td>
                  <td>
                    <div class="photos-count-cell">
                      <span class="count-badge">{evt.photos?.length || 0}</span>
                      <a href={`/admin/live-events/${evt.id}`} class="manage-photos-link">Manage SD Dropzone →</a>
                    </div>
                  </td>
                  <td>
                    <span class:list={['mode-pill', {
                      'mode-face': evt.accessMode === 'face_only',
                      'mode-open': evt.accessMode === 'open_gallery',
                      'mode-hybrid': evt.accessMode === 'face_and_all' || evt.accessMode === 'face_match'
                    }]}>
                      {evt.accessMode === 'face_only' ? '🔒 1. Face Only' : (evt.accessMode === 'open_gallery' ? '🌐 2. Whole Event' : '✨ 3. Face + Whole Event')}
                    </span>
                  </td>
                  <td>
                    <div class="protection-cell">
                      <span class="protect-badge" title="Download Policy">
                        {evt.allowDownload ? '⬇️ Download Allowed' : '🔒 Download Locked'}
                      </span>
                      <span class="watermark-sub-badge">
                        {evt.watermarkPreview ? '🛡️ Studio Watermark ON' : 'Off'}
                      </span>
                    </div>
                  </td>
                  <td>
                    <span class:list={['status-pill', `status-${evt.status}`]}>
                      {evt.status.toUpperCase()}
                    </span>
                  </td>
                  <td class="text-right">
                    <div class="action-buttons-group">
                      <!-- Dropzone Dashboard -->
                      <a
                        href={`/admin/live-events/${evt.id}`}
                        class="table-btn primary-btn"
                        title="Open Event Dashboard & SD Card Dropzone"
                      >
                        ⚡ Ingest SD
                      </a>

                      <!-- Complete Event & Handover -->
                      {evt.status !== 'archived' && (
                        <a
                          href={`/admin/live-events/${evt.id}?complete=1`}
                          class="table-btn complete-btn"
                          title="Complete Event and Move to Client Portal with WhatsApp Handover"
                        >
                          ✅ Complete
                        </a>
                      )}

                      <!-- Wireless Link Copier -->
                      <button
                        type="button"
                        class="table-btn copy-token-btn"
                        data-token={evt.ingestionToken}
                        title="Copy Photographer Wireless Mobile Link"
                      >
                        📱 Mobile Ingest
                      </button>

                      <!-- Printable Tent Card -->
                      <button
                        type="button"
                        class="table-btn print-card-btn"
                        data-slug={evt.slug}
                        data-title={evt.title}
                        data-venue={evt.venue}
                        data-mode={evt.accessMode}
                        title="Generate Printable Luxury Tent-Card QR"
                      >
                        🪧 Print QR Kit
                      </button>

                      <!-- Public View -->
                      <a
                        href={`/live/${evt.slug}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="table-btn"
                        title="View Live Guest Gallery"
                      >
                        👁️ Live
                      </a>

                      <!-- Projector -->
                      <a
                        href={`/live/${evt.slug}/screen`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="table-btn"
                        title="Open Ballroom Projector LED Screen Mode"
                      >
                        📺 LED Wall
                      </a>

                      <!-- Edit -->
                      <button
                        type="button"
                        class="table-btn edit-btn edit-event-btn"
                        data-id={evt.id}
                        data-title={evt.title}
                        data-slug={evt.slug}
                        data-ceremony={evt.ceremonyType}
                        data-venue={evt.venue}
                        data-date={evt.date}
                        data-status={evt.status}
                        data-mode={evt.accessMode}
                        data-download={evt.allowDownload ? 'true' : 'false'}
                        data-watermark={evt.watermarkPreview ? 'true' : 'false'}
                        data-token={evt.ingestionToken}
                        title="Edit Event Details & Settings"
                      >
                        ✏️ Edit
                      </button>

                      <!-- Delete -->
                      <button
                        type="button"
                        class="table-btn delete-btn delete-event-btn"
                        data-id={evt.id}
                        data-title={evt.title}
                        title="Delete Event"
                      >
                        🗑️
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <!-- Create / Edit Event Drawer / Modal -->
  <div id="event-modal" class="modal-backdrop" style="display: none;">
    <div class="modal-box glass-card">
      <div class="modal-header">
        <h2 id="modal-title" class="modal-headline">Create New Real-Time Live Event</h2>
        <button type="button" class="close-modal-btn" id="close-modal-btn">✕</button>
      </div>

      <form id="create-event-form" class="event-form">
        <input type="hidden" id="edit-event-id" name="id" value="" />

        <div class="form-grid">
          <div class="form-group col-2">
            <label class="form-label" for="event-title">Event Title *</label>
            <input
              type="text"
              id="event-title"
              name="title"
              class="form-input"
              placeholder="e.g. Ananya & Rohit Wedding Muhurtham"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="event-slug">URL Slug *</label>
            <div class="slug-input-wrap">
              <span class="slug-prefix">/live/</span>
              <input
                type="text"
                id="event-slug"
                name="slug"
                class="form-input"
                placeholder="ananya-rohit-wedding"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="event-ceremony">Ceremony Type *</label>
            <select id="event-ceremony" name="ceremonyType" class="form-input">
              <option value="weddings">Weddings & Muhurtham</option>
              <option value="housewarming">Gruhapravesham (Housewarming)</option>
              <option value="poojas">Traditional Poojas & Sacred Rites</option>
              <option value="milestones">Milestones & Celebrations</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="event-venue">Venue & City *</label>
            <input
              type="text"
              id="event-venue"
              name="venue"
              class="form-input"
              placeholder="e.g. Palace Grounds, Bengaluru"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="event-date">Ceremony Date *</label>
            <input
              type="date"
              id="event-date"
              name="date"
              class="form-input"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="event-status">Event Status</label>
            <select id="event-status" name="status" class="form-input">
              <option value="live">Live (Active Streaming)</option>
              <option value="upcoming">Upcoming (Pre-Event)</option>
              <option value="archived">Archived</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="event-token">Wireless Ingestion Token</label>
            <input
              type="text"
              id="event-token"
              name="ingestionToken"
              class="form-input"
              placeholder="e.g. live_ananya_2026"
            />
          </div>

          <!-- 3-Mode Setting -->
          <div class="form-group col-2 setting-highlight-box">
            <label class="form-label">Guest Gallery Access Mode</label>
            <div class="mode-options-grid">
              <label class="mode-radio-card">
                <input type="radio" name="accessMode" value="face_only" checked />
                <div class="radio-card-body">
                  <strong>🔒 1. Only Face Enabled (Private)</strong>
                  <p>Guests take a selfie and see ONLY their matched photos. Viewing other ceremony photos is completely disabled.</p>
                </div>
              </label>

              <label class="mode-radio-card">
                <input type="radio" name="accessMode" value="open_gallery" />
                <div class="radio-card-body">
                  <strong>🌐 2. Whole Event (Open Stream)</strong>
                  <p>No selfie required. All guests scan QR and immediately view the full chronological ceremony gallery.</p>
                </div>
              </label>

              <label class="mode-radio-card">
                <input type="radio" name="accessMode" value="face_and_all" />
                <div class="radio-card-body">
                  <strong>✨ 3. Face Enabled + Whole Event</strong>
                  <p>Guests take a selfie to view their photos first, with an active toggle button to also browse all ceremony photos.</p>
                </div>
              </label>
            </div>
          </div>

          <!-- Protection & Download Controls -->
          <div class="form-group col-2 setting-highlight-box">
            <label class="form-label">Admin Download & Protection Controls</label>
            <div class="toggles-row">
              <label class="toggle-control">
                <input type="checkbox" id="allow-download-toggle" name="allowDownload" value="true" checked />
                <span>Allow Guests to Download High-Res Master Frames</span>
              </label>

              <label class="toggle-control">
                <input type="checkbox" id="watermark-toggle" name="watermarkPreview" value="true" checked />
                <span>Display Subtle Gold Studio Watermark Overlay</span>
              </label>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-cancel" id="cancel-modal-btn">Cancel</button>
          <button type="submit" class="btn-gold" id="save-event-submit-btn">Save Live Event</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Printable Luxury Tent-Card QR Modal -->
  <div id="tent-card-modal" class="modal-backdrop" style="display: none;">
    <div class="tent-card-modal-content glass-card">
      <div class="modal-header">
        <h2 class="modal-headline">Printable Luxury Guest Tent-Card QR Kit</h2>
        <button type="button" class="close-modal-btn" id="close-tent-card-btn">✕</button>
      </div>

      <!-- Printable Area -->
      <div class="tent-card-print-viewport" id="tent-card-print-area">
        <div class="tent-card-luxury-frame">
          <div class="tent-card-rim"></div>
          <div class="tent-card-corner tl"></div>
          <div class="tent-card-corner tr"></div>
          <div class="tent-card-corner bl"></div>
          <div class="tent-card-corner br"></div>

          <div class="tent-card-header">
            <span class="tent-brand-monogram">FBH</span>
            <h3 class="tent-brand-title">FRAMES BY HITHU</h3>
            <span class="tent-brand-sub">FINE-ART PHOTOGRAPHY • KARNATAKA</span>
          </div>

          <div class="tent-divider">
            <span class="divider-diamond">♦</span>
          </div>

          <div class="tent-event-info">
            <span class="tent-welcome">WELCOME TO THE CELEBRATION OF</span>
            <h2 class="tent-event-title" id="tent-preview-title">Ananya & Rohit Wedding</h2>
            <p class="tent-event-venue" id="tent-preview-venue">📍 Palace Grounds, Bengaluru</p>
          </div>

          <div class="tent-qr-box">
            <img id="tent-qr-image" src="" alt="Live Event QR Code" class="tent-qr-img" />
            <div class="qr-glow"></div>
          </div>

          <div class="tent-instructions">
            <strong class="instruction-lead">Scan with Your Smartphone Camera</strong>
            <p id="tent-instruction-detail" class="instruction-sub">
              Instantly discover and download your personal photos live as the sacred rituals unfold.
            </p>
          </div>

          <div class="tent-card-footer">
            <span>framesbyhithu.com</span>
            <span class="footer-dot">•</span>
            <span>Live AI Ceremony Stream</span>
          </div>
        </div>
      </div>

      <div class="modal-footer tent-footer-actions">
        <button type="button" class="btn-cancel" id="cancel-tent-btn">Close</button>
        <button type="button" class="btn-outline" id="download-qr-image-btn" title="Download QR Code image directly">
          <span>⬇️ Download QR Only (PNG)</span>
        </button>
        <button type="button" class="btn-outline" id="download-full-card-btn" title="Download Entire Luxury Card as High-Res Image">
          <span>🖼️ Download Card (PNG)</span>
        </button>
        <button type="button" class="btn-gold" id="do-print-card-btn" title="Print or save full-page PDF without headers/footers">
          <span>🖨️ Print Clean Full-Page PDF</span>
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .admin-page-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .page-top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .admin-gold-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--gold-light);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--gold-border);
    padding: 4px 12px;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
  }

  .page-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: var(--text-primary);
    margin: 0 0 0.35rem 0;
  }

  .page-subheading {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 760px;
    margin: 0;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 1024px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }
  }

  .metric-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: 12px;
    background: rgba(14, 16, 22, 0.75);
    border: 1px solid var(--border-subtle);
  }

  .metric-icon {
    font-size: 2.2rem;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--gold-border);
  }

  .metric-data {
    display: flex;
    flex-direction: column;
  }

  .metric-number {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--gold-light);
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Table Card */
  .events-table-card {
    border-radius: 14px;
    background: rgba(14, 16, 22, 0.75);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .table-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .table-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--text-primary);
    margin: 0;
  }

  .table-badge {
    font-size: 0.8rem;
    color: var(--gold-light);
    background: rgba(212, 175, 55, 0.12);
    padding: 3px 10px;
    border-radius: 9999px;
    border: 1px solid var(--gold-border);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.875rem;
  }

  .admin-table th {
    background: rgba(0, 0, 0, 0.3);
    padding: 0.85rem 1.25rem;
    font-size: 0.775rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
  }

  .admin-table td {
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    vertical-align: middle;
  }

  .admin-table tr:hover {
    background: rgba(212, 175, 55, 0.03);
  }

  .event-title-cell {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .evt-title {
    color: var(--text-primary);
    font-size: 1rem;
  }

  .evt-venue {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .evt-slug {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--gold-light);
    opacity: 0.9;
  }

  .ceremony-cell {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ceremony-pill {
    display: inline-block;
    font-size: 0.725rem;
    text-transform: capitalize;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    border-radius: 4px;
    width: fit-content;
  }

  .evt-date {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .photos-count-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .count-badge {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--gold-light);
  }

  .manage-photos-link {
    font-size: 0.75rem;
    color: var(--gold-primary);
    text-decoration: none;
  }

  .manage-photos-link:hover {
    text-decoration: underline;
  }

  .mode-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.775rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .mode-pill.mode-face {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
    color: #FCA5A5;
  }

  .mode-pill.mode-open {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    color: #93C5FD;
  }

  .mode-pill.mode-hybrid {
    background: rgba(212, 175, 55, 0.15);
    border-color: rgba(212, 175, 55, 0.4);
    color: var(--gold-light);
  }

  .protection-cell {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.75rem;
  }

  .protect-badge {
    color: var(--text-muted);
  }

  .watermark-sub-badge {
    font-size: 0.7rem;
    color: var(--gold-light);
    opacity: 0.85;
  }

  .status-pill {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .status-live {
    background: rgba(16, 185, 129, 0.2);
    color: #10B981;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .status-upcoming {
    background: rgba(59, 130, 246, 0.2);
    color: #60A5FA;
    border: 1px solid rgba(59, 130, 246, 0.4);
  }

  .status-archived {
    background: rgba(156, 163, 175, 0.2);
    color: #9CA3AF;
  }

  .text-right {
    text-align: right;
  }

