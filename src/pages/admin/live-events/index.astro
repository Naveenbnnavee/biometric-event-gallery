<script>
  function initLiveEventsConsole() {
    const createModal = document.getElementById('event-modal');
    const openCreateBtn = document.getElementById('open-create-modal-btn');
    const emptyCreateBtn = document.getElementById('empty-create-btn');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const cancelModalBtn = document.getElementById('cancel-modal-btn');
    const createForm = document.getElementById('create-event-form') as HTMLFormElement;
    const titleInput = document.getElementById('event-title') as HTMLInputElement;
    const slugInput = document.getElementById('event-slug') as HTMLInputElement;
    const tokenInput = document.getElementById('event-token') as HTMLInputElement;

    // Tent Card Modal Elements
    const tentModal = document.getElementById('tent-card-modal');
    const closeTentBtn = document.getElementById('close-tent-card-btn');
    const cancelTentBtn = document.getElementById('cancel-tent-btn');
    const doPrintBtn = document.getElementById('do-print-card-btn');
    const tentTitle = document.getElementById('tent-preview-title');
    const tentVenue = document.getElementById('tent-preview-venue');
    const tentQrImg = document.getElementById('tent-qr-image') as HTMLImageElement;
    const tentDetail = document.getElementById('tent-instruction-detail');

    function openCreateModal() {
      if (createModal) {
        if (createForm) createForm.reset();
        const editIdInput = document.getElementById('edit-event-id') as HTMLInputElement;
        if (editIdInput) editIdInput.value = '';
        const modalTitle = document.getElementById('modal-title');
        if (modalTitle) modalTitle.textContent = 'Create New Real-Time Live Event';
        const submitBtn = document.getElementById('save-event-submit-btn');
        if (submitBtn) submitBtn.textContent = 'Save Live Event';
        if (slugInput) delete slugInput.dataset.manualEdit;
        if (tokenInput) {
          tokenInput.value = `live_${Math.random().toString(36).slice(2, 10)}`;
        }
        createModal.style.display = 'flex';
      }
    }

    function closeModal() {
      if (createModal) createModal.style.display = 'none';
    }

    openCreateBtn?.addEventListener('click', openCreateModal);
    emptyCreateBtn?.addEventListener('click', openCreateModal);
    closeModalBtn?.addEventListener('click', closeModal);
    cancelModalBtn?.addEventListener('click', closeModal);

    // Edit Event Handlers
    const editButtons = document.querySelectorAll('.edit-event-btn');
    editButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '';
        const title = btn.getAttribute('data-title') || '';
        const slug = btn.getAttribute('data-slug') || '';
        const ceremony = btn.getAttribute('data-ceremony') || 'weddings';
        const venue = btn.getAttribute('data-venue') || '';
        const date = btn.getAttribute('data-date') || '';
        const status = btn.getAttribute('data-status') || 'live';
        const mode = btn.getAttribute('data-mode') || 'face_match';
        const allowDl = btn.getAttribute('data-download') === 'true';
        const watermark = btn.getAttribute('data-watermark') === 'true';
        const token = btn.getAttribute('data-token') || '';

        const editIdInput = document.getElementById('edit-event-id') as HTMLInputElement;
        const modalTitle = document.getElementById('modal-title');
        const ceremonySelect = document.getElementById('event-ceremony') as HTMLSelectElement;
        const venueInput = document.getElementById('event-venue') as HTMLInputElement;
        const dateInput = document.getElementById('event-date') as HTMLInputElement;
        const statusSelect = document.getElementById('event-status') as HTMLSelectElement;
        const allowDlToggle = document.getElementById('allow-download-toggle') as HTMLInputElement;
        const watermarkToggle = document.getElementById('watermark-toggle') as HTMLInputElement;
        const modeRadios = document.querySelectorAll('input[name="accessMode"]') as NodeListOf<HTMLInputElement>;
        const submitBtn = document.getElementById('save-event-submit-btn');

        if (editIdInput) editIdInput.value = id;
        if (titleInput) titleInput.value = title;
        if (slugInput) {
          slugInput.value = slug;
          slugInput.dataset.manualEdit = 'true';
        }
        if (ceremonySelect) ceremonySelect.value = ceremony;
        if (venueInput) venueInput.value = venue;
        if (dateInput) dateInput.value = date;
        if (statusSelect) statusSelect.value = status;
        if (tokenInput) tokenInput.value = token;
        if (allowDlToggle) allowDlToggle.checked = allowDl;
        if (watermarkToggle) watermarkToggle.checked = watermark;
        modeRadios.forEach(r => {
          r.checked = r.value === mode || (mode === 'face_match' && r.value === 'face_and_all');
        });

        if (modalTitle) modalTitle.textContent = `Edit Live Event: ${title}`;
        if (submitBtn) submitBtn.textContent = 'Save Changes';
        if (createModal) createModal.style.display = 'flex';
      });
    });

    // Auto-populate slug from title
    titleInput?.addEventListener('input', () => {
      if (slugInput && !slugInput.dataset.manualEdit) {
        slugInput.value = titleInput.value
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }
    });

    slugInput?.addEventListener('input', () => {
      slugInput.dataset.manualEdit = 'true';
    });

    // Save Event Form (Create & Update)
    createForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('save-event-submit-btn') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving Live Event...';
      }

      const formData = new FormData(createForm);
      const id = (formData.get('id') as string)?.trim() || undefined;
      const title = formData.get('title') as string;
      const slug = formData.get('slug') as string;
      const ceremonyType = formData.get('ceremonyType') as string;
      const venue = formData.get('venue') as string;
      const date = formData.get('date') as string;
      const status = formData.get('status') as string;
      const accessMode = formData.get('accessMode') as string;
      const allowDownload = formData.get('allowDownload') === 'true';
      const watermarkPreview = formData.get('watermarkPreview') === 'true';
      const ingestionToken = (formData.get('ingestionToken') as string)?.trim() || `live_${Math.random().toString(36).slice(2, 10)}`;

      try {
        const res = await fetch('/api/live-events', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id,
            title,
            slug,
            ceremonyType,
            venue,
            date,
            status,
            accessMode,
            allowDownload,
            watermarkPreview,
            ingestionToken
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).showToast(id ? 'Live event updated successfully! ✓' : 'Live event created successfully! ✓', 'success');
          closeModal();
          setTimeout(() => window.location.reload(), 300);
        } else {
          (window as any).showToast(data.error || 'Failed to save event', 'error');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = id ? 'Save Changes' : 'Save Live Event';
          }
        }
      } catch (err: any) {
        (window as any).showToast(err.message || 'Network error saving event', 'error');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = id ? 'Save Changes' : 'Save Live Event';
        }
      }
    });

    // Copy Wireless Mobile Ingest Link
    const copyTokenButtons = document.querySelectorAll('.copy-token-btn');
    copyTokenButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const token = btn.getAttribute('data-token');
        const origin = window.location.origin;
        const ingestUrl = `${origin}/live-upload?token=${encodeURIComponent(token || '')}`;

        if (navigator.clipboard) {
          navigator.clipboard.writeText(ingestUrl).then(() => {
            (window as any).showToast('Wireless mobile upload link copied to clipboard! 📋', 'success');
          });
        } else {
          prompt('Copy Photographer Ingestion Link:', ingestUrl);
        }
      });
    });

    // Delete Event Buttons
    const deleteButtons = document.querySelectorAll('.delete-event-btn');
    deleteButtons.forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        if (!confirm(`Are you sure you want to permanently delete the live stream for "${title}"?`)) {
          return;
        }

        try {
          const res = await fetch(`/api/live-events/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok && data.success) {
            (window as any).showToast('Event deleted successfully! ✓', 'success');
            const tr = btn.closest('tr');
            if (tr) tr.remove();
            setTimeout(() => window.location.reload(), 400);
          } else {
            (window as any).showToast(data.error || 'Failed to delete event', 'error');
          }
        } catch {
          (window as any).showToast('Network error deleting event', 'error');
        }
      });
    });

    // Printable Luxury Tent-Card QR Kit Trigger & Handlers
    let currentActiveSlug = '';
    let currentActiveTitle = '';
    let currentActiveVenue = '';
    let currentActiveMode = '';
    const printCardButtons = document.querySelectorAll('.print-card-btn');
    const downloadQrBtn = document.getElementById('download-qr-image-btn');
    const downloadFullCardBtn = document.getElementById('download-full-card-btn');

    printCardButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug') || '';
        const title = btn.getAttribute('data-title') || '';
        const venue = btn.getAttribute('data-venue') || '';
        const mode = btn.getAttribute('data-mode') || '';

        currentActiveSlug = slug;
        currentActiveTitle = title;
        currentActiveVenue = venue;
        currentActiveMode = mode;

        const origin = window.location.origin;
        const liveUrl = `${origin}/live/${slug}`;

        if (tentTitle) tentTitle.textContent = title;
        if (tentVenue) tentVenue.textContent = `📍 ${venue}`;
        if (tentDetail) {
          tentDetail.textContent = mode === 'face_match'
            ? 'Take a quick selfie to discover and download every frame you appear in as sacred moments unfold.'
            : 'Explore the full live ceremony stream and download high-resolution master frames live.';
        }

        if (tentQrImg) {
          // Generates high-res QR code with CORS support for canvas drawing
          tentQrImg.crossOrigin = 'anonymous';
          tentQrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=600x600&data=${encodeURIComponent(liveUrl)}&margin=1`;
        }

        if (tentModal) tentModal.style.display = 'flex';
      });
    });

    function closeTentCardModal() {
      if (tentModal) tentModal.style.display = 'none';
    }

    closeTentBtn?.addEventListener('click', closeTentCardModal);
    cancelTentBtn?.addEventListener('click', closeTentCardModal);

    // 1. Clean Full-Page Print & PDF Generation (Zero headers, dates, URLs or extra margin)
    doPrintBtn?.addEventListener('click', () => {
      const previousTitle = document.title;
      // Strip document.title completely so browser print headers NEVER show event name, time or date!
      document.title = '';

      window.print();

      const restoreTitle = () => {
        document.title = previousTitle;
      };
      window.addEventListener('afterprint', restoreTitle, { once: true });
      setTimeout(restoreTitle, 2000);
    });

    // 2. Direct QR Code Image (PNG) Download
    downloadQrBtn?.addEventListener('click', async () => {
      if (!tentQrImg || !tentQrImg.src) return;
      try {
        const res = await fetch(tentQrImg.src);
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${currentActiveSlug || 'event'}-qr-code.png`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        (window as any).showToast('QR Code image downloaded successfully! ✓', 'success');
      } catch {
        const a = document.createElement('a');
        a.href = tentQrImg.src;
        a.target = '_blank';
        a.download = `${currentActiveSlug || 'event'}-qr-code.png`;
        a.click();
      }
    });

    // 3. Complete High-Res Luxury Tent Card (PNG) Standalone Download
    downloadFullCardBtn?.addEventListener('click', () => {
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 1200;
        canvas.height = 1700;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        // Background Gradient
        const grad = ctx.createRadialGradient(600, 850, 60, 600, 850, 950);
        grad.addColorStop(0, '#11141C');
        grad.addColorStop(1, '#05060A');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, 1200, 1700);

        // Outer Gold Border
        ctx.strokeStyle = '#D4AF37';
        ctx.lineWidth = 10;
        ctx.strokeRect(40, 40, 1120, 1620);

        // Inner Dashed Border
        ctx.strokeStyle = 'rgba(212, 175, 55, 0.45)';
        ctx.lineWidth = 2;
        ctx.setLineDash([10, 8]);
        ctx.strokeRect(58, 58, 1084, 1584);
        ctx.setLineDash([]);

        // Corner Ornamental Brackets
        const cSize = 40;
        ctx.strokeStyle = '#D4AF37';
        ctx.lineWidth = 4;
        // TL
        ctx.beginPath(); ctx.moveTo(68, 68 + cSize); ctx.lineTo(68, 68); ctx.lineTo(68 + cSize, 68); ctx.stroke();
        // TR
        ctx.beginPath(); ctx.moveTo(1132 - cSize, 68); ctx.lineTo(1132, 68); ctx.lineTo(1132, 68 + cSize); ctx.stroke();
        // BL
        ctx.beginPath(); ctx.moveTo(68, 1632 - cSize); ctx.lineTo(68, 1632); ctx.lineTo(68 + cSize, 1632); ctx.stroke();
        // BR
        ctx.beginPath(); ctx.moveTo(1132 - cSize, 1632); ctx.lineTo(1132, 1632); ctx.lineTo(1132, 1632 - cSize); ctx.stroke();

        // Monogram Circle Badge
        ctx.beginPath();
        ctx.arc(600, 170, 36, 0, Math.PI * 2);
        const goldFill = ctx.createLinearGradient(564, 134, 636, 206);
        goldFill.addColorStop(0, '#F59E0B');
        goldFill.addColorStop(1, '#D4AF37');
        ctx.fillStyle = goldFill;
        ctx.fill();

        ctx.fillStyle = '#0B0C10';
        ctx.font = 'bold 24px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('FBH', 600, 170);

        // Studio Title & Sub
        ctx.fillStyle = '#D4AF37';
        ctx.font = 'bold 36px "Cinzel", "Playfair Display", Georgia, serif';
        ctx.fillText('FRAMES BY HITHU', 600, 245);

        ctx.fillStyle = '#94A3B8';
        ctx.font = '600 16px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.fillText('FINE-ART PHOTOGRAPHY • KARNATAKA', 600, 280);

        // Divider
        ctx.strokeStyle = 'rgba(212, 175, 55, 0.4)';
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(360, 320); ctx.lineTo(570, 320); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(630, 320); ctx.lineTo(840, 320); ctx.stroke();
        ctx.fillStyle = '#D4AF37';
        ctx.font = '18px sans-serif';
        ctx.fillText('♦', 600, 320);

        // Welcome Line
        ctx.fillStyle = '#D4AF37';
        ctx.font = '600 18px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.fillText('WELCOME TO THE CELEBRATION OF', 600, 375);

        // Event Title (Text wrapping)
        ctx.fillStyle = '#FFFFFF';
        ctx.font = 'bold 44px "Playfair Display", Georgia, serif';
        const words = (currentActiveTitle || 'Live Ceremony').split(' ');
        let curLine = '';
        const titleLines: string[] = [];
        const maxTextWidth = 920;
        for (let i = 0; i < words.length; i++) {
          const test = curLine + words[i] + ' ';
          if (ctx.measureText(test).width > maxTextWidth && i > 0) {
            titleLines.push(curLine);
            curLine = words[i] + ' ';
          } else {
            curLine = test;
          }
        }
        titleLines.push(curLine);

        let textY = 440;
        titleLines.forEach(l => {
          ctx.fillText(l.trim(), 600, textY);
          textY += 54;
        });

        // Venue
        ctx.fillStyle = '#C5A059';
        ctx.font = '22px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.fillText(`📍 ${currentActiveVenue || 'Palace Grounds, Bengaluru'}`, 600, textY + 10);

        // QR Code Box
        const qrBoxY = textY + 50;
        const qrSize = 460;
        const qrX = (1200 - qrSize) / 2;

        ctx.fillStyle = '#FFFFFF';
        ctx.beginPath();
        if (typeof (ctx as any).roundRect === 'function') {
          (ctx as any).roundRect(qrX, qrBoxY, qrSize, qrSize, 20);
        } else {
          ctx.rect(qrX, qrBoxY, qrSize, qrSize);
        }
        ctx.fill();

        // Draw QR Image
        if (tentQrImg && tentQrImg.complete && tentQrImg.naturalWidth > 0) {
          try {
            ctx.drawImage(tentQrImg, qrX + 24, qrBoxY + 24, qrSize - 48, qrSize - 48);
          } catch (e) {
            console.warn('Canvas QR draw fallback', e);
          }
        }

        // Instructions
        const instY = qrBoxY + qrSize + 55;
        ctx.fillStyle = '#D4AF37';
        ctx.font = 'bold 28px "Playfair Display", Georgia, serif';
        ctx.fillText('Scan with Your Smartphone Camera', 600, instY);

        ctx.fillStyle = '#CBD5E1';
        ctx.font = '20px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        const detail = currentActiveMode === 'face_match'
          ? 'Take a quick selfie to discover and download every frame you appear in live.'
          : 'Explore the full live ceremony stream and download high-resolution master frames live.';
        ctx.fillText(detail, 600, instY + 38);

        // Footer
        ctx.strokeStyle = 'rgba(212, 175, 55, 0.3)';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(350, 1540); ctx.lineTo(850, 1540); ctx.stroke();

        ctx.fillStyle = '#D4AF37';
        ctx.font = '18px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        ctx.fillText('framesbyhithu.com   •   Live AI Ceremony Stream', 600, 1580);

        canvas.toBlob((blob) => {
          if (!blob) return;
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${currentActiveSlug || 'event'}-luxury-tent-card.png`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          (window as any).showToast('Luxury Tent-Card image downloaded! ✓', 'success');
        }, 'image/png');
      } catch (err: any) {
        (window as any).showToast('Download error: ' + (err.message || 'Failed to render card'), 'error');
      }
    });
  }

  initLiveEventsConsole();
  document.addEventListener('astro:page-load', initLiveEventsConsole);
</script>
