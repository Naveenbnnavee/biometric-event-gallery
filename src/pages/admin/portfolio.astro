</style>

<script>
  // Filter and search
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const placementTabs = document.querySelectorAll('#placement-filter-tabs .filter-tab');
  const categoryTabs = document.querySelectorAll('#category-filter-tabs .filter-tab');
  const photoCards = document.querySelectorAll('.photo-card');
  const emptyState = document.getElementById('no-photos-found');

  let activePlacement = 'all';
  let activeCategory = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visibleCount = 0;

    photoCards.forEach((card: any) => {
      const cardCategory = card.getAttribute('data-category') || '';
      const cardHero = card.getAttribute('data-hero') === 'true';
      const cardDeck = card.getAttribute('data-deck') === 'true';
      const cardGrid = card.getAttribute('data-grid') === 'true';
      const cardStories = card.getAttribute('data-stories') === 'true';
      const cardRetouch = card.getAttribute('data-retouch') === 'true';

      const cardTitle = card.getAttribute('data-title') || '';
      const cardVenue = card.getAttribute('data-venue') || '';
      const cardLoc = card.getAttribute('data-loc') || '';
      const cardHeadline = card.getAttribute('data-headline') || '';

      // Placement filter check
      let matchesPlacement = true;
      if (activePlacement === 'heroSlider') matchesPlacement = cardHero;
      else if (activePlacement === 'instantDeck') matchesPlacement = cardDeck;
      else if (activePlacement === 'portfolioGrid') matchesPlacement = cardGrid;
      else if (activePlacement === 'clientStories') matchesPlacement = cardStories;
      else if (activePlacement === 'beforeAfterSlider') matchesPlacement = cardRetouch;

      // Category filter check
      let matchesCategory = true;
      if (activeCategory !== 'all') {
        matchesCategory = cardCategory === activeCategory;
      }

      // Search query check
      const matchesSearch = !searchQuery ||
        cardTitle.includes(searchQuery) ||
        cardVenue.includes(searchQuery) ||
        cardLoc.includes(searchQuery) ||
        cardHeadline.includes(searchQuery);

      if (matchesPlacement && matchesCategory && matchesSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilters();
  });

  placementTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      placementTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activePlacement = tab.getAttribute('data-placement') || 'all';
      applyFilters();
    });
  });

  categoryTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      categoryTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activeCategory = tab.getAttribute('data-category') || 'all';
      applyFilters();
    });
  });

  // Modal elements
  const photoModal = document.getElementById('photo-modal');
  const modalHeading = document.getElementById('modal-heading');
  const openModalBtn = document.getElementById('add-photo-btn');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const photoForm = document.getElementById('photo-form') as HTMLFormElement;
  const editIdInput = document.getElementById('edit-id') as HTMLInputElement;

  // Form field inputs
  const photoImageUrl = document.getElementById('photo-image-url') as HTMLInputElement;
  const photoTitle = document.getElementById('photo-title') as HTMLInputElement;
  const photoCategory = document.getElementById('photo-category') as HTMLSelectElement;
  const photoAspect = document.getElementById('photo-aspect') as HTMLSelectElement;
  const photoVenue = document.getElementById('photo-venue') as HTMLInputElement;
  const photoLocation = document.getElementById('photo-location') as HTMLInputElement;
  const photoHeadline = document.getElementById('photo-headline') as HTMLInputElement;
  const photoSubline = document.getElementById('photo-subline') as HTMLInputElement;
  const photoBeforeImage = document.getElementById('photo-before-image') as HTMLInputElement;
  const photoAlt = document.getElementById('photo-alt') as HTMLInputElement;
  const photoBadge = document.getElementById('photo-badge') as HTMLInputElement;

  // Checkboxes
  const placeHero = document.getElementById('place-hero') as HTMLInputElement;
  const placeDeck = document.getElementById('place-deck') as HTMLInputElement;
  const placeGrid = document.getElementById('place-grid') as HTMLInputElement;
  const placeStories = document.getElementById('place-stories') as HTMLInputElement;
  const placeRetouch = document.getElementById('place-retouch') as HTMLInputElement;

  // Upload dropzone & preview elements
  const previewBox = document.getElementById('image-preview-box');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const fileInput = document.getElementById('portfolio-file-input') as HTMLInputElement;
  const dropzone = document.getElementById('upload-dropzone');
  const dropzoneContent = document.getElementById('dropzone-default-content');
  const uploadSpinner = document.getElementById('upload-spinner');
  const removePreviewBtn = document.getElementById('remove-preview-btn');
  const tabUploadBtn = document.getElementById('tab-upload-btn');
  const tabUrlBtn = document.getElementById('tab-url-btn');
  const urlContainer = document.getElementById('url-input-container');

  // Source toggle
  // Source toggle
  tabUploadBtn?.addEventListener('click', () => {
    tabUploadBtn.classList.add('active');
    tabUrlBtn?.classList.remove('active');
    if (urlContainer) urlContainer.style.display = 'none';
    if (dropzone) {
      dropzone.style.display = 'block';
      if (dropzoneContent) dropzoneContent.style.display = 'flex';
    }
  });

  tabUrlBtn?.addEventListener('click', () => {
    tabUrlBtn.classList.add('active');
    tabUploadBtn?.classList.remove('active');
    if (dropzone) dropzone.style.display = 'none';
    if (urlContainer) urlContainer.style.display = 'block';
    photoImageUrl?.focus();
  });

  // Handle file upload
  async function handleFileUpload(file: File) {
    if (!file) return;

    // Immediate client-side preview via FileReader
    const reader = new FileReader();
    reader.onload = (e) => {
      const dataUrl = e.target?.result as string;
      if (previewImg) previewImg.src = dataUrl;
      if (previewBox) previewBox.style.display = 'block';
      if (dropzone) dropzone.style.display = 'none';
      if (photoImageUrl) photoImageUrl.value = dataUrl;
    };
    reader.readAsDataURL(file);

    if (dropzoneContent) dropzoneContent.style.display = 'none';
    if (uploadSpinner) uploadSpinner.style.display = 'flex';

    const formData = new FormData();
    formData.append('file', file);

    try {
      const res = await fetch('/api/upload', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (res.ok && data.success && data.url) {
        if (photoImageUrl) photoImageUrl.value = data.url;
        if (previewImg) previewImg.src = data.url;
        if (previewBox) previewBox.style.display = 'block';
        if (dropzone) dropzone.style.display = 'none';
        (window as any).showToast('Photo uploaded successfully!', 'success');
      } else {
        // Fallback to client data URL if server had error
        if (photoImageUrl?.value?.startsWith('data:')) {
          (window as any).showToast('Photograph loaded as embedded asset!', 'success');
        } else {
          (window as any).showToast(data.error || 'Upload failed', 'error');
          if (dropzoneContent) dropzoneContent.style.display = 'flex';
          if (dropzone) dropzone.style.display = 'block';
        }
      }
    } catch {
      if (photoImageUrl?.value?.startsWith('data:')) {
        (window as any).showToast('Photograph loaded locally and ready to save!', 'success');
      } else {
        (window as any).showToast('Upload failed due to network error', 'error');
        if (dropzoneContent) dropzoneContent.style.display = 'flex';
        if (dropzone) dropzone.style.display = 'block';
      }
    } finally {
      if (uploadSpinner) uploadSpinner.style.display = 'none';
    }
  }

  // Click on dropzone opens file dialog
  dropzone?.addEventListener('click', (e) => {
    if (e.target !== fileInput) {
      fileInput?.click();
    }
  });

  fileInput?.addEventListener('change', (e: any) => {
    const file = e.target.files?.[0];
    if (file) handleFileUpload(file);
  });

  // Drag and drop
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('dragover');
  });
  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('dragover');
  });
  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dragover');
    const file = e.dataTransfer?.files?.[0];
    if (file) handleFileUpload(file);
  });

  // Change / Remove image button
  removePreviewBtn?.addEventListener('click', () => {
    if (photoImageUrl) photoImageUrl.value = '';
    if (previewBox) previewBox.style.display = 'none';
    if (previewImg) previewImg.src = '';
    if (fileInput) fileInput.value = '';

    // Switch cleanly to upload file tab
    tabUploadBtn?.classList.add('active');
    tabUrlBtn?.classList.remove('active');
    if (dropzone) dropzone.style.display = 'block';
    if (dropzoneContent) dropzoneContent.style.display = 'flex';
    if (urlContainer) urlContainer.style.display = 'none';
  });

  photoImageUrl?.addEventListener('input', () => {
    const val = photoImageUrl.value.trim();
    if (val && previewBox && previewImg) {
      previewImg.src = val;
      previewBox.style.display = 'block';
    } else if (previewBox) {
      previewBox.style.display = 'none';
    }
  });

  // Open modal in Add mode
  openModalBtn?.addEventListener('click', () => {
    if (modalHeading) modalHeading.textContent = 'Add Master Photograph';
    const saveBtn = document.getElementById('save-photo-btn');
    if (saveBtn) saveBtn.textContent = 'Add to Archive';
    if (editIdInput) editIdInput.value = '';
    if (photoForm) photoForm.reset();

    // Default placements
    if (placeGrid) placeGrid.checked = true;
    if (placeDeck) placeDeck.checked = false;
    if (placeHero) placeHero.checked = false;
    if (placeStories) placeStories.checked = false;
    if (placeRetouch) placeRetouch.checked = false;

    if (previewBox) previewBox.style.display = 'none';
    if (previewImg) previewImg.src = '';
    if (dropzone) dropzone.style.display = 'block';
    if (dropzoneContent) dropzoneContent.style.display = 'flex';
    if (urlContainer) urlContainer.style.display = 'none';
    tabUploadBtn?.classList.add('active');
    tabUrlBtn?.classList.remove('active');

    if (photoModal) photoModal.style.display = 'flex';
  });

  // Open modal in Edit mode
  function openEditModal(photoData: any) {
    if (modalHeading) modalHeading.textContent = `Edit Photograph: ${photoData.title}`;
    const saveBtn = document.getElementById('save-photo-btn');
    if (saveBtn) saveBtn.textContent = 'Save Changes';

    if (editIdInput) editIdInput.value = photoData.id;
    if (photoImageUrl) photoImageUrl.value = photoData.image || '';
    if (photoTitle) photoTitle.value = photoData.title || '';
    if (photoCategory) photoCategory.value = photoData.category || 'weddings';
    if (photoAspect) photoAspect.value = photoData.aspectRatio || photoData.aspect || 'portrait';
    if (photoVenue) photoVenue.value = photoData.venue || '';
    if (photoLocation) photoLocation.value = photoData.location || '';
    if (photoHeadline) photoHeadline.value = photoData.headline || '';
    if (photoSubline) photoSubline.value = photoData.subline || '';
    if (photoBeforeImage) photoBeforeImage.value = photoData.beforeImage || '';
    if (photoAlt) photoAlt.value = photoData.altText || '';
    if (photoBadge) photoBadge.value = photoData.deckBadge || '';

    // Checkboxes
    const placements = photoData.placements || {};
    if (placeHero) placeHero.checked = Boolean(placements.heroSlider);
    if (placeDeck) placeDeck.checked = Boolean(placements.instantDeck ?? photoData.featuredInInstantDeck);
    if (placeGrid) placeGrid.checked = Boolean(placements.portfolioGrid ?? true);
    if (placeStories) placeStories.checked = Boolean(placements.clientStories);
    if (placeRetouch) placeRetouch.checked = Boolean(placements.beforeAfterSlider);

    // Preview
    if (photoData.image && previewBox && previewImg) {
      previewImg.src = photoData.image;
      previewBox.style.display = 'block';
      if (dropzone) dropzone.style.display = 'none';
      if (urlContainer) urlContainer.style.display = 'none';
      tabUploadBtn?.classList.remove('active');
      tabUrlBtn?.classList.remove('active');
    } else {
      if (previewBox) previewBox.style.display = 'none';
      if (dropzone) dropzone.style.display = 'block';
      if (dropzoneContent) dropzoneContent.style.display = 'flex';
      if (urlContainer) urlContainer.style.display = 'none';
      tabUploadBtn?.classList.add('active');
      tabUrlBtn?.classList.remove('active');
    }

    if (photoModal) photoModal.style.display = 'flex';
  }

  // Hook up Edit buttons
  const editButtons = document.querySelectorAll('.edit-photo-btn');
  editButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.photo-card');
      const rawJson = card?.getAttribute('data-json');
      if (rawJson) {
        try {
          const photoData = JSON.parse(rawJson);
          openEditModal(photoData);
        } catch (err) {
          console.error('Failed to parse photo json:', err);
        }
      }
    });
  });

  function closeModal() {
    if (photoModal) photoModal.style.display = 'none';
    if (photoForm) photoForm.reset();
    if (previewBox) previewBox.style.display = 'none';
  }

  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);

  // Submit Add or Update Photo
  async function executePhotoSave(e?: Event) {
    if (e) e.preventDefault();
    const saveBtn = document.getElementById('save-photo-btn') as HTMLButtonElement;
    const editId = editIdInput?.value.trim();
    const isEdit = Boolean(editId);

    const imageVal = photoImageUrl?.value.trim() || previewImg?.getAttribute('src')?.trim() || '';
    const titleVal = photoTitle?.value.trim() || '';

    if (!imageVal) {
      (window as any).showToast('Please upload an image or provide an Image URL', 'error');
      return;
    }

    if (!titleVal) {
      (window as any).showToast('Please enter a Photograph Title', 'error');
      photoTitle?.focus();
      return;
    }

    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
    }

    const catSelect = photoCategory;
    const catText = catSelect?.options[catSelect.selectedIndex]?.text || '';

    const payload = {
      image: imageVal,
      title: titleVal,
      category: photoCategory?.value || 'weddings',
      categoryLabel: catText.replace(/^[^\s]+\s*/, '') || 'Weddings & Muhurtham',
      aspectRatio: photoAspect?.value || 'portrait',
      aspect: photoAspect?.value || 'portrait',
      venue: photoVenue?.value.trim() || 'Heritage Venue',
      location: photoLocation?.value.trim() || 'Karnataka, India',
      headline: photoHeadline?.value.trim() || titleVal,
      subline: photoSubline?.value.trim() || '',
      beforeImage: photoBeforeImage?.value.trim() || undefined,
      altText: photoAlt?.value.trim() || `${titleVal} by Frames By Hithu`,
      deckBadge: photoBadge?.value.trim() || undefined,
      placements: {
        heroSlider: placeHero?.checked || false,
        instantDeck: placeDeck?.checked || false,
        portfolioGrid: placeGrid?.checked || false,
        clientStories: placeStories?.checked || false,
        beforeAfterSlider: placeRetouch?.checked || false
      },
      featuredInInstantDeck: placeDeck?.checked || false
    };

    try {
      const url = isEdit ? `/api/portfolio/${editId}` : '/api/portfolio';
      const method = isEdit ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (res.ok && data.success) {
        (window as any).showToast(
          isEdit ? 'Photograph updated successfully!' : 'Photograph added to archive!',
          'success'
        );

        if (isEdit && data.item) {
          const card = document.querySelector(`.photo-card[data-id="${editId}"]`);
          if (card) {
            const imgEl = card.querySelector('.photo-img') as HTMLImageElement;
            if (imgEl && data.item.image) imgEl.src = data.item.image;
            const titleEl = card.querySelector('.photo-title');
            if (titleEl && data.item.title) titleEl.textContent = data.item.title;
            const venueEl = card.querySelector('.photo-venue');
            if (venueEl && data.item.venue) venueEl.textContent = `📍 ${data.item.venue}`;
            const locEl = card.querySelector('.photo-loc');
            if (locEl && data.item.location) locEl.textContent = data.item.location;
            card.setAttribute('data-json', JSON.stringify(data.item));
          }
        }

        closeModal();
        setTimeout(() => window.location.reload(), 300);
      } else {
        (window as any).showToast(data.error || 'Operation failed', 'error');
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = isEdit ? 'Save Changes' : 'Add to Archive';
        }
      }
    } catch (err: any) {
      console.error('Save error:', err);
      (window as any).showToast('Network error saving photograph', 'error');
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = isEdit ? 'Save Changes' : 'Add to Archive';
      }
    }
  }

  photoForm?.addEventListener('submit', executePhotoSave);
  const savePhotoBtnEl = document.getElementById('save-photo-btn');
  savePhotoBtnEl?.addEventListener('click', executePhotoSave);

  // Quick Toggle Instant Deck
  const quickDeckButtons = document.querySelectorAll('.quick-deck-btn');
  quickDeckButtons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      const isActive = btn.getAttribute('data-active') === 'true';

      try {
        const res = await fetch(`/api/portfolio/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            placements: { instantDeck: !isActive },
            featuredInInstantDeck: !isActive
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).showToast(
            !isActive ? 'Added to homepage Instant Card Stack!' : 'Removed from Instant Card Stack',
            'success'
          );
          setTimeout(() => window.location.reload(), 300);
        }
      } catch {
        (window as any).showToast('Failed to update instant deck status', 'error');
      }
    });
  });

  // Quick Toggle Before/After Retouch Slider
  const quickRetouchButtons = document.querySelectorAll('.quick-retouch-btn');
  quickRetouchButtons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      const isActive = btn.getAttribute('data-active') === 'true';

      try {
        const res = await fetch(`/api/portfolio/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            placements: { beforeAfterSlider: !isActive }
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).showToast(
            !isActive ? 'Featured in Before/After Retouch Slider!' : 'Removed from Retouch Slider',
            'success'
          );
          setTimeout(() => window.location.reload(), 300);
        } else {
          (window as any).showToast(data.error || 'Failed to update retouch slider', 'error');
        }
      } catch {
        (window as any).showToast('Network error updating retouch status', 'error');
      }
    });
  });

  // Delete Photo
  const deleteButtons = document.querySelectorAll('.delete-photo-btn');
  deleteButtons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      const title = btn.getAttribute('data-title');
      if (!confirm(`Are you sure you want to permanently delete "${title}" from the master archive?`)) {
        return;
      }

      try {
        const res = await fetch(`/api/portfolio/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (res.ok && data.success) {
          (window as any).showToast('Photo removed from archive', 'success');
          const card = (btn as HTMLElement).closest('.photo-card');
          card?.remove();
        } else {
          (window as any).showToast(data.error || 'Failed to delete photo', 'error');
        }
      } catch {
        (window as any).showToast('Network error deleting photo', 'error');
      }
    });
  });
</script>
