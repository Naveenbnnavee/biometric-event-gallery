---
import Layout from '../layouts/Layout.astro';
import BespokeInquiryModal from '../components/BespokeInquiryModal.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { getStudioSettingsAsync } from '../lib/db';

export const prerender = false;

const settings = await getStudioSettingsAsync();

const hasSocials = Boolean(
  settings.instagramUrl?.trim() ||
  settings.facebookUrl?.trim() ||
  settings.youtubeUrl?.trim() ||
  settings.pinterestUrl?.trim()
);

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': 'Contact & Date Availability | Frames By Hithu',
  'description': 'Check date availability and request a custom quote for luxury weddings, Gruhapravesham, and traditional poojas across Karnataka.',
  'url': 'https://framesbyhithu.com/contact'
};
---

<Layout
  title="Check Date Availability & Custom Quote | Frames By Hithu"
  description="Request date availability and a personalized fine-art proposal for your upcoming wedding, Gruhapravesham, or pooja in Karnataka. Direct WhatsApp & consultation."
  schema={contactSchema}
>
  <div class="page-header section-py text-center">
    <div class="container">
      <div class="gold-pill">BESPOKE DISCOVERY & RESERVATIONS</div>
      <h1 class="page-title">Check Date & Request Custom Quote</h1>
      <div class="gold-divider"></div>
      <p class="page-subtitle">
        We limit our studio to a strictly curated number of commissions each month. Fill in your details below to instantly check date availability and receive a customized fine-art proposal directly on WhatsApp or Email.
      </p>
    </div>
  </div>

  <section class="contact-main-section section-py">
    <div class="container contact-container">
      <!-- Concierge Details Bar -->
      <div class="concierge-grid">
        <div class="concierge-card glass-card">
          <span class="concierge-icon">📞</span>
          <h3>Direct Studio Line</h3>
          <p>For urgent date confirmation and inquiries</p>
          <a href={`tel:${(settings.primaryPhone || '+91-7892706982').replace(/[^0-9+]/g, '')}`} class="concierge-link">
            {settings.primaryPhone || '+91-7892706982'}
          </a>
        </div>

        <div class="concierge-card glass-card">
          <span class="concierge-icon">💬</span>
          <h3>Instant WhatsApp</h3>
          <p>Chat directly with lead photographer Hithu</p>
          <a href={`https://wa.me/${(settings.whatsappConcierge || '917892706982').replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hello Hithu, I would like to check availability for our ceremony.')}`} target="_blank" rel="noopener noreferrer" class="concierge-link whatsapp-link">
            Open WhatsApp Chat →
          </a>
        </div>

        <div class="concierge-card glass-card">
          <span class="concierge-icon">📍</span>
          <h3>Studio & Hub</h3>
          <p>{settings.streetAddress || 'Sadashivanagar & Palace Grounds Road'}</p>
          <span class="concierge-meta">{settings.city || 'Bengaluru'}, {settings.state || 'Karnataka'} {settings.postalCode || '560080'}</span>
          {settings.googleMapsUrl?.trim() && (
            <a href={settings.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="concierge-link map-link">
              View on Google Maps ↗
            </a>
          )}
        </div>

        <div class="concierge-card glass-card">
          <span class="concierge-icon">⏰</span>
          <h3>Consultation Hours</h3>
          <p>Monday through Sunday</p>
          <span class="concierge-meta">08:00 AM – 09:00 PM IST</span>
        </div>
      </div>

      <!-- Innovative Social Portfolios Showcase -->
      {hasSocials && (
        <div class="contact-social-showcase glass-card">
          <div class="social-showcase-header">
            <div>
              <span class="social-kicker">✦ OFFICIAL CHANNELS & ARCHIVES</span>
              <h2 class="social-heading">Follow & Verify Studio Portfolios</h2>
              <p class="social-subheading">
                Direct high-resolution film previews, behind-the-scenes Muhurtham stories & curated aesthetic boards.
              </p>
            </div>
            <div class="verified-badge">
              <span class="shield-dot"></span>
              <span>Verified Official Presence</span>
            </div>
          </div>

          <div class="social-cards-grid">
            {settings.instagramUrl?.trim() && (
              <a href={settings.instagramUrl} target="_blank" rel="noopener noreferrer" class="social-channel-card instagram-card" aria-label="Visit Instagram">
                <div class="card-glow-bg"></div>
                <div class="channel-icon-wrap instagram-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </div>
                <div class="channel-info">
                  <div class="channel-title-row">
                    <span class="channel-name">Instagram</span>
                    <span class="channel-arrow">↗</span>
                  </div>
                  <span class="channel-handle">{settings.instagramHandle || '@framesbyhithu'}</span>
                  <span class="channel-desc">Daily Muhurtham Reels & Visual Stories</span>
                </div>
              </a>
            )}

            {settings.youtubeUrl?.trim() && (
              <a href={settings.youtubeUrl} target="_blank" rel="noopener noreferrer" class="social-channel-card youtube-card" aria-label="Visit YouTube Channel">
                <div class="card-glow-bg"></div>
                <div class="channel-icon-wrap youtube-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                </div>
                <div class="channel-info">
                  <div class="channel-title-row">
                    <span class="channel-name">YouTube</span>
                    <span class="channel-arrow">↗</span>
                  </div>
                  <span class="channel-handle">Cinema Films</span>
                  <span class="channel-desc">4K UHD Documentaries & Teasers</span>
                </div>
              </a>
            )}

            {settings.pinterestUrl?.trim() && (
              <a href={settings.pinterestUrl} target="_blank" rel="noopener noreferrer" class="social-channel-card pinterest-card" aria-label="Visit Pinterest Boards">
                <div class="card-glow-bg"></div>
                <div class="channel-icon-wrap pinterest-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
                  </svg>
                </div>
                <div class="channel-info">
                  <div class="channel-title-row">
                    <span class="channel-name">Pinterest</span>
                    <span class="channel-arrow">↗</span>
                  </div>
                  <span class="channel-handle">Fine-Art Boards</span>
                  <span class="channel-desc">Bridal Styling & Decor Moodboards</span>
                </div>
              </a>
            )}

            {settings.facebookUrl?.trim() && (
              <a href={settings.facebookUrl} target="_blank" rel="noopener noreferrer" class="social-channel-card facebook-card" aria-label="Visit Facebook Page">
                <div class="card-glow-bg"></div>
                <div class="channel-icon-wrap facebook-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </div>
                <div class="channel-info">
                  <div class="channel-title-row">
                    <span class="channel-name">Facebook</span>
                    <span class="channel-arrow">↗</span>
                  </div>
                  <span class="channel-handle">Studio Community</span>
                  <span class="channel-desc">Family Testimonials & Updates</span>
                </div>
              </a>
            )}
          </div>
        </div>
      )}

      <!-- Embedded Bespoke Inquiry Funnel -->
      <div class="form-wrapper" id="inquiry-form">
        <BespokeInquiryModal />
      </div>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <FaqAccordion />

  <script>
    function checkContactHashScroll() {
      const hash = window.location.hash || '';
      if (hash.startsWith('#inquiry-form') || hash.startsWith('#inquire')) {
        const target = document.getElementById('inquiry-form');
        if (target) {
          const scrollToForm = () => {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          };
          setTimeout(scrollToForm, 100);
          setTimeout(scrollToForm, 450);
        }
      }
    }

    checkContactHashScroll();
    window.addEventListener('hashchange', checkContactHashScroll);
    document.addEventListener('astro:page-load', checkContactHashScroll);
  </script>
</Layout>

<style>
  .text-center {
    text-align: center;
  }

  .page-header {
    background: radial-gradient(ellipse at top, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
    padding-bottom: 2rem;
  }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    margin-top: 1rem;
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .contact-container {
    max-width: 1040px;
  }

  .form-wrapper {
    scroll-margin-top: 110px;
  }

  .concierge-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .concierge-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .concierge-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .concierge-card {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .concierge-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .concierge-card h3 {
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .concierge-card p {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .concierge-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--gold-light);
    margin-top: auto;
  }

  .concierge-link:hover {
    color: var(--gold-primary);
    text-decoration: underline;
  }

  .whatsapp-link {
    color: var(--whatsapp-emerald);
  }

  .map-link {
    color: var(--gold-primary);
    font-size: 0.825rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .concierge-meta {
    font-size: 0.825rem;
    color: var(--text-dim);
    margin-top: auto;
  }

  /* Innovative Social Portfolios Showcase */
  .contact-social-showcase {
    padding: 2rem 2.25rem;
    margin-bottom: 2.75rem;
    border: 1px solid rgba(212, 175, 55, 0.25);
    background: linear-gradient(135deg, rgba(20, 22, 30, 0.8) 0%, rgba(12, 14, 20, 0.95) 100%);
    border-radius: 16px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .social-showcase-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
  }

  .social-kicker {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-gold);
    display: block;
    margin-bottom: 0.35rem;
  }

  .social-heading {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    color: #FFFFFF;
    margin: 0 0 0.35rem 0;
  }

  .social-subheading {
    font-size: 0.85rem;
    color: #9CA3AF;
    margin: 0;
  }

  .verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: rgba(37, 211, 102, 0.1);
    border: 1px solid rgba(37, 211, 102, 0.3);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #25D366;
    letter-spacing: 0.02em;
    user-select: none;
  }

  .shield-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #25D366;
    box-shadow: 0 0 8px #25D366;
  }

  .social-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.15rem;
  }

  .social-channel-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.35rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-glow-bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .channel-icon-wrap {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    transition: transform 0.35s ease;
    position: relative;
    z-index: 1;
  }

  /* Specific Platform Treatments */
  .instagram-card .card-glow-bg {
    background: radial-gradient(circle at top left, rgba(225, 48, 108, 0.25) 0%, transparent 70%);
  }
  .instagram-icon {
    background: linear-gradient(135deg, #833AB4 0%, #FD1D1D 50%, #FCB045 100%);
    color: #FFFFFF;
    box-shadow: 0 4px 15px rgba(225, 48, 108, 0.35);
  }
  .instagram-card:hover {
    border-color: rgba(225, 48, 108, 0.6);
    box-shadow: 0 10px 25px rgba(225, 48, 108, 0.2);
  }

  .youtube-card .card-glow-bg {
    background: radial-gradient(circle at top left, rgba(255, 0, 0, 0.25) 0%, transparent 70%);
  }
  .youtube-icon {
    background: linear-gradient(135deg, #E60000 0%, #990000 100%);
    color: #FFFFFF;
    box-shadow: 0 4px 15px rgba(255, 0, 0, 0.35);
  }
  .youtube-card:hover {
    border-color: rgba(255, 0, 0, 0.6);
    box-shadow: 0 10px 25px rgba(255, 0, 0, 0.2);
  }

  .pinterest-card .card-glow-bg {
    background: radial-gradient(circle at top left, rgba(230, 0, 35, 0.25) 0%, transparent 70%);
  }
  .pinterest-icon {
    background: linear-gradient(135deg, #E60023 0%, #A30018 100%);
    color: #FFFFFF;
    box-shadow: 0 4px 15px rgba(230, 0, 35, 0.35);
  }
  .pinterest-card:hover {
    border-color: rgba(230, 0, 35, 0.6);
    box-shadow: 0 10px 25px rgba(230, 0, 35, 0.2);
  }

  .facebook-card .card-glow-bg {
    background: radial-gradient(circle at top left, rgba(24, 119, 242, 0.25) 0%, transparent 70%);
  }
  .facebook-icon {
    background: linear-gradient(135deg, #1877F2 0%, #0D50A8 100%);
    color: #FFFFFF;
    box-shadow: 0 4px 15px rgba(24, 119, 242, 0.35);
  }
  .facebook-card:hover {
    border-color: rgba(24, 119, 242, 0.6);
    box-shadow: 0 10px 25px rgba(24, 119, 242, 0.2);
  }

  .social-channel-card:hover {
    transform: translateY(-4px);
  }

  .social-channel-card:hover .card-glow-bg {
    opacity: 1;
  }

  .social-channel-card:hover .channel-icon-wrap {
    transform: scale(1.08);
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }

  .channel-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .channel-name {
    font-size: 1rem;
    font-weight: 600;
    color: #FFFFFF;
  }

  .channel-arrow {
    font-size: 0.85rem;
    color: var(--text-gold);
    transition: transform 0.25s ease;
  }

  .social-channel-card:hover .channel-arrow {
    transform: translate(3px, -3px);
  }

  .channel-handle {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-gold);
    margin-bottom: 0.35rem;
  }

  .channel-desc {
    font-size: 0.75rem;
    color: #9CA3AF;
    line-height: 1.4;
  }

  @media (max-width: 992px) {
    .social-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .social-cards-grid {
      grid-template-columns: 1fr;
    }
    .social-showcase-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .form-wrapper {
    margin-bottom: 2rem;
    scroll-margin-top: 110px;
  }
</style>
