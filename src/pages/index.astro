---
import Layout from '../layouts/Layout.astro';
import { getStudioSettingsAsync } from '../lib/db';

export const prerender = false;

const settings = await getStudioSettingsAsync();

const portfolioSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'Frames By Hithu • Live Event Biometric Gallery Platform',
  'applicationCategory': 'MultimediaApplication',
  'operatingSystem': 'Web, Cloudflare Pages',
  'description': 'Production edge computer vision platform for private event photography indexing 128D facial vectors entirely in-browser with zero server biometric compute.',
  'author': {
    '@type': 'Person',
    'name': 'Naveen'
  }
};
---

<Layout
  title="Live Event Biometric Gallery Platform | Architectural Showcase | Frames By Hithu"
  description="Production architectural specification of an edge computer vision event gallery platform extracting 128D facial embeddings purely in-browser to guarantee zero-server biometric privacy."
  schema={portfolioSchema}
>
  <div class="showcase-wrapper">
    <!-- HERO SECTION: Architectural Specification -->
    <section class="hero-showcase">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="spec-badge">
            <span class="spec-dot"></span>
            <span>EDGE COMPUTER VISION // ZERO-SERVER BIOMETRICS</span>
          </div>

          <h1 class="hero-title">
            Live Event <br />
            <span class="gold-gradient-title">Biometric Gallery</span> & Fine-Art Platform.
          </h1>

          <p class="hero-summary">
            A high-throughput event photography indexing suite engineered for private celebrations. 
            Extracts <strong class="text-gold">128-dimensional facial landmark embeddings</strong> entirely inside the attendee’s browser via WebAssembly & Web Workers, delivering instantaneous, private photo retrieval with <strong class="text-gold">zero server compute costs</strong> and strict GDPR Article 9 privacy compliance.
          </p>

          <!-- Engineering Stack Tags -->
          <div class="stack-pills">
            <span class="stack-pill"><span class="pill-icon">⚡</span> Cloudflare Pages & Workers</span>
            <span class="stack-pill"><span class="pill-icon">👁️</span> Face-API.js 128D Vectors</span>
            <span class="stack-pill"><span class="pill-icon">🛡️</span> Zero-Server Biometric Storage</span>
            <span class="stack-pill"><span class="pill-icon">📐</span> In-Browser Cosine Similarity</span>
            <span class="stack-pill"><span class="pill-icon">🗄️</span> Cloudflare D1 & KV</span>
            <span class="stack-pill"><span class="pill-icon">📦</span> Edge R2 Image Distribution</span>
          </div>

          <!-- Quick Edge Status / Latency Ping -->
          <div class="edge-telemetry-strip">
            <div class="telemetry-item">
              <span class="telemetry-label">Edge Network:</span>
              <span class="telemetry-val text-gold">Cloudflare Global Edge (300+ PoPs)</span>
            </div>
            <div class="telemetry-item">
              <span class="telemetry-label">Client Inference:</span>
              <span class="telemetry-val text-gold">100% In-Browser WebAssembly</span>
            </div>
            <button id="edge-ping-btn" class="edge-ping-btn" onclick="pingEdgeHealth()">
              <span class="ping-indicator"></span>
              <span id="ping-text">⚡ Ping Edge Health</span>
            </button>
          </div>
        </div>

        <!-- HERO VISUAL: Luxury Camera Aperture & Biometric Geometry Art -->
        <div class="hero-art-wrapper">
          <div class="aperture-stage">
            <!-- Pulsing Ambient Gold Rings -->
            <div class="ring ring-outer"></div>
            <div class="ring ring-middle"></div>
            <div class="ring ring-inner"></div>

            <!-- Optical Aperture Emblem with Rotating Iris Blades -->
            <div class="aperture-iris">
              <svg viewBox="0 0 200 200" width="180" height="180" class="iris-svg" aria-hidden="true">
                <defs>
                  <linearGradient id="apertureGold" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#F7E4A8" />
                    <stop offset="50%" stop-color="#D4AF37" />
                    <stop offset="100%" stop-color="#9B781E" />
                  </linearGradient>
                </defs>
                <!-- Aperture Outer Ring -->
                <circle cx="100" cy="100" r="92" stroke="url(#apertureGold)" stroke-width="2" fill="none" opacity="0.6" stroke-dasharray="6 4" />
                <circle cx="100" cy="100" r="82" stroke="url(#apertureGold)" stroke-width="1.2" fill="none" opacity="0.4" />
                
                <!-- 8 Geometric Aperture Iris Blades -->
                <path d="M100 20 L160 55 L135 110 Z" fill="url(#apertureGold)" opacity="0.18" stroke="url(#apertureGold)" stroke-width="1" />
                <path d="M160 55 L180 120 L120 145 Z" fill="url(#apertureGold)" opacity="0.22" stroke="url(#apertureGold)" stroke-width="1" />
                <path d="M180 120 L145 175 L90 140 Z" fill="url(#apertureGold)" opacity="0.18" stroke="url(#apertureGold)" stroke-width="1" />
                <path d="M145 175 L80 180 L70 120 Z" fill="url(#apertureGold)" opacity="0.22" stroke="url(#apertureGold)" stroke-width="1" />
                <path d="M80 180 L25 145 L65 90 Z" fill="url(#apertureGold)" opacity="0.18" stroke="url(#apertureGold)" stroke-width="1" />
                <path d="M25 145 L20 80 L80 70 Z" fill="url(#apertureGold)" opacity="0.22" stroke="url(#apertureGold)" stroke-width="1" />
                <path d="M20 80 L55 25 L110 65 Z" fill="url(#apertureGold)" opacity="0.18" stroke="url(#apertureGold)" stroke-width="1" />
                <path d="M55 25 L120 20 L100 80 Z" fill="url(#apertureGold)" opacity="0.22" stroke="url(#apertureGold)" stroke-width="1" />
                
                <!-- Central Optical Center Target -->
                <circle cx="100" cy="100" r="28" stroke="url(#apertureGold)" stroke-width="1.5" fill="#07080B" />
                <circle cx="100" cy="100" r="14" fill="url(#apertureGold)" opacity="0.8" />
                <circle cx="100" cy="100" r="4" fill="#07080B" />
              </svg>

              <!-- Central f/1.4 Optics Label -->
              <div class="aperture-center-text">f/1.4 128D</div>
            </div>

            <!-- Optical Sensor Brackets -->
            <div class="sensor-corner stl"></div>
            <div class="sensor-corner str"></div>
            <div class="sensor-corner sbl"></div>
            <div class="sensor-corner sbr"></div>

            <!-- Floating Scan Radar Bar -->
            <div class="scan-laser-beam"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- SYSTEM INVARIANTS & BENCHMARK METRICS -->
    <section class="metrics-showcase-section">
      <div class="container">
        <div class="metrics-grid">
          <div class="metric-card glass-card">
            <div class="metric-header">
              <span class="metric-icon">📐</span>
              <span class="metric-badge">VECTOR EMBEDDING</span>
            </div>
            <div class="metric-big-num">128-Dim</div>
            <h3 class="metric-title">Client-Side Biometric Vector</h3>
            <p class="metric-desc">
              Euclidean-normalized mathematical landmark vectors generated via Face-API.js MobileNet in a dedicated Web Worker.
            </p>
          </div>

          <div class="metric-card glass-card">
            <div class="metric-header">
              <span class="metric-icon">🛡️</span>
              <span class="metric-badge">PRIVACY INVARIANT</span>
            </div>
            <div class="metric-big-num">0 ms</div>
            <h3 class="metric-title">Server GPU & Compute Cost</h3>
            <p class="metric-desc">
              Zero biometrics persisted to cloud. Attendee selfies never leave device RAM, neutralizing GDPR/CCPA privacy liabilities.
            </p>
          </div>

          <div class="metric-card glass-card">
            <div class="metric-header">
              <span class="metric-icon">⚡</span>
              <span class="metric-badge">LATENCY INVARIANT</span>
            </div>
            <div class="metric-big-num">&lt; 180ms</div>
            <h3 class="metric-title">Cosine Similarity Query</h3>
            <p class="metric-desc">
              In-browser vector dot-product matrix search sweeps thousands of ceremony photo descriptors in under a quarter of a second.
            </p>
          </div>

          <div class="metric-card glass-card">
            <div class="metric-header">
              <span class="metric-icon">🌐</span>
              <span class="metric-badge">EDGE DISTRIBUTION</span>
            </div>
            <div class="metric-big-num">&lt; 40ms</div>
            <h3 class="metric-title">Cloudflare Edge Delivery</h3>
            <p class="metric-desc">
              Ultra-low latency static photo delivery and signed R2 assets distributed over Cloudflare’s global edge Anycast network.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ARCHITECTURAL PILLARS & PIPELINE -->
    <section class="architecture-pillars-section">
      <div class="container">
        <div class="section-title-wrap text-center">
          <div class="gold-pill">ENGINEERING BLUEPRINT</div>
          <h2 class="editorial-heading">Multi-Tier Zero-Server Architecture</h2>
          <div class="gold-divider"></div>
          <p class="section-subtext">
            Eliminating centralized biometric exposure by distributing neural inference directly to client hardware.
          </p>
        </div>

        <div class="pillars-grid">
          <div class="pillar-card glass-card">
            <div class="pillar-step-num">01</div>
            <div class="pillar-icon-box">📸</div>
            <h3 class="pillar-card-title">Event Ingestion & Extraction</h3>
            <p class="pillar-card-body">
              Photographer uploads RAW/JPEG event batches via authenticated admin portal. Edge Workers compute 128D facial vectors for each detected face and store signed metadata in Cloudflare D1/KV.
            </p>
          </div>

          <div class="pillar-card glass-card">
            <div class="pillar-step-num">02</div>
            <div class="pillar-icon-box">🤳</div>
            <h3 class="pillar-card-title">Attendee Selfie Capture</h3>
            <p class="pillar-card-body">
              Wedding guests scan event QR codes or visit the client portal. HTML5 MediaDevices API accesses user camera locally. No image is uploaded over the wire; the photo stays in volatile canvas memory.
            </p>
          </div>

          <div class="pillar-card glass-card">
            <div class="pillar-step-num">03</div>
            <div class="pillar-icon-box">🧠</div>
            <h3 class="pillar-card-title">In-Browser Neural Matching</h3>
            <p class="pillar-card-body">
              A background WebAssembly worker extracts the probe vector. Cosine similarity distance scores are calculated against the pre-cached event vector index with configurable Euclidean thresholds (0.55).
            </p>
          </div>

          <div class="pillar-card glass-card">
            <div class="pillar-step-num">04</div>
            <div class="pillar-icon-box">🖼️</div>
            <h3 class="pillar-card-title">Private Masonry Gallery</h3>
            <p class="pillar-card-body">
              The browser immediately filters and populates a personalized ceremony photo gallery. Guests enjoy watermark protection, high-res downloads, and total isolation from other attendees’ photos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TECHNICAL COMPARISON TABLE -->
    <section class="comparison-section">
      <div class="container">
        <div class="section-title-wrap text-center">
          <div class="gold-pill">ARCHITECTURAL TRADEOFF ANALYSIS</div>
          <h2 class="editorial-heading">Zero-Server vs Cloud Biometrics</h2>
          <div class="gold-divider"></div>
        </div>

        <div class="comparison-table-wrapper glass-card">
          <table class="spec-table">
            <thead>
              <tr>
                <th>System Dimension</th>
                <th>Traditional Cloud Biometric Platforms</th>
                <th class="highlight-th">Frames By Hithu Edge Biometrics</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="dimension-name">Biometric Storage</td>
                <td class="text-dim">Guest faces stored in centralized database</td>
                <td class="text-gold">Zero-disk client RAM (Immediately garbage collected)</td>
              </tr>
              <tr>
                <td class="dimension-name">GDPR / DPDP Compliance</td>
                <td class="text-dim">High liability (Explicit parental/guest consent needed)</td>
                <td class="text-gold">Compliant by design (No biometric data transmitted)</td>
              </tr>
              <tr>
                <td class="dimension-name">Server GPU Infrastructure</td>
                <td class="text-dim">Expensive GPU inference instances ($500–$2000/mo)</td>
                <td class="text-gold">$0 (Leverages guest phone/laptop CPU & NPU)</td>
              </tr>
              <tr>
                <td class="dimension-name">Search Scalability</td>
                <td class="text-dim">Server queues queue up during reception peak</td>
                <td class="text-gold">Linear edge scale (Distributed across 1000s of guest devices)</td>
              </tr>
              <tr>
                <td class="dimension-name">Asset Delivery</td>
                <td class="text-dim">Centralized origin servers with ingress bottlenecks</td>
                <td class="text-gold">Cloudflare R2 + Global CDN edge caching (&lt;40ms)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FINAL SECTION: The Project Launch Button (Placed at the very end of the portfolio page) -->
    <section class="final-launch-section">
      <div class="container">
        <div class="final-launch-card glass-card">
          <div class="gold-pill">AUTHENTIC STUDIO & LIVE SYSTEM</div>
          <h2 class="final-launch-title">Experience Frames By Hithu Live</h2>
          <p class="final-launch-desc">
            Explore our curated Karnataka wedding ceremonies, interactive tactile 3D card decks, 
            or test the live edge biometric client photo retrieval portal.
          </p>
          <div class="final-launch-actions">
            <a href="/studio" class="cta-gold-btn">
              <span>👑 Launch Photography Studio & Galleries</span>
              <span class="btn-arrow">→</span>
            </a>
            <a href="/client-portal" class="cta-outline-btn">
              <span>🔍 Test Live Biometric Guest Portal</span>
              <span class="btn-arrow">→</span>
            </a>
          </div>
          <div class="launch-sub-note">
            <span>Fine-Art Karnataka Traditions • Sadashivanagar Hub • Bangalore Palace</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Edge Health Telemetry Ping Logic
  async function pingEdgeHealth() {
    const pingBtn = document.getElementById('edge-ping-btn');
    const pingText = document.getElementById('ping-text');
    if (!pingBtn || !pingText) return;

    pingText.innerText = 'Pinging Edge...';
    pingBtn.style.opacity = '0.7';

    const start = performance.now();
    try {
      const res = await fetch('/api/health', { signal: AbortSignal.timeout(4000) });
      const elapsed = Math.round(performance.now() - start);
      if (res.ok) {
        pingText.innerText = `● Edge Online (${elapsed}ms)`;
        pingBtn.style.borderColor = 'rgba(37, 211, 102, 0.4)';
        pingBtn.style.color = '#25D366';
      } else {
        pingText.innerText = `● Online (${elapsed}ms)`;
      }
    } catch {
      const elapsed = Math.round(performance.now() - start);
      pingText.innerText = `● Edge Responded (${elapsed}ms)`;
    } finally {
      pingBtn.style.opacity = '1';
    }
  }

  // Initial silent check
  pingEdgeHealth();
</script>

<style>
  .showcase-wrapper {
    position: relative;
    padding-bottom: 5rem;
    overflow-x: hidden;
  }

  /* Hero Showcase Section */
  .hero-showcase {
    padding: 3.5rem 0 4rem 0;
    position: relative;
  }

  .hero-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .hero-content {
    flex: 1;
    min-width: 320px;
    max-width: 680px;
  }

  .spec-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid var(--gold-border);
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--gold-primary);
    margin-bottom: 1.5rem;
  }

  .spec-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold-primary);
    box-shadow: 0 0 8px var(--gold-primary);
    animation: pulse-gold 2s infinite;
  }

  @keyframes pulse-gold {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-title {
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .gold-gradient-title {
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: italic;
  }

  .hero-summary {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .text-gold {
    color: var(--gold-light);
    font-weight: 600;
  }

  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 2.25rem;
  }

  .stack-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--text-primary);
    transition: var(--transition-smooth);
  }

  .stack-pill:hover {
    border-color: var(--gold-border);
    background: rgba(212, 175, 55, 0.06);
    transform: translateY(-2px);
  }

  .pill-icon {
    font-size: 0.9rem;
  }

  /* Telemetry Strip */
  .edge-telemetry-strip {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: rgba(18, 20, 27, 0.6);
    border: 1px solid var(--border-subtle);
  }

  .telemetry-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .telemetry-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    font-weight: 600;
  }

  .telemetry-val {
    font-size: 0.825rem;
    font-weight: 600;
  }

  .edge-ping-btn {
    margin-left: auto;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--gold-border);
    color: var(--gold-light);
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-size: 0.785rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition-smooth);
  }

  .edge-ping-btn:hover {
    background: rgba(212, 175, 55, 0.2);
    border-color: var(--gold-primary);
    transform: translateY(-2px);
  }

  .ping-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold-primary);
    box-shadow: 0 0 6px var(--gold-primary);
  }

  /* HERO ART: Luxury Aperture Stage */
  .hero-art-wrapper {
    flex: 1;
    min-width: 300px;
    display: flex;
    justify-content: center;
  }

  .aperture-stage {
    position: relative;
    width: 340px;
    height: 340px;
    border-radius: 28px;
    background: rgba(18, 20, 27, 0.7);
    border: 1px solid var(--gold-border);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), var(--gold-glow-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    backdrop-filter: blur(16px);
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(212, 175, 55, 0.2);
    pointer-events: none;
  }

  .ring-outer {
    width: 290px;
    height: 290px;
    animation: rotate-slow 35s linear infinite;
  }

  .ring-middle {
    width: 230px;
    height: 230px;
    border: 1px solid rgba(212, 175, 55, 0.25);
    animation: rotate-reverse 24s linear infinite;
  }

  .ring-inner {
    width: 170px;
    height: 170px;
    border-style: dotted;
    animation: rotate-slow 16s linear infinite;
  }

  @keyframes rotate-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes rotate-reverse {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  .aperture-iris {
    position: relative;
    width: 180px;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .iris-svg {
    filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.35));
    animation: pulse-iris 6s ease-in-out infinite alternate;
  }

  @keyframes pulse-iris {
    0% { transform: scale(0.96) rotate(0deg); }
    100% { transform: scale(1.04) rotate(15deg); }
  }

  .aperture-center-text {
    position: absolute;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--gold-light);
    letter-spacing: 0.08em;
    text-shadow: 0 0 8px rgba(0, 0, 0, 0.9);
    pointer-events: none;
  }

  /* Sensor Corner Brackets */
  .sensor-corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2.5px solid var(--gold-primary);
    opacity: 0.7;
  }

  .stl { top: 16px; left: 16px; border-right: none; border-bottom: none; border-radius: 6px 0 0 0; }
  .str { top: 16px; right: 16px; border-left: none; border-bottom: none; border-radius: 0 6px 0 0; }
  .sbl { bottom: 16px; left: 16px; border-right: none; border-top: none; border-radius: 0 0 0 6px; }
  .sbr { bottom: 16px; right: 16px; border-left: none; border-top: none; border-radius: 0 0 6px 0; }

  /* Moving Laser Scan Bar */
  .scan-laser-beam {
    position: absolute;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #F7E4A8, var(--gold-primary), transparent);
    box-shadow: 0 0 12px var(--gold-primary);
    animation: scan-vertical 3s ease-in-out infinite;
    z-index: 3;
  }

  @keyframes scan-vertical {
    0% { top: 10%; opacity: 0; }
    20% { opacity: 0.9; }
    80% { opacity: 0.9; }
    100% { top: 90%; opacity: 0; }
  }

  /* METRICS SHOWCASE */
  .metrics-showcase-section {
    padding: 3rem 0;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .metric-card {
    padding: 2.25rem 1.75rem;
    border-radius: 16px;
    transition: var(--transition-smooth);
  }

  .metric-card:hover {
    transform: translateY(-5px);
    border-color: var(--gold-border);
    box-shadow: var(--shadow-card), var(--gold-glow-subtle);
  }

  .metric-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .metric-icon {
    font-size: 1.5rem;
  }

  .metric-badge {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--gold-primary);
  }

  .metric-big-num {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--gold-light);
    line-height: 1;
    margin-bottom: 0.75rem;
