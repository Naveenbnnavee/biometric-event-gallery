---
import Layout from '../../layouts/Layout.astro';
import { getLiveEventBySlugAsync, getStudioSettingsAsync } from '../../lib/db';
import { getCloudflareEnv } from '../../lib/cloudflare';

export const prerender = false;

const env = await getCloudflareEnv();
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

const event = await getLiveEventBySlugAsync(slug, env);
if (!event) {
  return Astro.redirect('/404');
}

const settings = await getStudioSettingsAsync();
const whatsappClean = (settings.whatsappConcierge || settings.primaryPhone || '917892706982').replace(/[^0-9]/g, '');

const inquiryMessage = encodeURIComponent(
  `Hello Frames By Hithu, I am at the "${event.title}" live gallery and was captivated by your photography. I would love to check availability for our family's upcoming ceremony!`
);
const whatsappInquiryUrl = `https://wa.me/${whatsappClean}?text=${inquiryMessage}`;

const livePhotos = event.photos || [];

const isFaceOnly = event.accessMode === 'face_only';
const isFaceAndAll = event.accessMode === 'face_and_all' || event.accessMode === 'face_match';
const isFaceMatchMode = isFaceOnly || isFaceAndAll;
const isOpenGallery = event.accessMode === 'open_gallery';
---

<Layout
  title={`${event.title} • Live Guest Gallery | Frames By Hithu`}
  description={`Live real-time ceremony photo stream from ${event.title} at ${event.venue}. Discovered live with Frames By Hithu Fine-Art Photography.`}
  image={livePhotos[0]?.url || 'https://upload.wikimedia.org/wikipedia/commons/thumb/2/2a/Lalitha_Mahal_Palace_Hotel.jpg/1280px-Lalitha_Mahal_Palace_Hotel.jpg'}
>
  <div
    class="live-gallery-wrapper"
    id="live-gallery-wrapper"
    data-event-id={event.id}
    data-event-slug={event.slug}
    data-access-mode={event.accessMode}
    data-allow-download={event.allowDownload ? 'true' : 'false'}
    data-watermark={event.watermarkPreview ? 'true' : 'false'}
  >
    <!-- Live Header Section -->
    <header class="live-header text-center">
      <div class="container">
        <div class="header-brand-line">
          <div class="studio-emblem" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="26" height="26" fill="none">
              <rect width="32" height="32" rx="7" fill="url(#streamGoldGrad)" />
              <circle cx="16" cy="16" r="11" stroke="#07080B" stroke-width="1" stroke-opacity="0.35" stroke-dasharray="2.5 2" />
              <text x="50%" y="54%" text-anchor="middle" dominant-baseline="middle" fill="#07080B" font-family="'Cormorant Garamond', Georgia, serif" font-weight="700" font-size="13" letter-spacing="0.5">FH</text>
              <defs>
                <linearGradient id="streamGoldGrad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#F7E4A8" />
                  <stop offset="0.5" stop-color="#D4AF37" />
                  <stop offset="1" stop-color="#9B781E" />
                </linearGradient>
              </defs>
            </svg>
          </div>
          <span class="studio-name">FRAMES BY HITHU</span>
        </div>

        <div class="live-status-pill">
          <span class="live-status-dot"></span>
          <span class="live-status-text">LIVE EVENT STREAM</span>
          <span class="live-time-ago" id="live-time-ago">• Updated moments ago</span>
        </div>

        <h1 class="live-event-title">{event.title}</h1>
        <div class="gold-divider"></div>
        <p class="live-event-sub">
          <span>📍 {event.venue}</span>
          <span class="divider-dot">•</span>
          <span>📅 {event.date}</span>
        </p>

        <!-- Mode 1: AI Face-Match Onboarding Hero Card -->
        {isFaceMatchMode && (
          <div class="face-onboarding-card glass-card" id="face-onboarding-card">
            <div class="onboard-icon">✨</div>
            <h2 class="onboard-title">Find Your Moments in Seconds</h2>
            <p class="onboard-desc">
              Take a quick selfie to instantly discover every photograph you appear in across the ceremony.
            </p>

            <div class="onboard-actions">
              <button type="button" class="btn-gold selfie-btn" id="take-selfie-btn">
                <span class="cam-icon">📸</span>
                <span>Take Quick Selfie</span>
              </button>
              <!-- Hidden fallback file input for mobile Safari/Android camera -->
              <input
                type="file"
                id="camera-fallback-input"
                accept="image/*"
                capture="user"
                style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; opacity: 0; pointer-events: none;"
              />
            </div>

            <!-- Face Match Status Banner (shown after selfie) -->
            <div id="face-match-status-banner" class="match-status-banner" style="display: none;">
              <div class="selfie-avatar-wrap">
                <img id="guest-selfie-preview" src="" alt="Guest Selfie" class="selfie-avatar" />
                <span class="match-check">✓</span>
              </div>
              <div class="match-text-info">
                <strong id="match-headline">AI Face Matching Active</strong>
                <p id="match-subline">Scanning ceremony frames...</p>
                <div id="match-progress-wrap" class="match-progress-container" style="display: none;">
                  <div class="match-progress-bar">
                    <div id="match-progress-fill" class="match-progress-fill"></div>
                  </div>
                  <span id="match-progress-label" class="match-progress-label">0%</span>
                </div>
              </div>
              <button type="button" class="retake-selfie-btn" id="retake-selfie-btn" title="Retake Selfie">
                🔄 Retake
              </button>
            </div>
          </div>
        )}

        <!-- Filter & View Switcher (Only For Face + All Hybrid Mode) -->
        {isFaceAndAll && (
          <div class="view-switcher-bar" id="view-switcher-bar" style="display: none;">
            <button type="button" class="switcher-btn active" id="btn-show-matched">
              <span>✨ My Matched Frames</span>
              <span class="badge" id="matched-count-badge">0</span>
            </button>
            <button type="button" class="switcher-btn" id="btn-show-all">
              <span>🌐 All Ceremony Frames</span>
              <span class="badge" id="all-count-badge">{livePhotos.length}</span>
            </button>
          </div>
        )}

        <!-- Real-Time Incoming Notification Banner -->
        <div id="incoming-photos-banner" class="incoming-alert" style="display: none;">
          <span class="incoming-dot"></span>
          <span id="incoming-text">New ceremony photos just beamed live!</span>
          <button type="button" id="incoming-view-btn" class="incoming-btn">View Latest ↑</button>
        </div>
      </div>
    </header>

    <!-- Main Live Masonry Gallery Stream -->
    <main class="gallery-main-container">
      <div class="container">
        <!-- Empty State (No Photos In Stream) -->
        <div id="no-photos-found" class="empty-gallery-state text-center" style={livePhotos.length === 0 ? "display: block;" : "display: none;"}>
          <div class="empty-art">📷</div>
          <h3>Sacred Rituals Commencing</h3>
          <p>The photographer is framing live ceremonies. As photos are captured, they will stream automatically onto this screen.</p>
        </div>

        <!-- Face Match Empty State (Strict 0-matches State) -->
        <div id="no-match-found" class="empty-gallery-state text-center" style="display: none;">
          <div class="empty-art">✨</div>
          <h3 class="no-match-title">No matching frames found yet</h3>
          <p class="no-match-desc">
            As the photographer captures more moments of you, they will appear here automatically.
          </p>
          {isFaceAndAll && (
            <div class="no-match-actions">
              <button type="button" class="empty-switch-all-btn" id="empty-show-all-btn">
                <span>View All Ceremony Frames ({livePhotos.length})</span>
              </button>
            </div>
          )}
        </div>

        <!-- Face Match Initial Gate (Before selfie is taken) -->
        {isFaceMatchMode && (
          <div id="face-match-gate" class="empty-gallery-state text-center" style={livePhotos.length > 0 ? "display: block;" : "display: none;"}>
            <div class="empty-art">🔐</div>
            <h3 class="gate-title">Private AI Face-Match Stream</h3>
            <p class="gate-desc">
              Your personalized ceremony moments will appear here once you take a quick selfie.
            </p>
            <div class="gate-actions">
              <button type="button" class="btn-gold gate-selfie-btn" id="gate-take-selfie-btn">
                <span>📸 Take Quick Selfie</span>
              </button>
              {isFaceAndAll && (
                <button type="button" class="gate-browse-all-btn" id="gate-browse-all-btn">
                  <span>Or browse all ceremony frames ({livePhotos.length}) →</span>
                </button>
              )}
            </div>
          </div>
        )}

        <!-- Masonry Grid -->
        <div class="live-masonry-grid" id="live-masonry-grid">
          {livePhotos.map((photo, pIdx) => (
            <article
              class="live-frame-card glass-card"
              data-photo-id={photo.id}
              data-photo-url={photo.url}
              data-timestamp={photo.timestamp}
              data-faces={photo.faces ? JSON.stringify(photo.faces) : undefined}
              data-index={pIdx}
              style={isFaceMatchMode ? 'display: none;' : undefined}
            >
              <div class="frame-media-box protected-media">
                <img
                  src={photo.url}
                  alt={`${event.title} - Live Ceremony Frame`}
                  class="live-frame-img"
                  loading={pIdx < 6 ? "eager" : "lazy"}
                  oncontextmenu="return false;"
                  crossorigin="anonymous"
                />

                <!-- Transparent anti-theft shield overlay -->
                <div class="protected-overlay" aria-hidden="true"></div>

                <!-- Watermark Overlay (Enforced if watermarkPreview is true) -->
                {event.watermarkPreview && (
                  <div class="watermark-overlay-badge" aria-hidden="true">
                    <span class="wm-studio">FRAMES BY HITHU</span>
                    <span class="wm-type">LIVE PREVIEW</span>
                  </div>
                )}

                <!-- Frame Time Pill -->
                <div class="frame-time-pill">
                  {new Date(photo.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                </div>

                <!-- Actions Overlay -->
                <div class="frame-actions-overlay">
                  <button type="button" class="btn-inspect-frame" aria-label="Inspect Full-Screen Frame">
                    <span>🔍 Full Screen</span>
                  </button>

                  {event.allowDownload ? (
                    <a
                      href={photo.url}
                      download={`FramesByHithu_${event.slug}_${photo.id}.jpg`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-gold download-frame-btn"
                      title="Download High-Resolution Master Frame"
                    >
                      <span>⬇️ Download High-Res</span>
                    </a>
                  ) : (
                    <span class="view-only-tag">🔒 Protected • Direct Studio Print</span>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </main>

    <!-- Camera / Selfie Capture Modal -->
    <div id="selfie-camera-modal" class="selfie-modal-backdrop" style="display: none;">
      <div class="selfie-modal-card glass-card text-center">
        <div class="selfie-modal-header">
          <h3>Selfie Verification</h3>
          <button type="button" class="selfie-close-btn" id="close-camera-modal-btn">✕</button>
        </div>

        <div class="camera-viewport-wrap">
          <video id="selfie-video" autoplay playsinline muted class="camera-video"></video>
          <canvas id="selfie-canvas" style="display: none;"></canvas>
          <div class="camera-oval-guide"></div>
        </div>

        <p class="camera-instructions">Center your face in the oval guide and snap your selfie.</p>

        <div class="camera-controls">
          <button type="button" class="btn-gold snap-btn" id="snap-selfie-btn">
            <span>📸 Snap Selfie & Match</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Full-Screen Lightbox Viewport -->
    <div id="live-lightbox" class="live-lightbox-modal" style="display: none;">
      <div class="lb-backdrop" id="lb-backdrop"></div>
      <div class="lb-container">
        <div class="lb-header">
          <span class="lb-brand">FRAMES BY HITHU • LIVE STREAM</span>
          <button type="button" class="lb-close-btn" id="lb-close-btn">✕</button>
        </div>

        <div class="lb-stage">
          <img id="lb-img" src="" alt="Live Photograph" class="lb-full-img" crossorigin="anonymous" />
          {event.watermarkPreview && (
            <div class="watermark-subtle" aria-hidden="true">FRAMES BY HITHU • LIVE EVENT ARCHIVE</div>
          )}
        </div>

        <div class="lb-footer">
          <div class="lb-meta">
            <span id="lb-frame-time">Captured at ceremony</span>
            <span class="meta-dot">•</span>
            <span>{event.title}</span>
          </div>
          {event.allowDownload && (
            <a id="lb-download-btn" href="#" download target="_blank" rel="noopener noreferrer" class="btn-gold lb-dl-btn">
              <span>⬇️ Download Master High-Res</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Persistent Viral Studio Inquiries Bottom Bar -->
    <footer class="viral-inquiry-bar">
      <div class="container viral-bar-inner">
        <div class="viral-text-block">
          <strong class="viral-title">Loving these moments?</strong>
          <span class="viral-sub">Book Frames By Hithu for your family’s upcoming wedding, Gruhapravesham, or sacred pooja.</span>
        </div>
        <div class="viral-action-block">
          <a
            href={whatsappInquiryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp viral-whatsapp-btn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Inquire on WhatsApp</span>
          </a>
        </div>
      </div>
    </footer>
  </div>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api/dist/face-api.min.js"></script>
</Layout>

<style>
  .live-gallery-wrapper {
    min-height: 100vh;
    padding-bottom: 7rem;
    background: #05060A;
    color: var(--text-primary);
  }

  .text-center {
    text-align: center;
  }

  /* Header */
  .live-header {
    padding: 3rem 1rem 2rem 1rem;
    background: radial-gradient(circle at top center, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
    border-bottom: 1px solid rgba(212, 175, 55, 0.15);
  }

  .header-brand-line {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .studio-emblem {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    box-shadow: 0 2px 10px rgba(212, 175, 55, 0.35);
  }

  .studio-name {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    color: var(--gold-light);
  }

  .live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 4px 12px;
    border-radius: 9999px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #10B981;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .live-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
    animation: livePulse 1.8s infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  .live-time-ago {
    opacity: 0.85;
    font-weight: 500;
  }

  .live-event-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.4rem);
    color: var(--text-primary);
    margin: 0.25rem 0 0.5rem 0;
    line-height: 1.2;
  }

  .live-event-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .divider-dot {
    opacity: 0.4;
  }

  /* Mode 1: Face Onboarding Card */
  .face-onboarding-card {
    max-width: 540px;
    margin: 2rem auto 1rem auto;
    padding: 1.75rem 1.5rem;
    border-radius: 16px;
    background: rgba(14, 16, 22, 0.85);
    border: 1px solid var(--gold-border);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
  }

  .onboard-icon {
    font-size: 2.25rem;
    margin-bottom: 0.35rem;
  }

  .onboard-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--text-primary);
    margin: 0 0 0.4rem 0;
  }

  .onboard-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 440px;
    margin: 0 auto 1.25rem auto;
    line-height: 1.5;
  }

  .selfie-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.85rem 1.75rem;
  }

  .cam-icon {
    font-size: 1.15rem;
  }

  /* Match Status Banner */
  .match-status-banner {
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.35);
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-align: left;
  }

  .selfie-avatar-wrap {
    position: relative;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .selfie-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--gold-primary);
  }

  .match-check {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #10B981;
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .match-text-info {
    flex: 1;
  }

  .match-text-info strong {
    font-size: 0.85rem;
    color: #C4B5FD;
    display: block;
  }

  .match-text-info p {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }

  .match-progress-container {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.5rem;
    width: 100%;
    max-width: 280px;
  }

  .match-progress-bar {
    flex: 1;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
  }

  .match-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #D4AF37, #10B981);
    border-radius: 9999px;
    transition: width 0.2s ease;
  }

  .match-progress-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold-light);
    min-width: 32px;
  }

  .retake-selfie-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .retake-selfie-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  /* View Switcher Bar */
  .view-switcher-bar {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem auto 0.5rem auto;
  }

  .switcher-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(14, 16, 22, 0.8);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    padding: 0.6rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.825rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .switcher-btn:hover {
    color: var(--text-primary);
  }

  .switcher-btn.active {
    background: var(--gold-gradient);
    color: #0B0C10;
    border-color: var(--gold-primary);
  }

  .switcher-btn .badge {
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    padding: 2px 7px;
    border-radius: 9999px;
    font-size: 0.75rem;
  }

  .switcher-btn.active .badge {
    background: #0B0C10;
    color: var(--gold-light);
  }

  /* Incoming Photos Notification */
  .incoming-alert {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid var(--gold-border);
    color: var(--gold-light);
    padding: 0.5rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.825rem;
    margin-top: 1.25rem;
    animation: fadeInDown 0.4s ease;
  }

  .incoming-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold-primary);
    box-shadow: 0 0 10px var(--gold-primary);
    animation: livePulse 1.5s infinite;
  }

  .incoming-btn {
    background: var(--gold-gradient);
    border: none;
    color: #0B0C10;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    cursor: pointer;
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Gallery Stream Masonry */
  .gallery-main-container {
    padding: 2.5rem 0;
  }

  .live-masonry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 992px) {
    .live-masonry-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 540px) {
    .live-masonry-grid {
      grid-template-columns: 1fr;
    }
  }

  .live-frame-card {
    border-radius: 12px;
    overflow: hidden;
