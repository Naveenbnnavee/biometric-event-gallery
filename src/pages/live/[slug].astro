<script>
  function initLiveGallery() {
    const wrapper = document.getElementById('live-gallery-wrapper');
    if (!wrapper) return;

    const slug = wrapper.getAttribute('data-event-slug') || '';
    const allowDownload = wrapper.getAttribute('data-allow-download') === 'true';

    const accessMode = wrapper.getAttribute('data-access-mode');
    const isFaceOnly = accessMode === 'face_only';
    const isFaceAndAll = accessMode === 'face_and_all' || accessMode === 'face_match';
    const isFaceMatchMode = isFaceOnly || isFaceAndAll;
    const gatePrompt = document.getElementById('face-match-gate');

    // State & Engine Variables (Declared at top to prevent TDZ ReferenceError)
    const MODEL_BASE_URL = 'https://cdn.jsdelivr.net/gh/vladmandic/face-api/model/';
    let faceApiLoaded = false;
    let modelsPromise: Promise<boolean> | null = null;
    let activeGuestDescriptor: Float32Array | null = null;
    let cameraStream: MediaStream | null = null;
    let currentMatchedCount = 0;
    const photoDescriptorCache = new Map<string, Float32Array[]>();
    let pollInterval: any = null;

    let knownPhotoIds = new Set<string>();
    const grid = document.getElementById('live-masonry-grid');
    const existingCards = document.querySelectorAll('.live-frame-card');
    existingCards.forEach(c => {
      const pid = c.getAttribute('data-photo-id');
      if (pid) knownPhotoIds.add(pid);
      // Ensure cards stay hidden in face-match mode until selfie is verified
      if (isFaceMatchMode && !activeGuestDescriptor) {
        (c as HTMLElement).style.display = 'none';
      }
    });

    if (isFaceMatchMode && !activeGuestDescriptor && gatePrompt && existingCards.length > 0) {
      gatePrompt.style.display = 'block';
    }

    // Lightbox Controls
    const lbModal = document.getElementById('live-lightbox');
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    lbImg?.addEventListener('contextmenu', (e) => e.preventDefault());
    const lbClose = document.getElementById('lb-close-btn');
    const lbBackdrop = document.getElementById('lb-backdrop');
    const lbDlBtn = document.getElementById('lb-download-btn') as HTMLAnchorElement;
    const lbTime = document.getElementById('lb-frame-time');

    function openLightbox(url: string, timestamp?: string) {
      if (!lbModal || !lbImg) return;
      lbImg.src = url;
      if (lbDlBtn) lbDlBtn.href = url;
      if (lbTime && timestamp) {
        lbTime.textContent = `Captured at ${new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
      }
      lbModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lbModal) return;
      lbModal.style.display = 'none';
      document.body.style.overflow = '';
    }

    lbClose?.addEventListener('click', closeLightbox);
    lbBackdrop?.addEventListener('click', closeLightbox);

    function bindCardClicks() {
      const inspectButtons = document.querySelectorAll('.btn-inspect-frame');
      inspectButtons.forEach(btn => {
        (btn as HTMLElement).onclick = (e: MouseEvent) => {
          e.stopPropagation();
          const card = btn.closest('.live-frame-card');
          const url = card?.getAttribute('data-photo-url');
          const ts = card?.getAttribute('data-timestamp') || undefined;
          if (url) openLightbox(url, ts);
        };
      });

      const cards = document.querySelectorAll('.live-frame-card');
      cards.forEach(card => {
        (card as HTMLElement).onclick = () => {
          const url = card.getAttribute('data-photo-url');
          const ts = card.getAttribute('data-timestamp') || undefined;
          if (url) openLightbox(url, ts);
        };
      });
    }

    bindCardClicks();

    // ==========================================
    // 15-SECOND LIVE POLLING PIPELINE
    // ==========================================

    async function pollLiveStream() {
      try {
        const res = await fetch(`/api/live-events/${encodeURIComponent(slug)}/poll`);
        if (!res.ok) return;
        const data = await res.json();

        if (data.success && Array.isArray(data.photos)) {
          const newPhotos = data.photos.filter((p: any) => !knownPhotoIds.has(p.id));

          if (newPhotos.length > 0) {
            showIncomingAlert(newPhotos.length);
            prependNewPhotos(newPhotos);
          }
        }
      } catch (err) {
        console.warn('Poll error:', err);
      }
    }

    function showIncomingAlert(count: number) {
      const banner = document.getElementById('incoming-photos-banner');
      const text = document.getElementById('incoming-text');
      const timeAgo = document.getElementById('live-time-ago');

      if (timeAgo) timeAgo.textContent = '• Updated just now';
      if (text) text.textContent = `⚡ ${count} new photo${count > 1 ? 's' : ''} just beamed live!`;
      if (banner) {
        banner.style.display = 'inline-flex';
        setTimeout(() => {
          banner.style.display = 'none';
        }, 8000);
      }
    }

    function prependNewPhotos(newPhotos: any[]) {
      if (!grid) return;
      const noPhotos = document.getElementById('no-photos-found');
      if (noPhotos) noPhotos.style.display = 'none';

      const newlyAddedCards: HTMLElement[] = [];

      newPhotos.forEach((photo: any) => {
        knownPhotoIds.add(photo.id);

        const card = document.createElement('article');
        card.className = 'live-frame-card glass-card';
        card.setAttribute('data-photo-id', photo.id);
        card.setAttribute('data-photo-url', photo.url);
        card.setAttribute('data-timestamp', photo.timestamp);
        if (photo.faces) {
          card.setAttribute('data-faces', JSON.stringify(photo.faces));
        }

        const timeStr = new Date(photo.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        card.innerHTML = `
          <div class="frame-media-box protected-media">
            <img src="${photo.url}" alt="Live Ceremony Frame" class="live-frame-img" loading="lazy" oncontextmenu="return false;" crossorigin="anonymous" />
            <div class="protected-overlay" aria-hidden="true"></div>
            <div class="frame-time-pill">${timeStr}</div>
            <div class="frame-actions-overlay">
              <button type="button" class="btn-inspect-frame"><span>🔍 Full Screen</span></button>
              ${allowDownload ? `
                <a href="${photo.url}" download target="_blank" class="btn-gold download-frame-btn">
                  <span>⬇️ Download High-Res</span>
                </a>
              ` : `
                <span class="view-only-tag">🔒 Protected • Direct Studio Print</span>
              `}
            </div>
          </div>
        `;

        if (isFaceMatchMode && !activeGuestDescriptor) {
          card.style.display = 'none';
        }

        grid.prepend(card);
        newlyAddedCards.push(card);
      });

      bindCardClicks();

      // If face matching is active, evaluate incoming photos against guest descriptor
      if (activeGuestDescriptor) {
        checkNewPhotosAgainstSelfie(newlyAddedCards, activeGuestDescriptor);
      }
    }

    // Start 15s polling
    pollInterval = setInterval(pollLiveStream, 15000);

    // ==========================================
    // MODE 1: AI FACE-MATCH GALLERY ENGINE
    // ==========================================
    async function ensureModelsLoaded(): Promise<boolean> {
      if (faceApiLoaded) return true;
      if (modelsPromise) return modelsPromise;

      modelsPromise = (async () => {
        try {
          let fa = (window as any).faceapi;
          if (!fa) {
            for (let i = 0; i < 20; i++) {
              await new Promise(r => setTimeout(r, 150));
              fa = (window as any).faceapi;
              if (fa) break;
            }
          }
          if (!fa) {
            console.error('face-api script not available on window.faceapi');
            modelsPromise = null;
            return false;
          }

          await Promise.all([
            fa.nets.tinyFaceDetector.loadFromUri(MODEL_BASE_URL),
            fa.nets.faceLandmark68Net.loadFromUri(MODEL_BASE_URL),
            fa.nets.faceRecognitionNet.loadFromUri(MODEL_BASE_URL)
          ]);

          faceApiLoaded = true;
          console.log('✓ AI Face-Match CNN models loaded successfully');
          return true;
        } catch (err) {
          console.error('Failed to load face-api models:', err);
          modelsPromise = null;
          return false;
        }
      })();

      return modelsPromise;
    }

    // Preload models in background if event is face_match mode
    if (isFaceMatchMode) {
      ensureModelsLoaded();
    }

    const takeSelfieBtn = document.getElementById('take-selfie-btn');
    const fallbackInput = document.getElementById('camera-fallback-input') as HTMLInputElement;
    const cameraModal = document.getElementById('selfie-camera-modal');
    const closeCameraBtn = document.getElementById('close-camera-modal-btn');
    const snapBtn = document.getElementById('snap-selfie-btn');
    const videoElem = document.getElementById('selfie-video') as HTMLVideoElement;
    const canvasElem = document.getElementById('selfie-canvas') as HTMLCanvasElement;
    const matchStatusBanner = document.getElementById('face-match-status-banner');
    const selfieAvatar = document.getElementById('guest-selfie-preview') as HTMLImageElement;
    const matchHeadline = document.getElementById('match-headline');
    const matchSubline = document.getElementById('match-subline');
    const retakeBtn = document.getElementById('retake-selfie-btn');
    const viewSwitcher = document.getElementById('view-switcher-bar');
    const btnShowMatched = document.getElementById('btn-show-matched');
    const btnShowAll = document.getElementById('btn-show-all');
    const matchedBadge = document.getElementById('matched-count-badge');
    const allBadge = document.getElementById('all-count-badge');
    const progressWrap = document.getElementById('match-progress-wrap');
    const progressFill = document.getElementById('match-progress-fill');
    const progressLabel = document.getElementById('match-progress-label');
    const noMatchState = document.getElementById('no-match-found');
    const emptyShowAllBtn = document.getElementById('empty-show-all-btn');
    const gateTakeSelfieBtn = document.getElementById('gate-take-selfie-btn');
    const gateBrowseAllBtn = document.getElementById('gate-browse-all-btn');

    // Unified Camera & Selfie Flow
    async function openSelfieCamera() {
      ensureModelsLoaded();

      if (navigator.mediaDevices && typeof navigator.mediaDevices.getUserMedia === 'function') {
        try {
          cameraStream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'user', width: { ideal: 720 }, height: { ideal: 960 } }
          });
          if (videoElem) {
            videoElem.srcObject = cameraStream;
            videoElem.play().catch(e => console.warn('Video play warning:', e));
          }
          if (cameraModal) cameraModal.style.display = 'flex';
          return;
        } catch (err) {
          console.warn('getUserMedia denied or failed, falling back to camera file input:', err);
        }
      }

      fallbackInput?.click();
    }

    takeSelfieBtn?.addEventListener('click', openSelfieCamera);
    gateTakeSelfieBtn?.addEventListener('click', openSelfieCamera);

    gateBrowseAllBtn?.addEventListener('click', () => {
      if (isFaceOnly) return;
      if (gatePrompt) gatePrompt.style.display = 'none';
      const allCards = document.querySelectorAll('.live-frame-card');
      allCards.forEach(c => ((c as HTMLElement).style.display = 'block'));
      if (viewSwitcher && isFaceAndAll) viewSwitcher.style.display = 'flex';
      if (btnShowAll) btnShowAll.classList.add('active');
      if (btnShowMatched) btnShowMatched.classList.remove('active');
    });

    fallbackInput?.addEventListener('change', () => {
      if (fallbackInput.files && fallbackInput.files[0]) {
        const file = fallbackInput.files[0];
        const reader = new FileReader();
        reader.onload = async (e) => {
          if (e.target?.result) {
            const dataUrl = e.target.result as string;
            const img = new Image();
            img.onload = async () => {
              await processSelfieCapture(img, dataUrl);
            };
            img.src = dataUrl;
          }
        };
        reader.readAsDataURL(file);
      }
      fallbackInput.value = '';
    });

    function closeCameraModal() {
      if (cameraModal) cameraModal.style.display = 'none';
      if (cameraStream) {
        cameraStream.getTracks().forEach(track => track.stop());
        cameraStream = null;
      }
    }

    closeCameraBtn?.addEventListener('click', closeCameraModal);
    cameraModal?.addEventListener('click', (e) => {
      if (e.target === cameraModal) {
        closeCameraModal();
      }
    });

    // Snap Selfie from Live Video
    snapBtn?.addEventListener('click', async () => {
      if (!videoElem || !canvasElem) return;
      canvasElem.width = videoElem.videoWidth || 480;
      canvasElem.height = videoElem.videoHeight || 640;
      const ctx = canvasElem.getContext('2d');
      if (!ctx) return;

      // Mirror-flip compensation
      ctx.translate(canvasElem.width, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(videoElem, 0, 0, canvasElem.width, canvasElem.height);

      const dataUrl = canvasElem.toDataURL('image/jpeg', 0.9);
      closeCameraModal();
      await processSelfieCapture(canvasElem, dataUrl);
    });

    // Detect Guest Face Descriptor
    async function extractGuestDescriptor(source: CanvasImageSource): Promise<Float32Array | null> {
      const ready = await ensureModelsLoaded();
      if (!ready) return null;
      const fa = (window as any).faceapi;
      if (!fa) return null;

      try {
        const detection = await fa
          .detectSingleFace(source, new fa.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.4 }))
          .withFaceLandmarks()
          .withFaceDescriptor();

        if (!detection || !detection.descriptor) {
          return null;
        }
        return detection.descriptor;
      } catch (err) {
        console.error('Error detecting selfie face:', err);
        return null;
      }
    }

    // Process & Trigger Face Matching
    async function processSelfieCapture(source: CanvasImageSource, previewDataUrl: string) {
      if (selfieAvatar) selfieAvatar.src = previewDataUrl;
      if (matchStatusBanner) matchStatusBanner.style.display = 'flex';
      if (matchHeadline) matchHeadline.textContent = 'Analyzing Selfie Face...';
      if (matchSubline) matchSubline.textContent = 'Extracting facial landmarks and biometrics...';

      const descriptor = await extractGuestDescriptor(source);
      if (!descriptor) {
        alert('No face detected in selfie. Please ensure good lighting and try again.');
        activeGuestDescriptor = null;
        if (matchStatusBanner) matchStatusBanner.style.display = 'none';
        return;
      }

      activeGuestDescriptor = descriptor;
      await runClientFaceMatching(descriptor);
    }

    // Compute or Retrieve Photo Descriptors
    async function getPhotoDescriptors(card: HTMLElement): Promise<Float32Array[]> {
      const photoUrl = card.getAttribute('data-photo-url') || '';
      if (!photoUrl) return [];

      if (photoDescriptorCache.has(photoUrl)) {
        return photoDescriptorCache.get(photoUrl)!;
      }

      // Pre-computed descriptors in card data attribute
      const rawFaces = card.getAttribute('data-faces');
      if (rawFaces) {
        try {
          const parsed = JSON.parse(rawFaces);
          if (Array.isArray(parsed) && parsed.length > 0) {
            const floatArrays = parsed.map((v: any) => new Float32Array(v));
            photoDescriptorCache.set(photoUrl, floatArrays);
            return floatArrays;
          }
        } catch {}
      }

      // Compute client-side via face-api
      const fa = (window as any).faceapi;
      if (!fa) return [];

      try {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.src = photoUrl;

        await new Promise((resolve, reject) => {
          if (img.complete && img.naturalWidth !== 0) {
            resolve(true);
          } else {
            img.onload = () => resolve(true);
            img.onerror = () => reject(new Error('Image failed to load'));
          }
        });

        const detections = await fa
          .detectAllFaces(img, new fa.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.5 }))
          .withFaceLandmarks()
          .withFaceDescriptors();

        const descriptors = (detections || []).map((d: any) => d.descriptor).filter(Boolean);
        photoDescriptorCache.set(photoUrl, descriptors);
        return descriptors;
      } catch (err) {
        console.warn(`Could not compute faces for ${photoUrl}:`, err);
        photoDescriptorCache.set(photoUrl, []);
        return [];
      }
    }

    // Strict Client Face Matching Loop
    async function runClientFaceMatching(guestDescriptor: Float32Array) {
      const fa = (window as any).faceapi;
      if (!fa) return;

      const allCards = Array.from(document.querySelectorAll('.live-frame-card')) as HTMLElement[];
      const noPhotosFound = document.getElementById('no-photos-found');
      if (noPhotosFound) noPhotosFound.style.display = 'none';
      if (gatePrompt) gatePrompt.style.display = 'none';

      if (progressWrap) progressWrap.style.display = 'flex';
      if (progressFill) progressFill.style.width = '0%';
      if (progressLabel) progressLabel.textContent = '0%';
      if (matchHeadline) matchHeadline.textContent = 'Matching Sacred Moments...';

      let matchedCount = 0;

      for (let i = 0; i < allCards.length; i++) {
        const card = allCards[i];
        const checked = i + 1;
        const total = allCards.length;

        if (matchSubline) {
          matchSubline.textContent = `Scanning event moments for your smile... (${checked}/${total} frames checked)`;
        }
        const percent = Math.round((checked / total) * 100);
        if (progressFill) progressFill.style.width = `${percent}%`;
        if (progressLabel) progressLabel.textContent = `${percent}%`;

        const descriptors = await getPhotoDescriptors(card);

        // Strict Matching:
        // Photos without faces (e.g. stage decor, scenery, or cartoon graphics) MUST BE EXCLUDED!
        const isMatch = descriptors.length > 0 && descriptors.some((faceVec) => {
          const distance = fa.euclideanDistance(guestDescriptor, faceVec);
          return distance < 0.52; // Strict threshold for high confidence
        });

        if (isMatch) {
          matchedCount++;
          card.dataset.matched = 'true';
        } else {
          card.dataset.matched = 'false';
        }

        // Render strictly matched photos
        const isMatchedView = isFaceOnly || !btnShowAll?.classList.contains('active');
        if (isMatchedView) {
          card.style.display = isMatch ? 'block' : 'none';
        }
      }

      currentMatchedCount = matchedCount;

      // Hide progress bar
      if (progressWrap) progressWrap.style.display = 'none';

      // Strict handling: NEVER fall back to showing all photos!
      if (matchedCount > 0) {
        if (matchHeadline) matchHeadline.textContent = `Found ${matchedCount} Moment${matchedCount > 1 ? 's' : ''} Featuring You ✨`;
        if (matchSubline) matchSubline.textContent = 'Strict AI facial match verified. Showing your sacred ceremony moments.';
        if (noMatchState) noMatchState.style.display = 'none';
      } else {
        if (matchHeadline) matchHeadline.textContent = 'Scanning Complete';
        if (matchSubline) matchSubline.textContent = 'No matching frames found yet.';
        // Display elegant empty state
        if (noMatchState) noMatchState.style.display = 'block';
        allCards.forEach(c => { c.style.display = 'none'; });
      }

      if (viewSwitcher && isFaceAndAll) viewSwitcher.style.display = 'flex';
      if (matchedBadge) matchedBadge.textContent = matchedCount.toString();
      if (allBadge) allBadge.textContent = allCards.length.toString();
      if (btnShowMatched) btnShowMatched.classList.add('active');
      if (btnShowAll) btnShowAll.classList.remove('active');
    }

    // Evaluate incoming streamed photos against active selfie descriptor
    async function checkNewPhotosAgainstSelfie(newCards: HTMLElement[], guestDescriptor: Float32Array) {
      const fa = (window as any).faceapi;
      if (!fa) return;

      for (const card of newCards) {
        const descriptors = await getPhotoDescriptors(card);
        const isMatch = descriptors.length > 0 && descriptors.some((faceVec) => {
          return fa.euclideanDistance(guestDescriptor, faceVec) < 0.52;
        });

        card.dataset.matched = isMatch ? 'true' : 'false';

        if (isMatch) {
          currentMatchedCount++;
          if (matchedBadge) matchedBadge.textContent = currentMatchedCount.toString();
          if (noMatchState) noMatchState.style.display = 'none';
          if (matchHeadline) matchHeadline.textContent = `Found ${currentMatchedCount} Moments Featuring You ✨`;
          card.style.display = 'block';
        } else {
          card.style.display = (!isFaceOnly && btnShowAll?.classList.contains('active')) ? 'block' : 'none';
        }
      }
    }

    // Retake Selfie Handler
    retakeBtn?.addEventListener('click', () => {
      activeGuestDescriptor = null;
      currentMatchedCount = 0;
      if (matchStatusBanner) matchStatusBanner.style.display = 'none';
      if (viewSwitcher) viewSwitcher.style.display = 'none';
      if (noMatchState) noMatchState.style.display = 'none';
      // In face-match mode, hide photos until new selfie is verified
      const allCards = document.querySelectorAll('.live-frame-card');
      allCards.forEach(c => ((c as HTMLElement).style.display = 'none'));
      if (gatePrompt && allCards.length > 0) gatePrompt.style.display = 'block';
      openSelfieCamera();
    });

    // Switch between "My Matched Frames" and "All Ceremony Frames"
    btnShowMatched?.addEventListener('click', () => {
      if (!activeGuestDescriptor) {
        openSelfieCamera();
        return;
      }
      btnShowMatched.classList.add('active');
      btnShowAll?.classList.remove('active');
      const allCards = document.querySelectorAll('.live-frame-card');
      allCards.forEach(c => {
        const el = c as HTMLElement;
        el.style.display = el.dataset.matched === 'true' ? 'block' : 'none';
      });

      if (currentMatchedCount === 0 && activeGuestDescriptor) {
        if (noMatchState) noMatchState.style.display = 'block';
      } else {
        if (noMatchState) noMatchState.style.display = 'none';
      }
    });

    btnShowAll?.addEventListener('click', () => {
      if (isFaceOnly) return;
      btnShowAll.classList.add('active');
      btnShowMatched?.classList.remove('active');
      if (noMatchState) noMatchState.style.display = 'none';
      const allCards = document.querySelectorAll('.live-frame-card');
      allCards.forEach(c => ((c as HTMLElement).style.display = 'block'));
    });

    emptyShowAllBtn?.addEventListener('click', () => {
      if (isFaceOnly) return;
      btnShowAll?.click();
    });

    window.addEventListener('beforeunload', () => {
      if (pollInterval) clearInterval(pollInterval);
    });
    document.addEventListener('astro:before-swap', () => {
      if (pollInterval) clearInterval(pollInterval);
    }, { once: true });
  }

  initLiveGallery();
  document.addEventListener('astro:page-load', initLiveGallery);
</script>
